---
/* ================================================================
   Leitura.astro — envelope das páginas institucionais
   ================================================================
   Nav + texto longo + índice das seis páginas + rodapé. O corpo vem
   do markdown (slot). Uma família só, Inter, como no resto do site
   desde a direção minimalista (10/10/2026).
   ================================================================ */
import Layout from './Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import { rota } from '../lib/i18n';

type Pagina = 'sobre' | 'governanca' | 'codigo-de-conduta' | 'transparencia' | 'termos' | 'privacidade';

interface Props {
  titulo: string;
  descricao: string;
  rascunho: boolean;
  atualizado: Date;
  pagina: Pagina;
  lang: 'pt-BR' | 'en';
}
const { titulo, descricao, rascunho, atualizado, pagina, lang } = Astro.props;

const en = lang === 'en';

const indice: { chave: Pagina; texto: string }[] = en
  ? [
      { chave: 'sobre', texto: 'about' },
      { chave: 'governanca', texto: 'governance' },
      { chave: 'codigo-de-conduta', texto: 'code of conduct' },
      { chave: 'transparencia', texto: 'transparency' },
      { chave: 'termos', texto: 'terms of use' },
      { chave: 'privacidade', texto: 'privacy' },
    ]
  : [
      { chave: 'sobre', texto: 'sobre' },
      { chave: 'governanca', texto: 'governança' },
      { chave: 'codigo-de-conduta', texto: 'código de conduta' },
      { chave: 'transparencia', texto: 'transparência' },
      { chave: 'termos', texto: 'termos de uso' },
      { chave: 'privacidade', texto: 'privacidade' },
    ];

const rotulo = en
  ? { indice: 'institutional pages', atualizado: 'updated', aviso: 'draft under maintainer review' }
  : { indice: 'páginas institucionais', atualizado: 'atualizado em', aviso: 'rascunho em revisão pelos mantenedores' };

const data = atualizado.toLocaleDateString(en ? 'en-GB' : 'pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<Layout title={`Idearium · ${titulo}`} description={descricao}>
  <div class="palco">
    <Nav atual={pagina === 'sobre' ? 'sobre' : undefined} />

    <div class="leitura">
      <aside class="leitura-indice" aria-label={rotulo.indice}>
        <span class="leitura-rotulo">{rotulo.indice}</span>
        <ul>
          {indice.map((i) => (
            <li>
              <a href={rota(lang, `/${i.chave}`)} aria-current={i.chave === pagina ? 'page' : undefined}>{i.texto}</a>
            </li>
          ))}
        </ul>
      </aside>

      <article class="leitura-texto">
        <header>
          <h1>{titulo}</h1>
          <p class="leitura-sub">{descricao}</p>
          <p class="leitura-meta">{rotulo.atualizado} {data}</p>
          {rascunho && (
            <p class="leitura-rascunho" role="note"><b>{rotulo.aviso}</b></p>
          )}
        </header>
        <div class="leitura-corpo"><slot /></div>
      </article>
    </div>

    <Rodape />
  </div>
</Layout>

<style>
  /* Direção minimalista: uma fonte só (Inter), título em peso 500 com
     tracking negativo, apoio em cinza médio, índice em pílulas como a
     nav. O texto longo é o único lugar do site com corpo 16px e linha
     larga: aqui a pessoa veio ler, não passar o olho. */
  .leitura {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    padding: 48px 4px 72px;
    align-items: start;
  }
  @media (max-width: 800px) { .leitura { grid-template-columns: 1fr; gap: 24px; } }

  .leitura-indice { position: sticky; top: 86px; }
  @media (max-width: 800px) { .leitura-indice { position: static; } }
  .leitura-rotulo {
    display: block; margin-bottom: 10px; padding-left: 12px;
    font-size: 12.5px; color: var(--t-50);
  }
  .leitura-indice ul { display: grid; gap: 2px; }
  @media (max-width: 800px) { .leitura-indice ul { display: flex; flex-wrap: wrap; gap: 6px; } }
  .leitura-indice a {
    display: block; padding: 7px 12px; border-radius: var(--r-pilula);
    font-size: 13.5px; font-weight: 450; color: var(--t-65); text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .leitura-indice a:hover { background: var(--t-07); color: var(--t-100); }
  .leitura-indice a[aria-current='page'] { background: var(--color-chip); color: var(--t-100); font-weight: 500; }

  .leitura-texto { max-width: 66ch; }
  .leitura-texto h1 {
    font-size: var(--text-titulo-md); line-height: 1.05; font-weight: 500;
    letter-spacing: -0.032em; margin: 0 0 16px; max-width: 18ch; color: var(--t-100);
    text-wrap: balance;
  }
  .leitura-sub { color: var(--t-65); font-size: 15px; line-height: 1.45; max-width: 46ch; margin: 0 0 14px; }
  .leitura-meta { font-variant-numeric: tabular-nums; font-size: 12.5px; color: var(--t-50); margin: 0 0 20px; }
  .leitura-rascunho {
    background: var(--color-destaque-fundo);
    border-radius: var(--r-bloco); padding: 12px 16px; margin: 0 0 8px;
    font-size: 13px; color: var(--color-destaque-texto);
  }
  .leitura-rascunho b { font-weight: 500; }

  .leitura-corpo { margin-top: 40px; font-size: 16px; line-height: 1.65; color: var(--t-75); }
  .leitura-corpo :global(h2) {
    font-size: 22px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.2;
    margin: 48px 0 12px; color: var(--t-100);
  }
  .leitura-corpo :global(h3) { font-size: 16px; font-weight: 500; margin: 28px 0 8px; color: var(--t-100); }
  .leitura-corpo :global(p) { margin: 0 0 16px; }
  .leitura-corpo :global(ul),
  .leitura-corpo :global(ol) { margin: 0 0 16px; padding-left: 22px; }
  .leitura-corpo :global(ul) { list-style: disc; }
  .leitura-corpo :global(ol) { list-style: decimal; }
  .leitura-corpo :global(li) { margin-bottom: 6px; }
  .leitura-corpo :global(strong) { font-weight: 550; color: var(--t-100); }
  .leitura-corpo :global(em) { font-style: italic; }
  .leitura-corpo :global(a) {
    color: var(--t-100); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--t-35); transition: text-decoration-color var(--dur) var(--ease);
  }
  .leitura-corpo :global(a:hover) { text-decoration-color: var(--t-100); }
  .leitura-corpo :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px;
    background: var(--rebaixo); padding: 1px 5px; border-radius: 5px;
  }
  /* citação: o tom apagado do título em dois tons, em tamanho maior.
     Era o itálico da serifa antiga. */
  .leitura-corpo :global(blockquote) {
    margin: 0 0 20px; padding: 2px 0 2px 18px; border-left: 2px solid var(--t-12);
  }
  .leitura-corpo :global(blockquote p) {
    margin: 0; font-size: 1.2em; font-weight: 500; letter-spacing: -0.015em;
    line-height: 1.4; color: var(--t-50);
  }
</style>
