---
/* Rodapé — igual em toda página, mínimo: a marca, as quatro páginas
   institucionais e as licenças. Os links internos passam por `rota`
   pra quem está em /en continuar em /en ao clicar. */
import { idiomaDe, rota, t } from '../../lib/i18n';

const lang = idiomaDe(Astro);

const links = [
  { href: '/sobre',             texto: t(lang, 'comum.nav.sobre') },
  { href: '/governanca',        texto: t(lang, 'comum.rodape.governanca') },
  { href: '/codigo-de-conduta', texto: t(lang, 'comum.rodape.conduta') },
  { href: '/transparencia',     texto: t(lang, 'comum.rodape.transparencia') },
];
---

<footer class="rodape">
  <span class="marca">{t(lang, 'comum.rodape.marca')}</span>
  <nav aria-label={t(lang, 'comum.rodape.institucional')}>
    {links.map((l) => <a href={rota(lang, l.href)}>{l.texto}</a>)}
    <a href={rota(lang, '/rss.xml')} type="application/rss+xml">{t(lang, 'comum.rodape.rss')}</a>
  </nav>
  <p class="licencas">
    {t(lang, 'comum.rodape.conteudo')}
    <a rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>
    <span aria-hidden="true">·</span>
    {t(lang, 'comum.rodape.codigo')}
    <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0-or-later</a>
  </p>
</footer>
