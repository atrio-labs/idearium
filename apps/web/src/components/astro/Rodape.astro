---
/* Rodapé — igual em toda página. Os links institucionais passam por
   `rota` pra quem está em /en continuar em /en ao clicar. */
import { idiomaDe, rota, t } from '../../lib/i18n';

const lang = idiomaDe(Astro);
---

<footer class="rodape">
  <span>{t(lang, 'comum.rodape.marca')}</span>
  <nav>
    <a href={rota(lang, '/governanca')}>{t(lang, 'comum.rodape.governanca')}</a>
    <a href={rota(lang, '/codigo-de-conduta')}>{t(lang, 'comum.rodape.conduta')}</a>
    <a href={rota(lang, '/transparencia')}>{t(lang, 'comum.rodape.transparencia')}</a>
  </nav>
  <span>cc by-sa 4.0</span>
</footer>
