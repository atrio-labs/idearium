---
/* ================================================================
   Vazio.astro — estado de vazio
   ================================================================
   Requisito de aceite de toda listagem (ROADMAP_FRONTEND §0.3), não
   polimento posterior. Distingue dois casos que parecem iguais na
   tela e não são:

     "não há nada aqui"        → convite pra criar
     "não falei com a API"     → problema nosso, não da pessoa
   ================================================================ */
import { idiomaDe, t } from '../../lib/i18n';

interface Props {
  titulo: string;
  texto?: string;
  acaoHref?: string;
  acaoTexto?: string;
  /** true quando o vazio é queda do backend, não ausência de dado */
  falha?: boolean;
}
const { titulo, texto, acaoHref, acaoTexto, falha = false } = Astro.props;
const lang = idiomaDe(Astro);
---

<div class:list={['vazio', falha && 'falha']}>
  <p class="mono rotulo">{t(lang, falha ? 'comum.vazio.rotulo.falha' : 'comum.vazio.rotulo.nada')}</p>
  <h3>{titulo}</h3>
  {texto && <p class="texto">{texto}</p>}
  {acaoHref && acaoTexto && <a class="botao" href={acaoHref}>{acaoTexto}</a>}
</div>
