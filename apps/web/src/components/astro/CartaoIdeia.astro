---
/* ================================================================
   CartaoIdeia.astro — uma RFC na grade
   ================================================================
   Reusado no átrio, em /rfcs, em /labs/:slug e em /users/:username.
   Recebe o objeto que a API devolve, sem adaptação prévia. O idioma
   vem do endereço (locals), então a página não precisa repassar.

   Direção minimalista: cartão branco de raio grande, chip com o
   número da RFC, título curto, resumo em cinza e a Materia sangrando
   na base. Nada de contagem de inscritos nem rostos empilhados
   (VISAO §9): o cartão mostra a ideia, não a plateia dela.

   As prévias de /rfcs/nova e /rfcs/:slug/editar leem este markup
   (.capa canvas, .miolo > p, h3, .chip.pastel, .chip.pequeno,
   .codigo). Mudar um desses nós é mudar aquelas páginas também.
   ================================================================ */
import Materia from './Materia.astro';
import {
  codigoRfc, haQuantoTempo, materiaDaRfc, nomeDoLab, rotuloDoStatus,
  type RfcResumo,
} from '../../lib/api';
import { idiomaDe, rota, t } from '../../lib/i18n';

interface Props {
  /* `author` e `_count` são opcionais porque
     GET /users/:username/enrollments devolve a RFC sem eles. */
  rfc: Omit<RfcResumo, 'author' | '_count'> &
    Partial<Pick<RfcResumo, 'author' | '_count'>>;
  /** dentro de um lab o chip do lab é redundante */
  ocultarLab?: boolean;
  /** atributos data-* pro filtro client-side de /rfcs */
  filtravel?: boolean;
  /** Prévia de uma RFC que ainda não existe: sem endereço, o cartão não
   *  pode ser link. É o que permite /rfcs/nova mostrar o objeto de
   *  verdade em vez de repetir este markup e divergir dele depois. */
  comoLink?: boolean;
}

const { rfc, ocultarLab = false, filtravel = false, comoLink = true } = Astro.props;
const m = materiaDaRfc(rfc);
const versoes = rfc._count?.versions;
const Moldura = comoLink ? 'a' : 'article';
const lang = idiomaDe(Astro);
---

<Moldura
  class="cartao ideia vem"
  href={comoLink ? rota(lang, `/rfcs/${rfc.slug}`) : undefined}
  data-lab={filtravel ? rfc.lab.slug : undefined}
  data-status={filtravel ? rfc.status : undefined}
>
  {/* Texto em cima, imagem embaixo: quem lê a grade lê o título
      primeiro, e a imagem fecha o cartão sangrando na base. */}
  <div class="miolo">
    <div class="chips">
      {/* Sem número o código diria "rascunho", que é exatamente o que o
          chip de estado já diz. O código só aparece quando existe. */}
      {rfc.number != null && <span class="chip codigo">{codigoRfc(rfc.number, lang)}</span>}
      {/* `chip pequeno` (com .vivo e .ponto em discussão) é contrato:
          a prévia de /rfcs/:slug/editar procura exatamente esse nó pra
          trocar o estado. Em discussão ele vira o chip de destaque. */}
      {rfc.status === 'IN_DISCUSSION'
        ? <span class="chip pequeno vivo"><span class="ponto"></span>{rotuloDoStatus(rfc.status, lang)}</span>
        : <span class="chip pequeno">{rotuloDoStatus(rfc.status, lang)}</span>}
      {/* dentro de um lab o chip do lab é redundante. O fundo inline
          continua porque /rfcs/nova reescreve ele ao trocar de lab; o
          token do lab agora é cinza neutro. */}
      {!ocultarLab && (
        <span class="chip pastel" style={`background: var(--color-${rfc.lab.slug})`}>
          {nomeDoLab(rfc.lab, lang)}
        </span>
      )}
    </div>
    <h3>{rfc.title}</h3>
    <p>{rfc.summary}</p>
    <div class="pe">
      {/* sem autor (vem assim de /users/:username/enrollments) o pé fica
          só com a data — repetir o nome do lab duplicaria o chip acima */}
      <span>
        {rfc.author && `@${rfc.author.username}`}
        {rfc.author && versoes != null && ` · v0.${versoes}`}
      </span>
      <span>{haQuantoTempo(rfc.publishedAt ?? rfc.createdAt, lang)}</span>
    </div>
  </div>
  <div class="capa">
    <Materia
      tipo={m.tipo}
      lab={rfc.lab.slug}
      semente={m.semente}
      alt={t(lang, 'comum.materia.alt', { codigo: codigoRfc(rfc.number, lang) })}
    />
  </div>
</Moldura>
