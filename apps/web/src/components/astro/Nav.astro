---
/* Nav — pílula flutuante, sticky. Aparece em toda página.

   Em página pré-renderizada não há `locals`, então o bloco de sessão
   só aparece nas rotas SSR. Numa página estática a nav sempre mostra
   "entrar" — o que é correto: ela é a mesma pra todo visitante e não
   pode ser personalizada em build time. */
interface Props {
  /** rota atual, pra marcar o item ativo */
  atual?: 'labs' | 'rfcs' | 'builders' | 'buscar' | 'sobre';
}
const { atual } = Astro.props;

const usuario = Astro.locals?.usuario ?? null;

const itens = [
  { chave: 'labs',     href: '/labs',     texto: 'laboratórios' },
  { chave: 'rfcs',     href: '/rfcs',     texto: 'ideias' },
  { chave: 'builders', href: '/builders', texto: 'mãos' },
  { chave: 'sobre',    href: '/sobre',    texto: 'sobre' },
] as const;
---

<nav class="nav">
  <a class="marca" href="/">idearium</a>
  {itens.map((i) => (
    <a
      class="esconde"
      href={i.href}
      aria-current={atual === i.chave ? 'page' : undefined}
    >{i.texto}</a>
  ))}
  <span class="fim">
    <a class="esconde" href="/buscar" aria-current={atual === 'buscar' ? 'page' : undefined}>buscar</a>
    {usuario ? (
      <a class="eu" href="/perfil" data-eu>
        <span class="inicial">{usuario.username.slice(0, 2).toUpperCase()}</span>
        @{usuario.username}
      </a>
    ) : (
      <a class="entrar" href="/entrar" data-entrar>entrar</a>
    )}
  </span>
</nav>

<script>
  /* Em página pré-renderizada não existe `locals`, então a nav sai do
     build sempre com "entrar". Este script corrige no cliente lendo o
     cookie `id_quem` — que guarda só o @username, nunca token. */
  function ajustarNav() {
    const link = document.querySelector<HTMLAnchorElement>('[data-entrar]');
    if (!link) return;

    const quem = document.cookie
      .split('; ')
      .find((c) => c.startsWith('id_quem='))
      ?.split('=')[1];
    if (!quem) return;

    const nome = decodeURIComponent(quem);
    link.className = 'eu';
    link.href = '/perfil';
    link.textContent = '';
    const inicial = document.createElement('span');
    inicial.className = 'inicial';
    inicial.textContent = nome.slice(0, 2).toUpperCase();
    link.append(inicial, `@${nome}`);
    link.removeAttribute('data-entrar');
    link.setAttribute('data-eu', '');
  }

  document.addEventListener('astro:page-load', ajustarNav);
</script>
