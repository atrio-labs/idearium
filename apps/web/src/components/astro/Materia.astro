---
/* ================================================================
   Materia.astro — o dado da RFC em dithering ordenado (Bayer 8×8)
   ================================================================
   Cada RFC exibe o SEU dado como imagem, 1 bit por pixel. É o achado
   central da direção: onde as referências do polo macio põem pintura
   decorativa (ou hero gerado por IA), aqui entra a densidade de
   relatos de alagamento, o campo de pontos de doação, o grafo de
   empréstimos. Assim a estética e o sinal de "tech" param de ser
   duas coisas — resolve o escopo travado em 24.07 sem ícone de
   engrenagem.

   O pastel do lab é o FUNDO; o dither é desenhado na tinta única.
   Pastel dessaturado não teria contraste pra ser o traço.

   Determinístico: mesma semente, mesma imagem, em qualquer máquina,
   sem guardar nada e sem requisição. Quando o campo vier da API, só
   a origem de `tipo` e `semente` muda — o resto do código, não.

   O <script> abaixo é hoisted e deduplicado pelo Astro: aparece uma
   vez no bundle mesmo com N instâncias do componente na página.
   ================================================================ */

interface Props {
  /** que tipo de dado a RFC produz */
  tipo: 'mancha' | 'pontos' | 'grafo' | 'serie';
  /** slug do lab — vira a cor de fundo via var(--<lab>) */
  lab: 'educacao' | 'cidades' | 'saude' | 'cultura' | 'civica' | 'solidaria';
  /** mesma semente, mesma imagem */
  semente: number;
  /** legenda opcional, sobreposta no canto inferior */
  legenda?: string;
  /** rótulo pra leitores de tela — o canvas é conteúdo, não enfeite */
  alt: string;
}

const { tipo, lab, semente, legenda, alt } = Astro.props;
---

<canvas
  data-materia={tipo}
  data-lab={lab}
  data-semente={semente}
  role="img"
  aria-label={alt}
></canvas>
{legenda && <figcaption>{legenda}</figcaption>}

<script>
  const BAYER8 = [
    [ 0,32, 8,40, 2,34,10,42],[48,16,56,24,50,18,58,26],
    [12,44, 4,36,14,46, 6,38],[60,28,52,20,62,30,54,22],
    [ 3,35,11,43, 1,33, 9,41],[51,19,59,27,49,17,57,25],
    [15,47, 7,39,13,45, 5,37],[63,31,55,23,61,29,53,21]
  ];

  function prng(seed: number) {
    let a = (seed * 2654435761) >>> 0;
    return () => {
      a = (a + 0x6D2B79F5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /* cada campo devolve (x,y) -> intensidade 0..1 */
  function campo(tipo: string, r: () => number, L: number, A: number) {
    if (tipo === 'mancha') {
      const focos = Array.from({ length: 7 }, () => ({
        x: r() * L, y: r() * A, s: (0.10 + r() * 0.22) * Math.min(L, A), p: 0.5 + r()
      }));
      return (x: number, y: number) => {
        let v = 0;
        for (const f of focos) v += f.p * Math.exp(-(((x - f.x) ** 2 + (y - f.y) ** 2) / (f.s * f.s)));
        return Math.min(1, v * 0.62);
      };
    }
    if (tipo === 'pontos') {
      const pts = Array.from({ length: 22 }, () => ({
        x: r() * L, y: r() * A, s: (0.05 + r() * 0.07) * Math.min(L, A)
      }));
      return (x: number, y: number) => {
        let v = 0;
        for (const p of pts) {
          const d = Math.hypot(x - p.x, y - p.y) / p.s;
          v = Math.max(v, Math.exp(-d * d * 0.8));
        }
        return Math.min(1, v * 0.95);
      };
    }
    if (tipo === 'grafo') {
      const nos = Array.from({ length: 11 }, () => ({
        x: 0.1 * L + r() * 0.8 * L, y: 0.1 * A + r() * 0.8 * A
      }));
      const arestas: Array<[typeof nos[0], typeof nos[0]]> = [];
      for (let i = 0; i < nos.length; i++) {
        const j = Math.floor(r() * nos.length);
        if (i !== j) arestas.push([nos[i], nos[j]]);
      }
      return (x: number, y: number) => {
        let v = 0;
        for (const n of nos) v = Math.max(v, Math.exp(-(((x - n.x) ** 2 + (y - n.y) ** 2)) / 90));
        for (const [a, b] of arestas) {
          const dx = b.x - a.x, dy = b.y - a.y;
          const t = Math.max(0, Math.min(1, ((x - a.x) * dx + (y - a.y) * dy) / (dx * dx + dy * dy || 1)));
          const d = Math.hypot(x - (a.x + t * dx), y - (a.y + t * dy));
          v = Math.max(v, Math.exp(-(d * d) / 5) * 0.62);
        }
        return Math.min(1, v);
      };
    }
    const n = 26;
    const alt = Array.from({ length: n }, (_, i) =>
      0.32 + 0.42 * Math.abs(Math.sin(i * 0.55 + r())) * (0.6 + r() * 0.6));
    return (x: number, y: number) => {
      const i = Math.min(n - 1, Math.floor((x / L) * n));
      const topo = A * (1 - alt[i]);
      if (y < topo) return 0;
      return 0.30 + 0.62 * (1 - (y - topo) / (A - topo));
    };
  }

  function pintar(cv: HTMLCanvasElement) {
    const caixa = cv.getBoundingClientRect();
    if (!caixa.width || !caixa.height) return;

    const raiz = getComputedStyle(document.documentElement);
    const pastel = raiz.getPropertyValue('--color-' + cv.dataset.lab).trim();

    const ESCALA = 4;                       // 1 pixel de dado = 4 CSS px
    // piso baixo de propósito: um piso alto distorce capas curtas
    // (152px / 4 = 38 seria forçado pra 40 e esticaria o dither)
    const L = Math.max(8, Math.round(caixa.width / ESCALA));
    const A = Math.max(8, Math.round(caixa.height / ESCALA));
    cv.width = L; cv.height = A;

    const ctx = cv.getContext('2d');
    if (!ctx) return;
    ctx.imageSmoothingEnabled = false;
    cv.style.imageRendering = 'pixelated';

    const f = campo(cv.dataset.materia!, prng(parseInt(cv.dataset.semente!, 10)), L, A);

    ctx.fillStyle = pastel;                 // pastel do lab é o fundo
    ctx.fillRect(0, 0, L, A);
    ctx.fillStyle = 'rgba(3, 3, 2, 0.86)';  // a tinta única é o traço

    for (let y = 0; y < A; y++) {
      for (let x = 0; x < L; x++) {
        if (f(x, y) > (BAYER8[y & 7][x & 7] + 0.5) / 64) ctx.fillRect(x, y, 1, 1);
      }
    }
  }

  const pintarTudo = () =>
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-materia]').forEach(pintar);

  // `astro:page-load` já dispara na carga inicial com o ClientRouter ativo,
  // e de novo a cada navegação. Sem chamada direta: seria pintar duas vezes.
  document.addEventListener('astro:page-load', pintarTudo);

  let t: ReturnType<typeof setTimeout>;
  addEventListener('resize', () => { clearTimeout(t); t = setTimeout(pintarTudo, 180); });
</script>
