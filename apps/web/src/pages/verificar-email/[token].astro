---
/* ================================================================
   /verificar-email/:token — confirma o email (Etapa 6)
   ================================================================
   Abrir o link já faz o POST /auth/verify-email/:token, no servidor.
   Ressalva conhecida: scanner de link de email que abre a URL antes da
   pessoa gasta o token. Se isso acontecer em produção, o caminho é a
   API aceitar o token duas vezes por alguns minutos, ou esta página
   passar a pedir um clique. Por ora segue o contrato do roadmap.

   Estados: ok, expirado, inválido e falha (API fora). Com
   PUBLIC_OAUTH desligada a rota não existe (404).
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import { OAUTH_ATIVO } from '../../lib/oauth';
import { verificarEmail } from '../../lib/sessao';
import { idiomaDe, rota, t } from '../../lib/i18n';

if (!OAUTH_ATIVO) return new Response(null, { status: 404 });

const lang = idiomaDe(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const r = await verificarEmail(Astro.params.token ?? '');
type Estado = 'ok' | 'expirado' | 'invalido' | 'falha';
const estado: Estado = r.ok
  ? 'ok'
  : r.codigo === 'TOKEN_EXPIRED' || r.status === 410
    ? 'expirado'
    : r.status === 400 || r.status === 404 || r.codigo === 'TOKEN_INVALID'
      ? 'invalido'
      : 'falha';

const logado = Astro.locals.usuario != null;
/* quem já está logado volta ao perfil; quem não está, a entrar */
const acaoHref = logado ? rota(lang, '/perfil') : rota(lang, '/entrar?voltar=%2Fperfil');
const acaoTexto = logado ? t(lang, 'auth.verificar.acao.perfil') : t(lang, 'auth.verificar.acao.entrar');
---

<Layout title={t(lang, 'auth.verificar.titulo')} description={t(lang, 'auth.verificar.descricao')}>
  <div class="palco pagina-conta">
    <Nav />

    <div class="form-estreito">
      <header class="cabeca-estreita">
        {estado === 'ok' && <h1 class="titulo-duplo">{t(lang, 'auth.verificar.ok.h1.antes')}<span class="apagado">{t(lang, 'auth.verificar.ok.h1.apagado')}</span></h1>}
        {estado === 'expirado' && <h1 class="titulo-duplo">{t(lang, 'auth.verificar.expirado.h1.antes')}<span class="apagado">{t(lang, 'auth.verificar.expirado.h1.apagado')}</span></h1>}
        {estado === 'invalido' && <h1 class="titulo-duplo">{t(lang, 'auth.verificar.invalido.h1.antes')}<span class="apagado">{t(lang, 'auth.verificar.invalido.h1.apagado')}</span></h1>}
        {estado === 'falha' && <h1 class="titulo-duplo">{t(lang, 'auth.verificar.falha.h1.antes')}<span class="apagado">{t(lang, 'auth.verificar.falha.h1.apagado')}</span></h1>}

        <p class="apoio" role={estado === 'ok' ? 'status' : undefined}>
          {estado === 'ok' && t(lang, 'auth.verificar.ok.texto')}
          {estado === 'expirado' && t(lang, 'auth.verificar.expirado.texto')}
          {estado === 'invalido' && t(lang, 'auth.verificar.invalido.texto')}
          {estado === 'falha' && t(lang, 'auth.verificar.falha.texto')}
        </p>
      </header>

      {estado !== 'falha' && (
        <div class="acoes-form">
          <a class="botao" href={acaoHref}>{acaoTexto}</a>
        </div>
      )}
    </div>

    <Rodape />
  </div>
</Layout>
