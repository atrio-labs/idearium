---
/* ================================================================
   /rfcs — lista de ideias com filtro (F1.2)
   ================================================================
   O filtro é client-side: todas as RFCs públicas vêm no HTML e o JS
   esconde as que não casam. A página é SSR com cache HTTP pra quem não
   está logado (lib/cache.ts), e o filtro continua instantâneo, sem ida
   ao servidor.

   O estado do filtro vive na querystring, então recarregar mantém o
   filtro e o link é compartilhável — que é o critério de aceite.

   Limite: com o catálogo grande isso vira HTML demais. O corte é
   ~200 RFCs; passando disso, migrar pra SSR paginado. Anotado aqui
   em vez de descoberto em produção.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import CartaoIdeia from '../../components/astro/CartaoIdeia.astro';
import Vazio from '../../components/astro/Vazio.astro';
import {
  listarTodasRfcs, listarLabs, apiIndisponivel, rotuloDoStatus, nomeDoLab,
  type RfcStatus,
} from '../../lib/api';
import { idiomaDe, rota, t } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

const lang = idiomaDe(Astro);

const [labs, rfcs] = await Promise.all([
  listarLabs(),
  listarTodasRfcs(),
]);
const semRede = apiIndisponivel();
cachePublico(Astro, semRede);

/* Só os estados que uma RFC pública pode ter. DRAFT não aparece em
   listagem pública (a API já filtra), e ARCHIVED só se existir. */
const estados: RfcStatus[] = ['IN_DISCUSSION', 'IN_BUILDING', 'PUBLISHED'];
const estadosPresentes = estados.filter((e) => rfcs.some((r) => r.status === e));
const labsPresentes = labs.filter((l) => rfcs.some((r) => r.lab.slug === l.slug));
---

<Layout title={t(lang, 'rfcs.lista.titulo')}>
  <div class="palco">
    <Nav atual="rfcs" />

    <header class="topo-lista">
      <h1 class="titulo-duplo grande">{t(lang, 'rfcs.lista.h1.antes')}<span class="apagado">{t(lang, 'rfcs.lista.h1.apagado')}{t(lang, 'rfcs.lista.h1.depois')}</span></h1>
      <p class="apoio">{t(lang, 'rfcs.lista.sub')}</p>
    </header>

    {semRede && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b>{t(lang, 'rfcs.lista.aviso')}
      </p>
    )}

    {rfcs.length > 0 && (
      <div class="filtros-lista">
        <div class="grupo" role="group" aria-labelledby="rotulo-lab">
          <span class="apoio" id="rotulo-lab">{t(lang, 'rfcs.lista.filtro.lab')}</span>
          <div class="pilulas">
            <button class="filtro" type="button" data-filtro="lab" data-valor="" aria-pressed="true">{t(lang, 'rfcs.lista.filtro.todos')}</button>
            {labsPresentes.map((l) => (
              <button class="filtro" type="button" data-filtro="lab" data-valor={l.slug} aria-pressed="false">{nomeDoLab(l, lang)}</button>
            ))}
          </div>
        </div>
        <div class="grupo" role="group" aria-labelledby="rotulo-momento">
          <span class="apoio" id="rotulo-momento">{t(lang, 'rfcs.lista.filtro.momento')}</span>
          <div class="pilulas">
            <button class="filtro" type="button" data-filtro="status" data-valor="" aria-pressed="true">{t(lang, 'rfcs.lista.filtro.qualquer')}</button>
            {estadosPresentes.map((e) => (
              <button class="filtro" type="button" data-filtro="status" data-valor={e} aria-pressed="false">{rotuloDoStatus(e, lang)}</button>
            ))}
          </div>
        </div>
      </div>
    )}

    <p
      class="contagem apoio"
      id="contagem"
      data-total={rfcs.length}
      data-um={t(lang, 'rfcs.lista.qtd.filtrada.um', { visiveis: '{visiveis}', total: '{total}' })}
      data-varios={t(lang, 'rfcs.lista.qtd.filtrada.varios', { visiveis: '{visiveis}', total: '{total}' })}
    >
      {t(lang, rfcs.length === 1 ? 'rfcs.lista.qtd.um' : 'rfcs.lista.qtd.varios', { n: rfcs.length })}
    </p>

    {rfcs.length > 0 ? (
      <>
        <div class="grade" id="grade">
          {rfcs.map((rfc) => <CartaoIdeia rfc={rfc} filtravel />)}
        </div>

        {/* aparece só quando o filtro zera o resultado */}
        <div id="vazio-filtro" hidden>
          <Vazio
            titulo={t(lang, 'rfcs.lista.filtro.vazio.titulo')}
            texto={t(lang, 'rfcs.lista.filtro.vazio.texto')}
          />
        </div>
      </>
    ) : (
      <Vazio
        falha={semRede}
        titulo={semRede ? t(lang, 'comum.vazio.falha.titulo') : t(lang, 'rfcs.lista.vazio.titulo')}
        texto={semRede ? t(lang, 'rfcs.lista.falha.texto') : t(lang, 'rfcs.lista.vazio.texto')}
        acaoHref={semRede ? undefined : rota(lang, '/rfcs/nova')}
        acaoTexto={semRede ? undefined : t(lang, 'rfcs.lista.vazio.acao')}
      />
    )}

    <Rodape />
  </div>
</Layout>

<style>
  .topo-lista { padding: 88px 8px 40px; display: grid; gap: 20px; }
  @media (max-width: 520px) { .topo-lista { padding: 48px 4px 28px; } }

  .filtros-lista { display: grid; gap: 18px; padding: 0 8px 36px; }
  .grupo { display: grid; gap: 10px; }
  .pilulas { display: flex; gap: 8px; flex-wrap: wrap; }

  /* chip de filtro: cinza em repouso, preto quando ativo. 40px de alvo. */
  .filtro {
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    min-height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-pilula);
    background: var(--color-chip);
    color: var(--t-100);
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .filtro:hover { background: var(--t-12); }
  .filtro[aria-pressed="true"] { background: var(--tinta); color: #fff; }
  .filtro:focus-visible { outline: 2px solid var(--tinta); outline-offset: 2px; }

  .contagem { padding: 0 8px 20px; font-variant-numeric: tabular-nums; }
  .grade { padding: 0 0 8px; }
  #vazio-filtro { padding-top: 8px; }
</style>

<script>
  function ligarFiltro() {
    const grade = document.getElementById('grade');
    if (!grade) return;

    const botoes = [...document.querySelectorAll<HTMLButtonElement>('.filtro')];
    const cartoes = [...grade.querySelectorAll<HTMLElement>('.ideia')];
    const contagem = document.getElementById('contagem');
    const vazio = document.getElementById('vazio-filtro');
    /* a contagem sem filtro já vem escrita pelo servidor, no idioma certo */
    const textoSemFiltro = contagem?.textContent ?? '';

    const estado = { lab: '', status: '' };

    /* a querystring é a fonte da verdade: recarregar mantém o filtro
       e o link pode ser compartilhado */
    const url = new URL(location.href);
    estado.lab = url.searchParams.get('lab') ?? '';
    estado.status = url.searchParams.get('status') ?? '';

    function aplicar(gravarHistorico: boolean) {
      let visiveis = 0;
      for (const c of cartoes) {
        const casaLab = !estado.lab || c.dataset.lab === estado.lab;
        const casaStatus = !estado.status || c.dataset.status === estado.status;
        const mostra = casaLab && casaStatus;
        c.hidden = !mostra;
        if (mostra) visiveis++;
      }

      for (const b of botoes) {
        const chave = b.dataset.filtro as 'lab' | 'status';
        b.setAttribute('aria-pressed', String((b.dataset.valor ?? '') === estado[chave]));
      }

      if (contagem) {
        const total = Number(contagem.dataset.total ?? 0);
        const filtrando = estado.lab || estado.status;
        contagem.textContent = filtrando
          ? (total === 1 ? contagem.dataset.um! : contagem.dataset.varios!)
              .replace('{visiveis}', String(visiveis))
              .replace('{total}', String(total))
          : textoSemFiltro;
      }

      if (vazio) vazio.hidden = visiveis > 0;
      grade!.hidden = visiveis === 0;

      if (gravarHistorico) {
        const u = new URL(location.href);
        estado.lab ? u.searchParams.set('lab', estado.lab) : u.searchParams.delete('lab');
        estado.status ? u.searchParams.set('status', estado.status) : u.searchParams.delete('status');
        history.replaceState(null, '', u);
      }
    }

    for (const b of botoes) {
      b.addEventListener('click', () => {
        const chave = b.dataset.filtro as 'lab' | 'status';
        estado[chave] = b.dataset.valor ?? '';
        aplicar(true);
      });
    }

    aplicar(false);
  }

  function ligarEntrada() {
    const olho = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('veio');
        olho.unobserve(e.target);
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  }

  document.addEventListener('astro:page-load', () => {
    ligarEntrada();
    ligarFiltro();
  });
</script>
