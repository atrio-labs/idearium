---
/* ================================================================
   /rfcs/:slug/editar — editar, publicar e arquivar (F4)
   ================================================================
   Convive com /rfcs/[slug].astro: o Astro casa a rota mais específica
   primeiro, então /rfcs/x resolve o detalhe e /rfcs/x/editar resolve
   esta página.

   A RFC é buscada COM sessão (comSessao, não obterRfc): rascunho é
   invisível pra chamada anônima, e é justamente o rascunho que esta
   tela existe pra editar.

   Rascunho de outra pessoa e RFC inexistente respondem exatamente
   igual — 404 com a mesma frase. Diferenciar os dois contaria que
   existe um rascunho naquele endereço, que é a única coisa que o
   autor de um rascunho não quer contar.

   Todas as ações são POST tradicional pra própria página, separadas
   por um campo `acao`. São formulários irmãos, nunca aninhados.
   ================================================================ */
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/astro/Nav.astro';
import Rodape from '../../../components/astro/Rodape.astro';
import Vazio from '../../../components/astro/Vazio.astro';
/* O mesmo componente da listagem e do átrio, sem adaptação: a prévia
   precisa ser o objeto que vai existir, não uma imitação dele. */
import CartaoIdeia from '../../../components/astro/CartaoIdeia.astro';
import {
  statusLabel, nomeCurtoDoLab, codigoRfc, haQuantoTempo,
  type Rfc, type Tag,
} from '../../../lib/api';
import { comSessao, exigirSessao } from '../../../lib/sessao';

const usuario = Astro.locals.usuario;
const destino = exigirSessao(usuario, Astro.url);
if (destino) return Astro.redirect(destino);

/* Os mesmos números do UpdateRfcDto da API. */
const LIMITE = {
  titulo: { min: 5,  max: 200 },
  resumo: { min: 5,  max: 280 },
  corpo:  { min: 50, max: 50_000 },
  tag:    { min: 2,  max: 40 },
  tags:   { max: 10 },
};

/* Espelha o slugify() da API. É o slug, e não o texto digitado, que
   identifica a tag lá dentro: sem repetir a regra aqui, "C#" viraria
   "c", seria descartado no meio de um 200, e a tela ainda diria que o
   conjunto salvo é o que está no campo. */
function slugDaTag(bruto: string) {
  return bruto
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function separarTags(bruto: string) {
  const porSlug = new Map<string, string>();
  const tags: string[] = [];
  const semLetras: string[] = [];
  const repetidas: string[] = [];

  for (const parte of bruto.split(',')) {
    const t = parte.trim();
    if (!t) continue;
    const slug = slugDaTag(t);
    if (slug.length < LIMITE.tag.min) { semLetras.push(t); continue; }
    const anterior = porSlug.get(slug);
    if (anterior) { repetidas.push(`${t} e ${anterior}`); continue; }
    porSlug.set(slug, t);
    tags.push(t);
  }
  return { tags, semLetras, repetidas };
}

/** Devolve a mensagem de erro do campo, ou string vazia se está tudo bem. */
function erroDeTags(s: ReturnType<typeof separarTags>) {
  if (s.tags.length > LIMITE.tags.max) return `No máximo ${LIMITE.tags.max} tags.`;
  if (s.tags.some((t) => t.length < LIMITE.tag.min || t.length > LIMITE.tag.max))
    return `Cada tag precisa ter de ${LIMITE.tag.min} a ${LIMITE.tag.max} caracteres.`;
  if (s.semLetras.length)
    return `Tag é guardada só por letras e números, e de ${s.semLetras.join(', ')} não sobra nada. Reescreva com pelo menos ${LIMITE.tag.min} letras ou números.`;
  if (s.repetidas.length)
    return `Acento e pontuação não separam tags: ${s.repetidas.join('; ')} são a mesma. Deixe uma só.`;
  return '';
}

interface Campos { title: string; summary: string; body: string }

function validar(v: Campos) {
  const e: Record<string, string> = {};

  if (v.title.length < LIMITE.titulo.min) e.title = `O título precisa de pelo menos ${LIMITE.titulo.min} caracteres.`;
  else if (v.title.length > LIMITE.titulo.max) e.title = `O título passou de ${LIMITE.titulo.max} caracteres.`;

  if (v.summary.length < LIMITE.resumo.min) e.summary = `O resumo precisa de pelo menos ${LIMITE.resumo.min} caracteres.`;
  else if (v.summary.length > LIMITE.resumo.max) e.summary = `O resumo passou de ${LIMITE.resumo.max} caracteres.`;

  if (v.body.length < LIMITE.corpo.min) e.body = `O corpo precisa de pelo menos ${LIMITE.corpo.min} caracteres.`;
  else if (v.body.length > LIMITE.corpo.max) e.body = `O corpo passou de ${LIMITE.corpo.max} caracteres.`;

  return e;
}

const { slug } = Astro.params;
const busca = await comSessao<Rfc>(Astro.cookies, 'GET', `/rfcs/${slug}`);

/* status 0 é o único caso em que o servidor não falou nada. Aí o vazio
   é falha nossa, não ausência de permissão — e a tela precisa dizer
   qual dos dois é. */
const semRede = busca.status === 0 || busca.status >= 500;
const encontrada = busca.dado;
const meu = !!encontrada && encontrada.author.username === usuario?.username;

let rfc = meu ? encontrada : null;

let valores: Campos = rfc
  ? { title: rfc.title, summary: rfc.summary, body: rfc.body }
  : { title: '', summary: '', body: '' };
/* null significa "espelhe o conjunto que está na API". Só vira string
   quando a troca de tags falhou e o campo precisa devolver o que a
   pessoa digitou. */
let valorTags: string | null = null;
let erros: Record<string, string> = {};
let avisoGeral = '';
let avisoOk = '';

if (Astro.request.method === 'POST' && rfc) {
  const f = await Astro.request.formData();
  const acao = String(f.get('acao') ?? '');

  if (acao === 'publicar') {
    const r = await comSessao(Astro.cookies, 'POST', `/rfcs/${rfc.id}/publish`);
    if (r.ok) return Astro.redirect(`/rfcs/${rfc.slug}`);
    avisoGeral = r.erro ?? 'Não consegui publicar agora.';

  } else if (acao === 'arquivar') {
    /* Arquivar um rascunho tira dele o sigilo: a API só esconde de
       terceiros o que está em DRAFT, então o texto que nunca foi
       publicado passaria a abrir para qualquer visitante — e publicar
       depois deixa de ser possível, porque publish exige DRAFT. */
    if (rfc.status === 'DRAFT') {
      avisoGeral = 'Rascunho não se arquiva: ele já está fora de todas as listagens. Ou publique, ou deixe onde está.';
    } else if (!f.get('confirmo')) {
      avisoGeral = 'Marque a confirmação antes de arquivar.';
    } else {
      const r = await comSessao(Astro.cookies, 'POST', `/rfcs/${rfc.id}/archive`);
      if (r.ok) return Astro.redirect(`/rfcs/${rfc.slug}`);
      avisoGeral = r.erro ?? 'Não consegui arquivar agora.';
    }

  } else if (acao === 'tags') {
    valorTags = String(f.get('tags') ?? '');
    const separadas = separarTags(valorTags);
    const erroTags = erroDeTags(separadas);

    if (erroTags) {
      erros.tags = erroTags;
    } else {
      const tags = separadas.tags;
      const r = await comSessao(Astro.cookies, 'POST', `/rfcs/${rfc.id}/tags`, { tags });
      if (r.ok) {
        avisoOk = tags.length
          ? 'Tags trocadas. O conjunto agora é exatamente o que está no campo.'
          : 'Tags removidas: a ideia ficou sem nenhuma.';
        valorTags = null;
      } else {
        avisoGeral = r.erro ?? 'Não consegui trocar as tags agora.';
      }
    }

  } else {
    valores = {
      title:   String(f.get('title') ?? '').trim(),
      summary: String(f.get('summary') ?? '').trim(),
      body:    String(f.get('body') ?? '').trim(),
    };
    erros = validar(valores);

    if (Object.keys(erros).length === 0) {
      const corpoMudou = valores.body !== rfc.body;
      const r = await comSessao<Rfc>(Astro.cookies, 'PATCH', `/rfcs/${rfc.id}`, valores);

      if (r.ok && r.dado) {
        rfc = r.dado;
        valores = { title: rfc.title, summary: rfc.summary, body: rfc.body };
        avisoOk = corpoMudou
          ? `Salvo. O corpo mudou, então nasceu a versão ${rfc._count.versions} — a anterior continua no histórico.`
          : 'Salvo. O corpo não mudou, então nenhuma versão nova foi criada.';
      } else {
        avisoGeral = r.erro ?? 'Não consegui salvar agora.';
      }
    }
  }
}

/* Vem de /rfcs/nova, que cria o rascunho e manda pra cá. */
const recemCriada = Astro.url.searchParams.get('criada') === '1';
const tagsFalharam = Astro.url.searchParams.get('tags') === 'falhou';

/* Aqui a leitura precisa distinguir falha de vazio: um campo de tags
   em branco significa "apague todas", então uma leitura que falhou em
   silêncio faria a pessoa remover as tags reais achando que não havia
   nenhuma. Por isso comSessao, e não listarTagsDaRfc. */
const leituraTags = rfc
  ? await comSessao<Tag[]>(Astro.cookies, 'GET', `/rfcs/${rfc.id}/tags`)
  : null;
const tagsIlegiveis = !!leituraTags && !leituraTags.ok;
const tags = leituraTags?.dado ?? [];
const campoTags = valorTags ?? tags.map((t) => t.name).join(', ');

if (!rfc) Astro.response.status = semRede ? 503 : 404;

/* alias const: garante o estreitamento de tipo dentro do template */
const ideia = rfc;
const rascunho = ideia?.status === 'DRAFT';
const arquivada = ideia?.status === 'ARCHIVED';
/* O número nasce na publicação e nunca é devolvido. É ele, e não a
   ausência de DRAFT, que diz se a ideia chegou a existir em público:
   um rascunho arquivado não é DRAFT e mesmo assim nunca foi publicado. */
const publicada = ideia != null && ideia.number != null;

/* A versão que nasce se o corpo for salvo diferente. Não é chute: a
   API numera a versão pela contagem, e é essa conta que a mensagem de
   "salvo" já usa depois do PATCH. */
const proximaVersao = (ideia?._count.versions ?? 0) + 1;

/* O número é atribuído pela sequence do Postgres no publish, então
   nem esta tela sabe qual será. A vaga em branco é a única forma
   honesta de mostrar o formato sem inventar um número. */
const CODIGO_VAGO = 'RFC-____';

const descreve = (campo: string) =>
  [`ajuda-${campo}`, erros[campo] && `erro-${campo}`].filter(Boolean).join(' ');
---

<Layout title={ideia ? `Editar · ${ideia.title}` : 'Não encontrei essa ideia · Idearium'}>
  <div class="palco">
    <Nav atual="rfcs" />

    {!ideia ? (
      <>
        <header class="cabecalho-pagina">
          <a class="volta" href="/rfcs">&larr; todas as ideias</a>
          <h1>Não encontrei essa <span class="serif">ideia</span>.</h1>
        </header>
        <Vazio
          falha={semRede}
          titulo={semRede ? 'O servidor não respondeu' : 'Nada para editar neste endereço'}
          texto={semRede
            ? 'Não consegui falar com a API, então não sei nem se essa ideia existe. Tente de novo em instantes.'
            : 'Ou o endereço está errado, ou essa ideia não é sua para editar. Rascunho só existe para quem escreveu.'}
          acaoHref="/rfcs"
          acaoTexto="ver as ideias abertas"
        />
      </>
    ) : (
      <>
        <header class="cabecalho-pagina">
          <a class="volta" href={`/rfcs/${ideia.slug}`}>&larr; ver a ideia</a>
          <div class="chips" style="margin-top:14px">
            <span class="chip pastel" style={`background: var(--color-${ideia.lab.slug})`}>
              <span aria-hidden="true">{ideia.lab.glyph}</span> {nomeCurtoDoLab(ideia.lab.name)}
            </span>
            <span class="chip">{statusLabel[ideia.status]}</span>
            <span class="codigo">{codigoRfc(ideia.number)}</span>
          </div>
          <h1>Editando <span class="serif">{ideia.title}</span></h1>
          <p class="sub">
            {rascunho
              ? 'Ainda é rascunho: só você enxerga, e ela ainda não tem número. O cartão ao lado é o que o resto do mundo vai ver quando você publicar.'
              : publicada
                ? 'Já está publicada e tem número permanente. Toda mudança no corpo entra no histórico, à vista de quem lê.'
                : 'Foi arquivada antes de ser publicada, então nunca recebeu número. O texto continua aqui e continua editável.'}
          </p>
        </header>

        {recemCriada && (
          <p class="aviso-ok" role="status">
            <b>Rascunho criado.</b> Ele existe, mas ninguém além de você o vê.
            Quando quiser, publique.
          </p>
        )}
        {tagsFalharam && (
          <p class="aviso-erro" role="alert">
            <b>As tags não foram salvas.</b> O rascunho está inteiro, só o
            conjunto de tags não passou. Tente de novo no bloco de tags.
          </p>
        )}
        {avisoOk && <p class="aviso-ok" role="status">{avisoOk}</p>}
        {avisoGeral && <p class="aviso-erro" role="alert">{avisoGeral}</p>}
        {Object.keys(erros).length > 0 && (
          <p class="aviso-erro" role="alert">
            <b>Falta ajustar alguma coisa.</b> Os campos com problema estão
            marcados abaixo. Nada do que você escreveu se perdeu.
          </p>
        )}

        <div class="rfc-topo">
          <div>
            <form method="post" novalidate>
              <input type="hidden" name="acao" value="salvar" />
              <article class="cartao">
                <div class="conteudo">

                  <div class:list={['campo', erros.title && 'com-erro']}>
                    <div class="linha-rotulo">
                      <label class="rotulo" for="title">título</label>
                      <span class="mono contador" aria-hidden="true" data-contador="title" data-min={LIMITE.titulo.min} data-max={LIMITE.titulo.max}></span>
                    </div>
                    <input
                      class="entrada"
                      id="title"
                      name="title"
                      type="text"
                      value={valores.title}
                      aria-describedby={descreve('title')}
                      aria-invalid={erros.title ? 'true' : undefined}
                    />
                    <span class="ajuda" id="ajuda-title">
                      De {LIMITE.titulo.min} a {LIMITE.titulo.max} caracteres. O endereço da ideia não muda
                      quando o título muda.
                    </span>
                    {erros.title && <span class="erro-campo" id="erro-title">{erros.title}</span>}
                  </div>

                  <div class:list={['campo', erros.summary && 'com-erro']}>
                    <div class="linha-rotulo">
                      <label class="rotulo" for="summary">resumo</label>
                      <span class="mono contador" aria-hidden="true" data-contador="summary" data-min={LIMITE.resumo.min} data-max={LIMITE.resumo.max}></span>
                    </div>
                    <textarea
                      class="entrada"
                      id="summary"
                      name="summary"
                      rows="3"
                      aria-describedby={descreve('summary')}
                      aria-invalid={erros.summary ? 'true' : undefined}
                    >{valores.summary}</textarea>
                    <span class="ajuda" id="ajuda-summary">
                      De {LIMITE.resumo.min} a {LIMITE.resumo.max} caracteres. É o que aparece no cartão da listagem.
                    </span>
                    {erros.summary && <span class="erro-campo" id="erro-summary">{erros.summary}</span>}
                  </div>

                  <div class:list={['campo', erros.body && 'com-erro']}>
                    <div class="linha-rotulo">
                      <label class="rotulo" for="body">corpo</label>
                      <span class="mono contador" aria-hidden="true" data-contador="body" data-min={LIMITE.corpo.min} data-max={LIMITE.corpo.max}></span>
                    </div>
                    <textarea
                      class="entrada corpo-longo"
                      id="body"
                      name="body"
                      aria-describedby={descreve('body')}
                      aria-invalid={erros.body ? 'true' : undefined}
                    >{valores.body}</textarea>
                    <span class="ajuda" id="ajuda-body">
                      Mínimo de {LIMITE.corpo.min} caracteres. Aceita markdown simples:
                      <span class="codigo">## título</span>, <span class="codigo">- lista</span>,
                      <span class="codigo">**negrito**</span> e <span class="codigo">`código`</span>.
                      Qualquer outra marcação aparece como texto puro.
                    </span>
                    {erros.body && <span class="erro-campo" id="erro-body">{erros.body}</span>}
                  </div>

                  <div class="acoes-form">
                    <button class="botao" type="submit">salvar</button>
                    <span class="separador"></span>
                    <a class="botao leve" href={`/rfcs/${ideia.slug}`}>ver como ficou</a>
                  </div>

                </div>
              </article>
            </form>
          </div>

          <aside class="lado-rfc">
            {/* ---- ato 2: publicar. O objeto público, montando ---- */}
            <div
              class="previa-cartao"
              data-quando="agora"
              data-estado-agora={statusLabel[ideia.status]}
              data-estado-depois={statusLabel.IN_DISCUSSION}
              data-codigo-agora={codigoRfc(ideia.number)}
              data-codigo-depois={CODIGO_VAGO}
            >
              <p class="rotulo-previa">o cartão público desta ideia</p>

              <CartaoIdeia rfc={ideia} />

              {rascunho && (
                <div class="troca-quando" role="group" aria-label="o cartão, antes e depois de publicar">
                  <button class="filtro" type="button" data-quando="agora" aria-pressed="true">agora</button>
                  <button class="filtro" type="button" data-quando="depois" aria-pressed="false">depois de publicar</button>
                </div>
              )}

              <p class="nota-previa">
                Título e resumo acompanham o formulário enquanto você escreve.
                {rascunho
                  ? ' O chip e o número só mudam quando você publicar — e a capa é desenhada a partir do número, então ela nasce junto com ele.'
                  : publicada
                    ? ' O número já é permanente e não acompanha nada.'
                    : ' Ela nunca recebeu número, então o cartão mostra "rascunho" no lugar dele.'}
              </p>
            </div>

            {rascunho ? (
              <div class="bloco">
                <p class="titulo-bloco">publicar</p>
                <p class="texto-bloco">
                  Publicar tira a ideia da gaveta: ela entra nas listagens, abre
                  para discussão e para quem quiser construir. É este botão que
                  troca o chip do cartão acima.
                </p>
                <p class="texto-bloco fraco">
                  No mesmo instante o banco atribui o número, em sequência. Nem
                  esta tela sabe qual será — por isso a vaga aparece em branco.
                  Depois de atribuído ele nunca muda, e publicar não tem desfazer.
                </p>
                <form method="post">
                  <input type="hidden" name="acao" value="publicar" />
                  <button class="botao" type="submit" data-botao-publicar>publicar</button>
                </form>
              </div>
            ) : publicada ? (
              <div class="bloco">
                <p class="titulo-bloco">já publicada</p>
                <div class="linha"><span>número</span><b>{codigoRfc(ideia.number)}</b></div>
                <div class="linha"><span>publicada</span><b>{haQuantoTempo(ideia.publishedAt)}</b></div>
                <p class="texto-bloco fraco" style="margin-top:12px">
                  O número é permanente. Ele identifica a ideia mesmo depois de
                  o título mudar.
                </p>
              </div>
            ) : (
              <div class="bloco">
                <p class="titulo-bloco">nunca publicada</p>
                <p class="texto-bloco">
                  Ela foi arquivada enquanto ainda era rascunho: não recebeu
                  número e não passou por nenhuma listagem.
                </p>
                <div class="linha"><span>número</span><b>nenhum</b></div>
                <div class="linha"><span>arquivada</span><b>{haQuantoTempo(ideia.archivedAt)}</b></div>
                <p class="texto-bloco fraco" style="margin-top:12px">
                  Publicar exige rascunho, e ela deixou de ser um ao ser
                  arquivada. Hoje não existe caminho de volta.
                </p>
              </div>
            )}

            {/* ---- ato 1: editar o corpo. A errata que vai nascer ----
                O corpo salvo vai como JSON porque é texto longo e com
                quebras de linha: atributo data-* teria que escapar tudo
                e ainda assim chegaria colado. */}
            <div class="bloco" id="errata-viva" data-estado="igual">
              <p class="titulo-bloco">a errata que nasce</p>

              <div class="linha"><span>versões hoje</span><b>{ideia._count.versions}</b></div>
              <div class="linha"><span>última mudança</span><b>{haQuantoTempo(ideia.updatedAt)}</b></div>

              <p class="texto-bloco so-igual" style="margin-top:12px">
                O corpo está igual ao que já foi salvo. Salvar agora não cria
                versão nova, e nada aparece no histórico.
              </p>

              <p class="texto-bloco so-acrescido" style="margin-top:12px">
                O corpo mudou, mas nenhum trecho foi trocado: o que você fez foi
                acrescentar ou cortar. A <b>v0.{proximaVersao}</b> nasce do mesmo
                jeito, e o texto anterior continua no histórico.
              </p>

              <div class="errata" data-aberta="sim">
                <button class="gatilho" type="button" aria-expanded="true">
                  <span class="chevron"></span> errata · o trecho que você trocou
                </button>
                <div class="fole"><div><div class="corpo">
                  <span class="riscado"></span>
                  <span class="para"></span>
                  <span class="data">vai nascer como v0.{proximaVersao} quando você salvar</span>
                </div></div></div>
              </div>

              <p class="texto-bloco fraco" style="margin-top:14px">
                Errata é isto: o trecho antigo continua legível, riscado, com a
                correção ao lado e datada. Editar não sobrescreve — nada se perde.
                Só o corpo cria versão; título e resumo mudam em silêncio.
              </p>

              <script type="application/json" id="corpo-salvo" is:inline set:html={
                JSON.stringify(ideia.body).replace(/</g, '\\u003c')
              }></script>
            </div>

            <div class="bloco">
              <p class="titulo-bloco">tags</p>
              {tagsIlegiveis ? (
                <p class="aviso-erro" role="alert" style="margin:0">
                  <b>Não consegui ler as tags desta ideia.</b> O formulário fica
                  fora do ar de propósito: campo vazio aqui significa apagar
                  todas, e eu não sei o que há para apagar. Recarregue em
                  instantes.
                </p>
              ) : (
                <>
                  <form method="post">
                    <input type="hidden" name="acao" value="tags" />
                    <div class:list={['campo', erros.tags && 'com-erro']} style="margin-bottom:12px">
                      <label class="rotulo" for="tags">o conjunto inteiro</label>
                      <input
                        class="entrada mono"
                        id="tags"
                        name="tags"
                        type="text"
                        value={campoTags}
                        aria-describedby={descreve('tags')}
                        aria-invalid={erros.tags ? 'true' : undefined}
                        placeholder="mobilidade, praça"
                      />
                      <span class="ajuda" id="ajuda-tags">
                        Separe por vírgula, até {LIMITE.tags.max} tags. O que você enviar
                        <b> substitui todas as tags de uma vez</b>: o que sair do campo
                        sai da ideia. Campo vazio remove todas. Só letras e números
                        contam, então "praça" e "praca" são a mesma tag.
                      </span>
                      {erros.tags && <span class="erro-campo" id="erro-tags">{erros.tags}</span>}
                    </div>
                    <button class="botao leve" type="submit">trocar tags</button>
                  </form>

                  {tags.length > 0 && (
                    <div class="nuvem-tags" style="margin-top:14px">
                      {tags.map((t) => <span class="tag">{t.name}</span>)}
                    </div>
                  )}
                </>
              )}
            </div>

            {/* Arquivar é a ação mais fria da tela e a única sem volta
                hoje: fica por último e sem o cartão branco, pra não
                disputar peso com publicar. */}
            {arquivada ? (
              <div class="bloco discreto">
                <p class="titulo-bloco">arquivada</p>
                <p class="texto-bloco">
                  Foi arquivada {haQuantoTempo(ideia.archivedAt)}. Nada foi deletado: o
                  texto continua legível no endereço dela, com a discussão, as
                  inscrições e todas as versões. Tirar do arquivo ainda não
                  existe — nenhuma tela e nenhuma rota devolvem a ideia ao
                  estado anterior.
                </p>
              </div>
            ) : rascunho ? null : (
              <div class="bloco discreto">
                <p class="titulo-bloco">arquivar</p>
                <p class="texto-bloco">
                  Arquivar diz que a ideia esfriou, e só isso. <b>Não deleta.</b> Ela
                  sai das listagens, mas continua legível no endereço dela, com o
                  texto, a discussão, as inscrições e todas as versões de pé.
                </p>
                <p class="texto-bloco fraco">
                  Voltar do arquivo é previsto no desenho do produto, mas ainda não
                  existe tela nem rota que desarquive. Hoje, quando arquivar, fica
                  arquivada.
                </p>
                <form method="post">
                  <input type="hidden" name="acao" value="arquivar" />
                  <label class="marcavel" style="margin-bottom:14px">
                    <input type="checkbox" name="confirmo" value="1" />
                    <span class="caixa" aria-hidden="true">
                      <svg viewBox="0 0 12 12"><path d="M1.5 6.3 L4.4 9.2 L10.5 3" /></svg>
                    </span>
                    <span style="font-size:13px">entendo que a ideia sai das listagens e que hoje não há como desarquivar</span>
                  </label>
                  <button class="botao perigo" type="submit">arquivar</button>
                </form>
              </div>
            )}
          </aside>
        </div>
      </>
    )}

    <Rodape />
  </div>
</Layout>

<style>
  /* o contador mora na linha do rótulo, colado no limite que ele mede,
     mas FORA do <label>: dentro dele o número entraria no nome acessível
     do campo e seria reanunciado a cada tecla digitada */
  .campo > .linha-rotulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .linha-rotulo > .rotulo {
    font-size: 13px;
    font-weight: 460;
    color: var(--t-90);
  }
  .contador { font-size: 10.5px; color: var(--t-35); font-weight: 400; }
  .contador.fora { color: var(--t-90); font-weight: 460; }
</style>

{/* Global de propósito, e todo prefixado por classe que só existe nesta
    tela: o cartão da prévia é o CartaoIdeia.astro, e regra escopada não
    entra em componente importado nem em nó criado por JS. */}
<style is:global>
  /* ---------------- a prévia: o objeto público ---------------- */
  .previa-cartao { display: grid; gap: 12px; }
  .previa-cartao .rotulo-previa {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--t-35);
    margin: 0;
  }
  /* o cartão nasce em opacity 0 esperando o observador do átrio, que
     aqui não existe: a prévia é o que precisa estar visível primeiro */
  .previa-cartao .ideia { opacity: 1; margin-bottom: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .previa-cartao .ideia { animation: cartao-sobe 620ms var(--ease) both; }
  }

  /* placeholder no idioma do produto, não esqueleto cinza: campo
     esvaziado continua ensinando o que vai naquele lugar */
  .previa-cartao .ideia h3.vago,
  .previa-cartao .ideia p.vago { color: var(--t-35); }

  .previa-cartao .troca-quando { display: flex; gap: 6px; flex-wrap: wrap; }
  .previa-cartao .nota-previa { margin: 0; font-size: 12.5px; color: var(--t-50); }

  /* --- a capa é a única peça que não dá pra mostrar ---
     A semente do dither inclui o número, então o desenho de agora não é
     o de depois de publicar. Trocar por outro desenho seria inventar;
     esconder seria fingir que a capa não muda. Ela esmaece e diz. */
  .previa-cartao .capa .nota-capa { display: none; }
  .previa-cartao .capa canvas { transition: opacity 300ms var(--ease); }
  .previa-cartao[data-quando="depois"] .capa canvas { opacity: 0.2; }
  .previa-cartao[data-quando="depois"] .capa .nota-capa {
    display: grid;
    place-items: center;
    position: absolute;
    inset: 0;
    padding: 0 18px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--t-50);
  }

  /* --- a peça animada: a vaga do número abrindo e fechando --- */
  @keyframes codigo-vaga {
    from { opacity: 0; letter-spacing: 0.22em; }
    to   { opacity: 1; letter-spacing: 0.02em; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .previa-cartao .codigo.trocou { animation: codigo-vaga 300ms var(--ease) both; }
  }

  /* ---------------- blocos da coluna ---------------- */
  .lado-rfc .texto-bloco { margin: 0 0 14px; font-size: 13.5px; color: var(--t-75); }
  .lado-rfc .texto-bloco:last-child { margin-bottom: 0; }
  .lado-rfc .texto-bloco b { font-weight: 460; color: var(--t-100); }
  .lado-rfc .texto-bloco.fraco { font-size: 12.5px; color: var(--t-50); }
  .lado-rfc .texto-bloco.fraco b { color: var(--t-75); }

  /* arquivar não é um cartão: é o rodapé frio da coluna */
  .lado-rfc .bloco.discreto {
    background: transparent;
    box-shadow: none;
    border: 1px solid var(--t-07);
    padding: 18px 20px 20px;
  }

  /* ---------------- a errata que nasce ---------------- */
  #errata-viva:not([data-estado="igual"])     .so-igual     { display: none; }
  #errata-viva:not([data-estado="acrescido"]) .so-acrescido { display: none; }
  #errata-viva:not([data-estado="trocado"])   .errata       { display: none; }

  /* parágrafo longo não pode esticar a coluna inteira: o trecho rola
     dentro do fole, que continua sendo quem abre e fecha */
  #errata-viva .errata .corpo { max-height: 230px; overflow-y: auto; }
</style>

<script>
  function ligarContadores() {
    const marcadores = document.querySelectorAll<HTMLElement>('[data-contador]');

    for (const marcador of marcadores) {
      const campo = document.getElementById(marcador.dataset.contador!) as
        HTMLInputElement | HTMLTextAreaElement | null;
      if (!campo) continue;

      const min = Number(marcador.dataset.min);
      const max = Number(marcador.dataset.max);

      const atualizar = () => {
        const n = campo.value.trim().length;
        const curto = n > 0 && n < min;
        marcador.textContent = curto ? `${n} / mínimo ${min}` : `${n} / ${max}`;
        marcador.classList.toggle('fora', curto || n > max);
      };

      campo.addEventListener('input', atualizar);
      atualizar();
    }
  }

  const semMovimento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* O texto na tela atrasa a intenção em uma fase inteira, então quem
     manda é o alvo, não o textContent. Sem isso, entrar e sair do botão
     antes dos 150ms deixa um timeout órfão escrever o rótulo do estado
     que a pessoa desistiu de ver, ao lado de um código que já voltou —
     um par que nem o banco nem a API sabem produzir. */
  let alvoDoRotulo: string | null = null;
  let trocaPendente: ReturnType<typeof setTimeout> | undefined;

  /* Troca de rótulo em três fases, a mesma do chip do átrio: sai por
     cima desfocado, o texto muda fora de vista, entra por baixo. */
  function trocarRotulo(no: HTMLElement, texto: string) {
    if (alvoDoRotulo === texto) return;
    alvoDoRotulo = texto;
    clearTimeout(trocaPendente);

    if (semMovimento()) { no.textContent = texto; return; }

    const dur = parseInt(getComputedStyle(no).getPropertyValue('--swap-dur')) || 150;
    no.classList.add('saindo');
    trocaPendente = setTimeout(() => {
      no.textContent = texto;
      no.classList.remove('saindo');
      no.classList.add('entrando-de-baixo');
      void no.offsetWidth;                    // reflow: sem isso o salto anima
      no.classList.remove('entrando-de-baixo');
    }, dur);
  }

  /* ---------- a prévia: o cartão público se montando ----------
     Os nós vêm do CartaoIdeia.astro, então a busca é pelo markup dele
     de propósito: prévia que reimplementa o cartão mente na hora em
     que o componente mudar. */
  function ligarPrevia() {
    const previa = document.querySelector<HTMLElement>('.previa-cartao');
    const titulo = previa?.querySelector<HTMLElement>('.ideia h3');
    const resumo = previa?.querySelector<HTMLElement>('.ideia .miolo > p');
    const campoTitulo = document.getElementById('title') as HTMLInputElement | null;
    const campoResumo = document.getElementById('summary') as HTMLTextAreaElement | null;
    if (!previa || !titulo || !resumo || !campoTitulo || !campoResumo) return;

    const espelhar = () => {
      const t = campoTitulo.value.trim();
      const r = campoResumo.value.trim();
      titulo.textContent = t || 'sua ideia aparece aqui';
      titulo.classList.toggle('vago', !t);
      resumo.textContent = r || 'e o resumo, aqui — é por ele que alguém escolhe entrar';
      resumo.classList.toggle('vago', !r);
    };
    campoTitulo.addEventListener('input', espelhar);
    campoResumo.addEventListener('input', espelhar);
    espelhar();

    /* Só rascunho tem "depois": publicada e arquivada não trocam mais
       de chip, e um botão que não muda nada seria enfeite. */
    const botoes = Array.from(previa.querySelectorAll<HTMLButtonElement>('.troca-quando button'));
    const chip = previa.querySelector<HTMLElement>('.chip.pequeno');
    const codigo = previa.querySelector<HTMLElement>('.codigo');
    if (!botoes.length || !chip || !codigo) return;

    /* o rótulo do chip precisa de um nó só pra ele: é ele que sai e
       entra na troca, sem levar o ponto junto */
    const rotulo = document.createElement('span');
    rotulo.className = 'rotulo-estado';
    rotulo.textContent = (chip.textContent ?? '').trim();
    chip.textContent = '';
    chip.append(rotulo);
    /* o nó é outro a cada navegação: alvo herdado da página anterior
       engoliria a primeira troca desta */
    alvoDoRotulo = rotulo.textContent;

    /* A capa é desenhada a partir de uma semente que inclui o número, e
       o número só existe depois do publish: no estado "depois" ela é a
       única peça do cartão que ainda não pode ser a verdadeira. Dizer
       isso em cima da imagem é o mesmo idioma da vaga em branco. */
    const capa = previa.querySelector<HTMLElement>('.capa');
    if (capa) {
      const notaCapa = document.createElement('span');
      notaCapa.className = 'nota-capa';
      notaCapa.textContent = 'a capa nasce com o número';
      capa.append(notaCapa);
    }

    const d = previa.dataset;
    let fixado = 'agora';

    const mostrar = (quando: string) => {
      if (previa.dataset.quando === quando) return;
      previa.dataset.quando = quando;
      const depois = quando === 'depois';

      trocarRotulo(rotulo, depois ? d.estadoDepois! : d.estadoAgora!);
      codigo.textContent = depois ? d.codigoDepois! : d.codigoAgora!;
      codigo.classList.remove('trocou');
      void codigo.offsetWidth;
      codigo.classList.add('trocou');

      /* o ponto que respira só existe em "em discussão": criar e
         remover é mais honesto que escondê-lo com CSS */
      chip.classList.toggle('vivo', depois);
      chip.querySelector('.ponto')?.remove();
      if (depois) {
        const ponto = document.createElement('span');
        ponto.className = 'ponto';
        chip.prepend(ponto);
      }
    };

    for (const b of botoes) {
      b.addEventListener('click', () => {
        fixado = b.dataset.quando!;
        mostrar(fixado);
        for (const o of botoes) o.setAttribute('aria-pressed', String(o === b));
      });
    }

    /* alcançar o botão de publicar já é o começo do ato: o cartão
       mostra a consequência antes do clique, e volta se você desistir */
    const publicar = document.querySelector<HTMLElement>('[data-botao-publicar]');
    if (publicar) {
      publicar.addEventListener('pointerenter', () => mostrar('depois'));
      publicar.addEventListener('focus', () => mostrar('depois'));
      publicar.addEventListener('pointerleave', () => mostrar(fixado));
      publicar.addEventListener('blur', () => mostrar(fixado));
    }
  }

  /* ---------- a errata que vai nascer ----------
     Mesma leitura do átrio: o primeiro parágrafo que existe nos dois
     textos e mudou. Parágrafo acrescentado ou cortado não é errata —
     não há trecho antigo pra riscar. */
  function acharErrata(antes: string, agora: string) {
    const pa = antes.split('\n');
    const pb = agora.split('\n');
    for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
      const a = (pa[i] ?? '').trim();
      const b = (pb[i] ?? '').trim();
      if (a && b && a !== b) return { de: a, para: b };
    }
    return null;
  }

  function ligarErrataViva() {
    const bloco = document.getElementById('errata-viva');
    const salvo = document.getElementById('corpo-salvo');
    const campo = document.getElementById('body') as HTMLTextAreaElement | null;
    const riscado = bloco?.querySelector<HTMLElement>('.riscado');
    const para = bloco?.querySelector<HTMLElement>('.para');
    if (!bloco || !salvo || !campo || !riscado || !para) return;

    /* o corpo salvo, e não o valor inicial do campo: depois de um POST
       recusado o campo já traz o texto novo, e comparar com ele mesmo
       diria que nada mudou */
    const original = (JSON.parse(salvo.textContent ?? '""') as string).trim();

    const atualizar = () => {
      const agora = campo.value.trim();       // é o que o servidor compara
      if (agora === original) { bloco.dataset.estado = 'igual'; return; }

      const e = acharErrata(original, agora);
      if (!e) { bloco.dataset.estado = 'acrescido'; return; }

      riscado.textContent = e.de;
      para.textContent = e.para;
      bloco.dataset.estado = 'trocado';
    };

    campo.addEventListener('input', atualizar);
    atualizar();

    /* o fole 0fr → 1fr, igual ao do átrio */
    const errata = bloco.querySelector<HTMLElement>('.errata');
    const gatilho = errata?.querySelector<HTMLButtonElement>('.gatilho');
    gatilho?.addEventListener('click', () => {
      const abrindo = errata!.dataset.aberta !== 'sim';
      errata!.dataset.aberta = abrindo ? 'sim' : 'nao';
      gatilho.setAttribute('aria-expanded', String(abrindo));
    });
  }

  document.addEventListener('astro:page-load', () => {
    ligarContadores();
    ligarPrevia();
    ligarErrataViva();
  });
</script>
