  .secao .linha {
    display: flex; justify-content: space-between; gap: 12px;
    font-size: 13.5px; color: var(--t-65);
    padding: 6px 0;
    font-variant-numeric: tabular-nums;
  }
  .secao .linha b { font-weight: 500; color: var(--t-100); }
