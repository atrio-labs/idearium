  .cabecalho-escrita .volta {
    display: inline-block;
    font-size: 13px;
    color: var(--t-65);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .cabecalho-escrita .volta:hover { color: var(--t-100); }
  .cabecalho-escrita .chips { margin-bottom: 24px; }
  .cabecalho-escrita .titulo-duplo { max-width: 18ch; margin-bottom: 16px; }
  /* o título da ideia pode ter 200 caracteres: o h1 encolhe e quebra
     em vez de estourar a coluna */
  .cabecalho-escrita .titulo-longo {
    font-size: clamp(28px, 3.6vw, 44px);
    max-width: 26ch;
    overflow-wrap: anywhere;
  }

  .avisos { padding: 0 4px; max-width: 648px; }
  .avisos > p { margin: 0 0 16px; }

  .escrita-grade {
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 320px);
