---
/* ================================================================
   /rfcs/:slug/versoes — versões anteriores e o que mudou entre elas
   ================================================================
   VISAO §6: nada se deleta. Cada edição do corpo vira uma versão, e
   esta tela é onde isso fica à vista: a lista de versões, o diff
   entre duas quaisquer e o texto integral de cada uma.

   SSR, sem prerender: a RFC e as versões são lidas COM sessão (o
   rascunho só existe pra quem escreveu), do mesmo jeito que
   /rfcs/[slug].astro.

   Estados da querystring (tudo GET, funciona sem JS):
     (nada)        compara a última versão com a anterior
     ?de=N&para=M compara qualquer par
     ?v=N          mostra o texto completo da versão N

   O texto da versão vai em <pre>, como foi escrito (markdown cru), e
   NÃO passa pelo renderer de markdown da página da RFC: esse parser
   está em troca e esta tela não deve depender dele.

   Só o corpo é versionado. Título e resumo mostram sempre o estado
   atual, e a tela diz isso.
   ================================================================ */
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/astro/Nav.astro';
import Rodape from '../../../components/astro/Rodape.astro';
import Vazio from '../../../components/astro/Vazio.astro';
import { comSessao } from '../../../lib/sessao';
import { compararVersoes } from '../../../lib/diff';
import { haQuantoTempo, codigoRfc, type Rfc, type Versao } from '../../../lib/api';
import { idiomaDe, rota, t, type Chave } from '../../../lib/i18n';
import { cicloLigado } from '../../../lib/ciclo';

const lang = idiomaDe(Astro);
const loc = lang === 'en' ? 'en' : 'pt-BR';
const { slug } = Astro.params;
const usuario = Astro.locals.usuario;
/* C1 (PUBLIC_CICLO): a nota de mudança aparece junto da versão */
const ciclo = cicloLigado();
const notaDe = (v?: Versao) => (ciclo && v?.changeNote?.trim()) || null;

/* Com sessão a resposta pode trazer rascunho: nada de cache. Sem
   sessão é igual pra todo mundo e o CDN pode segurar. */
Astro.response.headers.set(
  'Cache-Control',
  usuario ? 'private, no-store' : 'public, s-maxage=60, stale-while-revalidate=600',
);

const leituraRfc = await comSessao<Rfc>(Astro.cookies, 'GET', `/rfcs/${slug}`);
const rfc = leituraRfc.ok ? leituraRfc.dado : null;
/* 404 é "não existe pra você"; qualquer outra falha é servidor fora. */
const semRede = !rfc && leituraRfc.status !== 404;

if (!rfc && !semRede) return Astro.redirect(rota(lang, '/rfcs'));
if (semRede) Astro.response.status = 503;

let versoes: Versao[] = [];
let falhaVersoes = false;
if (rfc) {
  const r = await comSessao<Versao[]>(Astro.cookies, 'GET', `/rfcs/${rfc.id}/versions`);
  falhaVersoes = !r.ok;
  versoes = r.ok && Array.isArray(r.dado) ? [...r.dado].sort((a, b) => b.version - a.version) : [];
}

const porNumero = new Map(versoes.map((v) => [v.version, v]));

/* Número vindo da URL: só inteiro positivo conta. Texto, vazio ou
   decimal viram "inválido" e nunca chegam a um 500. */
function numero(nome: string): { dado: number | null; presente: boolean } {
  const bruto = Astro.url.searchParams.get(nome);
  if (bruto == null || bruto === '') return { dado: null, presente: false };
  return { dado: /^[1-9]\d*$/.test(bruto) ? Number(bruto) : null, presente: true };
}

const pedidoV = numero('v');
const pedidoDe = numero('de');
const pedidoPara = numero('para');

/* Quem escreveu: só dá pra nomear sem chamada extra quando é o autor
   da RFC ou a própria pessoa logada. Nos outros casos omite. */
function autoria(v: Versao): string | null {
  if (v.authorId === rfc?.author.id) return rfc.author.username;
  if (usuario && v.authorId === usuario.id) return usuario.username;
  return null;
}

const dataLonga = (iso: string) =>
  new Date(iso).toLocaleString(loc, {
    day: 'numeric', month: 'long', year: 'numeric',
    hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo',
  });

const maisNova = versoes[0];
const haComparacao = versoes.length > 1;

/* O que a tela mostra, em ordem de precedência. */
let modo: 'texto' | 'diff' | 'invalido' | 'unica' | 'falha' | 'sem-versao' = 'diff';
let mensagemInvalida = '';
let versaoTexto: Versao | undefined;
let de: Versao | undefined;
let para: Versao | undefined;

if (falhaVersoes) {
  modo = 'falha';
} else if (versoes.length === 0) {
  modo = 'sem-versao';
} else if (pedidoV.presente) {
  versaoTexto = pedidoV.dado != null ? porNumero.get(pedidoV.dado) : undefined;
  if (versaoTexto) {
    modo = 'texto';
  } else {
    modo = 'invalido';
    mensagemInvalida = t(lang, 'rfcs.versoes.invalida.v', {
      v: Astro.url.searchParams.get('v') ?? '',
      max: maisNova.version,
    });
  }
} else if (!haComparacao) {
  modo = 'unica';
} else if (pedidoDe.presente || pedidoPara.presente) {
  de = pedidoDe.dado != null ? porNumero.get(pedidoDe.dado) : undefined;
  para = pedidoPara.dado != null ? porNumero.get(pedidoPara.dado) : undefined;
  if (!de || !para) {
    modo = 'invalido';
    mensagemInvalida = t(lang, 'rfcs.versoes.invalida.par', { max: maisNova.version });
  }
} else {
  para = versoes[0];
  de = versoes[1];
}

const resumo = modo === 'diff' && de && para ? compararVersoes(de.body, para.body) : null;
const mesmaVersao = modo === 'diff' && de && para && de.version === para.version;

/* A versão anterior à N na lista, pra "ver o que mudou". */
const anteriorDe = (n: number) => versoes.find((v) => v.version < n);

const plural = (n: number, um: Chave, varios: Chave) => t(lang, n === 1 ? um : varios, { n });
const titulo = rfc ? t(lang, 'rfcs.versoes.titulo', { titulo: rfc.title }) : t(lang, 'rfcs.versoes.titulo.padrao');
---

<Layout title={titulo}>
  <div class="palco">
    <Nav atual="rfcs" />

    {!rfc ? (
      <>
        <header class="topo-versoes">
          <a class="volta" href={rota(lang, '/rfcs')}>{t(lang, 'rfcs.volta')}</a>
          <h1 class="titulo-duplo">{t(lang, 'rfcs.versoes.falha.antes')}<span class="apagado">{t(lang, 'rfcs.versoes.falha.apagado')}{t(lang, 'rfcs.versoes.falha.depois')}</span></h1>
        </header>
        <Vazio
          falha
          titulo={t(lang, 'rfcs.versoes.falha.titulo')}
          texto={t(lang, 'rfcs.versoes.falha.texto')}
          acaoHref={rota(lang, '/rfcs')}
          acaoTexto={t(lang, 'rfcs.versoes.falha.acao')}
        />
      </>
    ) : (
      <>
        <header class="topo-versoes">
          <a class="volta" href={rota(lang, `/rfcs/${rfc.slug}`)}>{t(lang, 'rfcs.versoes.volta')}</a>
          <div class="chips"><span class="chip codigo">{codigoRfc(rfc.number, lang)}</span></div>
          <h1 class="titulo-duplo">{t(lang, 'rfcs.versoes.h1')}<span class="apagado">{rfc.title}</span></h1>
          <p class="apoio">{t(lang, 'rfcs.versoes.sub')}</p>
        </header>

        {falhaVersoes && (
          <p class="aviso-api" role="status">
            <b>{t(lang, 'rfcs.versoes.aviso.negrito')}</b>{t(lang, 'rfcs.versoes.aviso.texto')}
          </p>
        )}

        {modo === 'sem-versao' && (
          <Vazio
            titulo={t(lang, 'rfcs.versoes.primeira.titulo')}
            texto={t(lang, 'rfcs.versoes.primeira.texto')}
            acaoHref={rota(lang, `/rfcs/${rfc.slug}`)}
            acaoTexto={t(lang, 'rfcs.versoes.primeira.acao')}
          />
        )}

        {modo === 'unica' && (
          <Vazio
            titulo={t(lang, 'rfcs.versoes.primeira.titulo')}
            texto={t(lang, 'rfcs.versoes.unica.texto')}
            acaoHref={rota(lang, `/rfcs/${rfc.slug}/versoes?v=${maisNova.version}`)}
            acaoTexto={t(lang, 'rfcs.versoes.unica.acao')}
          />
        )}

        {modo === 'invalido' && (
          <p class="aviso-erro" role="alert">
            <b>{t(lang, 'rfcs.versoes.invalida.negrito')}</b> {mensagemInvalida}
          </p>
        )}

        {versoes.length > 0 && (
          <div class="versoes-layout">
            <div class="versoes-principal">
              {haComparacao && (
                <form class="comparar bloco" method="get" action={rota(lang, `/rfcs/${rfc.slug}/versoes`)}>
                  <p class="titulo-bloco">{t(lang, 'rfcs.versoes.comparar')}</p>
                  <div class="comparar-campos">
                    <label class="campo">
                      <span class="rotulo">{t(lang, 'rfcs.versoes.de')}</span>
                      <select class="entrada" name="de">
                        {versoes.map((v) => (
                          <option value={v.version} selected={v.version === (de?.version ?? versoes[1]?.version)}>
                            v{v.version} · {haQuantoTempo(v.createdAt)}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="campo">
                      <span class="rotulo">{t(lang, 'rfcs.versoes.para')}</span>
                      <select class="entrada" name="para">
                        {versoes.map((v) => (
                          <option value={v.version} selected={v.version === (para?.version ?? versoes[0].version)}>
                            v{v.version} · {haQuantoTempo(v.createdAt)}
                          </option>
                        ))}
                      </select>
                    </label>
                    <button class="botao" type="submit">{t(lang, 'rfcs.versoes.comparar')}</button>
                  </div>
                </form>
              )}

              {modo === 'texto' && versaoTexto && (
                <section class="bloco" aria-labelledby="titulo-texto">
                  <p class="titulo-bloco" id="titulo-texto">
                    {t(lang, 'rfcs.versoes.texto.titulo', { n: versaoTexto.version, quando: haQuantoTempo(versaoTexto.createdAt, lang) })}
                  </p>
                  {notaDe(versaoTexto) && <p class="nota-mudanca">{t(lang, 'ciclo.nota.versao', { nota: notaDe(versaoTexto)! })}</p>}
                  <pre class="texto-versao">{versaoTexto.body}</pre>
                  <p class="nota-versao">
                    {t(lang, 'rfcs.versoes.texto.nota')}
                    {anteriorDe(versaoTexto.version) && (
                      <>
                        {' '}<a href={rota(lang, `/rfcs/${rfc.slug}/versoes?de=${anteriorDe(versaoTexto.version)!.version}&para=${versaoTexto.version}`)}>{t(lang, 'rfcs.versoes.texto.mudou', { n: anteriorDe(versaoTexto.version)!.version })}</a>.
                      </>
                    )}
                  </p>
                </section>
              )}

              {modo === 'diff' && de && para && (
                <section class="bloco" aria-labelledby="titulo-diff">
                  <p class="titulo-bloco" id="titulo-diff">
                    {t(lang, 'rfcs.versoes.diff.titulo', { de: de.version, para: para.version })}
                  </p>

                  {notaDe(para) && <p class="nota-mudanca">{t(lang, 'ciclo.nota.versao', { nota: notaDe(para)! })}</p>}

                  {mesmaVersao ? (
                    <p class="nota-versao">{t(lang, 'rfcs.versoes.diff.mesma')}</p>
                  ) : resumo && resumo.identico ? (
                    <p class="nota-versao">{t(lang, 'rfcs.versoes.diff.identico')}</p>
                  ) : resumo && (
                    <>
                      <p class="resumo-diff">
                        <span class="chip pequeno"><span aria-hidden="true">−</span> {plural(resumo.removidas, 'rfcs.versoes.diff.tiradas.um', 'rfcs.versoes.diff.tiradas.varios')}</span>
                        <span class="chip pequeno"><span aria-hidden="true">+</span> {plural(resumo.acrescidas, 'rfcs.versoes.diff.acrescentadas.um', 'rfcs.versoes.diff.acrescentadas.varios')}</span>
                      </p>
                      <div class="diff" role="group" aria-label={t(lang, 'rfcs.versoes.diff.rotulo', { de: de.version, para: para.version })}>
                        {resumo.blocos.map((b) => {
                          if (b.tipo === 'recolhido') {
                            return (
                              <div class="errata trecho" data-aberta="nao">
                                <button class="gatilho" type="button" aria-expanded="false">
                                  <span class="chevron" aria-hidden="true"></span>
                                  {plural(b.linhas.length, 'rfcs.versoes.diff.iguais.um', 'rfcs.versoes.diff.iguais.varios')}
                                </button>
                                <div class="fole"><div>
                                  {b.linhas.map((l) => (
                                    <div class="dl igual"><span class="sinal" aria-hidden="true"> </span><span class="txt">{l.texto || ' '}</span></div>
                                  ))}
                                </div></div>
                              </div>
                            );
                          }
                          if (b.tipo === 'igual') {
                            return b.linhas.map((l) => (
                              <div class="dl igual"><span class="sinal" aria-hidden="true"> </span><span class="txt">{l.texto || ' '}</span></div>
                            ));
                          }
                          const removido = b.tipo === 'removido';
                          return b.linhas.map((l) => {
                            const pedacos = l.pedacos ?? [{ texto: l.texto || ' ', mudou: false }];
                            const Marca = removido ? 'del' : 'ins';
                            return (
                              <Marca class={`dl ${b.tipo}`}>
                                <span class="sinal" aria-hidden="true">{removido ? '−' : '+'}</span>
                                <span class="so-leitor">{t(lang, removido ? 'rfcs.versoes.diff.removido' : 'rfcs.versoes.diff.acrescentado')}</span>
                                <span class="txt">{pedacos.map((p) => p.mudou ? <span class="palavra">{p.texto}</span> : p.texto)}</span>
                              </Marca>
                            );
                          });
                        })}
                      </div>
                      <noscript><style>.trecho .fole {grid-template-rows: 1fr !important;}</style></noscript>
                    </>
                  )}
                </section>
              )}
            </div>

            <aside class="versoes-lado">
              <div class="bloco">
                <p class="titulo-bloco">{t(lang, 'rfcs.versoes.lado.titulo')}</p>
                <ol class="lista-versoes">
                  {versoes.map((v) => {
                    const ant = anteriorDe(v.version);
                    const quem = autoria(v);
                    const aberta = (modo === 'texto' && versaoTexto?.version === v.version)
                      || (modo === 'diff' && (de?.version === v.version || para?.version === v.version));
                    return (
                      <li class={aberta ? 'atual' : undefined}>
                        <div class="v-linha">
                          <a class="v-num" href={rota(lang, `/rfcs/${rfc.slug}/versoes?v=${v.version}`)}>v{v.version}</a>
                          {v.version === maisNova.version && <span class="chip pequeno">{t(lang, 'rfcs.versoes.atual')}</span>}
                        </div>
                        <time class="v-data" datetime={v.createdAt} title={dataLonga(v.createdAt)}>
                          {haQuantoTempo(v.createdAt, lang)} · {dataLonga(v.createdAt)}
                        </time>
                        {notaDe(v) && <span class="v-nota">{notaDe(v)}</span>}
                        {quem && <span class="v-data">{t(lang, 'rfcs.versoes.por', { nome: quem })}</span>}
                        <span class="v-acoes">
                          <a href={rota(lang, `/rfcs/${rfc.slug}/versoes?v=${v.version}`)}>{t(lang, 'rfcs.versoes.ler')}</a>
                          {ant && <a href={rota(lang, `/rfcs/${rfc.slug}/versoes?de=${ant.version}&para=${v.version}`)}>{t(lang, 'rfcs.versoes.omudou')}</a>}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </aside>
          </div>
        )}
      </>
    )}

    <Rodape />
  </div>
</Layout>

<style is:global>
  .topo-versoes { padding: 64px 8px 40px; display: grid; justify-items: start; gap: 0; }
  .topo-versoes .volta {
    font-size: 13.5px; color: var(--t-65); text-decoration: none;
    display: inline-flex; align-items: center; min-height: 40px;
    transition: color var(--dur) var(--ease);
  }
  .topo-versoes .volta:hover { color: var(--t-100); }
  .topo-versoes .chips { margin: 24px 0 20px; }
  .topo-versoes .titulo-duplo { max-width: 24ch; margin-bottom: 20px; }
  @media (max-width: 520px) { .topo-versoes { padding: 40px 4px 28px; } }

  .versoes-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; padding: 0 8px 96px; }
  @media (max-width: 900px) { .versoes-layout { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .versoes-layout { padding: 0 4px 64px; } }
  .versoes-principal { display: grid; gap: 16px; min-width: 0; }
  .versoes-layout .bloco { margin: 0; }

  .comparar-campos { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
  .comparar-campos .campo { margin: 0; flex: 1 1 160px; }
  .comparar-campos .entrada { min-height: 44px; }
  .comparar-campos .botao { height: 44px; }

  .lista-versoes { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .lista-versoes li { padding: 10px 12px; border-radius: var(--r-dentro); display: grid; gap: 2px; }
  .lista-versoes li.atual { background: var(--rebaixo); }
  .v-linha { display: flex; align-items: center; gap: 8px; }
  .v-num {
    display: inline-flex; align-items: center; min-height: 40px;
    font-size: 14px; font-weight: 500; font-variant-numeric: tabular-nums;
    color: var(--t-100); text-decoration: none;
  }
  .v-num:hover { text-decoration: underline; }
  .v-data { font-size: 12.5px; color: var(--t-65); }
  .v-nota { font-size: 13.5px; color: var(--t-75); }
  .nota-mudanca { margin: 0 0 12px; font-size: 14px; color: var(--t-75); }
  .v-acoes { display: flex; gap: 16px; font-size: 13px; flex-wrap: wrap; }
  .v-acoes a {
    display: inline-flex; align-items: center; min-height: 40px;
    color: var(--t-65); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--t-35);
  }
  .v-acoes a:hover { color: var(--t-100); }

  .texto-versao {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.7;
    color: var(--t-75);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .nota-versao { margin: 14px 0 0; font-size: 13px; color: var(--t-65); }
  .nota-versao a { color: var(--t-100); }

  .resumo-diff { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 18px; }

  /* --- diff ---
     Inserção: fundo lilás muito claro, sinal e realce em roxo.
     Remoção: cinza, riscada. A cor nunca é o único sinal: o sinal −/+,
     o <del>/<ins> e o texto escondido dizem o mesmo. */
  .diff { font-size: 14.5px; line-height: 1.65; }
  .diff .dl {
    display: flex; gap: 10px;
    padding: 2px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--t-75);
  }
  .diff .sinal { flex: 0 0 1ch; font-size: 13px; font-weight: 600; color: var(--t-65); user-select: none; }
  .diff .txt { white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }

  .diff del.dl { background: var(--rebaixo); color: var(--t-65); }
  .diff del.dl .txt { text-decoration: line-through; text-decoration-thickness: 1px; }
  .diff del.dl .palavra { color: var(--t-75); background: var(--t-12); border-radius: 3px; }

  .diff ins.dl { background: #F1E6FB; color: var(--t-100); }
  .diff ins.dl .sinal { color: #7B3FB0; }
  .diff ins.dl .palavra { background: #E2CCF4; color: #4B2170; border-radius: 3px; }

  .diff .errata.trecho { margin: 8px 0; padding-top: 8px; border-top: 1px dashed var(--t-12); }
  .diff .trecho .gatilho { min-height: 40px; }
  .diff .trecho .gatilho:focus-visible { outline: 2px solid var(--tinta); outline-offset: 2px; }
  .diff .trecho .fole > div { padding-top: 6px; }

  /* visually-hidden: lido por leitor de tela, invisível e sem ocupar espaço */
  .so-leitor {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  /* Trechos iguais recolhidos: mesmo fole 0fr → 1fr da errata. Sem JS
     o <noscript> acima mantém tudo aberto. */
  function ligarTrechos() {
    document.querySelectorAll<HTMLElement>('.diff .trecho').forEach((el) => {
      const gatilho = el.querySelector<HTMLButtonElement>('.gatilho');
      if (!gatilho || gatilho.dataset.ligado) return;
      gatilho.dataset.ligado = 'sim';
      gatilho.addEventListener('click', () => {
        const abrindo = el.dataset.aberta !== 'sim';
        el.dataset.aberta = abrindo ? 'sim' : 'nao';
        gatilho.setAttribute('aria-expanded', String(abrindo));
      });
    });
  }
  document.addEventListener('astro:page-load', ligarTrechos);
</script>
