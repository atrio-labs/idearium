---
/* ================================================================
   /rfcs/:slug — detalhe da RFC (F1.3 + participação, F3)
   ================================================================
   Uma rota por RFC, renderizada a cada requisição. Além de ler a
   ideia, esta tela é onde alguém entra pra construir, sai, e discute.
   Toda ação é POST no próprio arquivo seguido de redirect: sem API
   client-side, sem token no browser, e recarregar não repete o envio.

   ----------------------------------------------------------------
   DESENHO: a tela mostra a consequência do ato
   ----------------------------------------------------------------
   São três atos aqui, e nenhum deles é preenchível: são um clique e um
   parágrafo. O que essa tela precisa dizer não é "confira antes de
   enviar", é o que cada ato PRODUZ — e ela diz mexendo no material de
   verdade, não numa maquete ao lado.

     inscrever-se  seu círculo entra na fila real de quem constrói, e o
                   chip da ideia se mostra prestes a virar. Confirmado,
                   a página volta e o chip faz o swap com blur do átrio
                   — agora com dado real, não demonstração.
     sair          seu círculo esmaece e deixa a fila de quem constrói,
                   e o chip volta pra "em discussão" se você for o
                   último. A prévia PARA AQUI de propósito: a API ainda
                   não devolve quem saiu (GET /enrollments filtra
                   leftAt: null), então mostrar o círculo migrando pra
                   "passaram por aqui" seria prometer o que o sistema
                   não faz — prévia que mente é pior que prévia nenhuma.
     comentar      o campo É o comentário: mesma classe, mesma cabeça,
                   no fim da mesma lista. Vazio, é superfície rebaixada;
                   com texto, firma em cartão.

   Nada aqui espelha texto de terceiro pra outro nó: o comentário se
   mostra no próprio campo. É por isso que o preview ao vivo desta tela
   não tem nem como injetar HTML.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import Materia from '../../components/astro/Materia.astro';
import Vazio from '../../components/astro/Vazio.astro';
import BotaoReportar from '../../components/astro/BotaoReportar.astro';
import { autorSuspenso, moderacaoLigada, ocultaParaMim } from '../../lib/moderacao';
import { comSessao } from '../../lib/sessao';
import { cachePublico } from '../../lib/cache';
import {
  LIMITE_API, rotuloDoStatus, nomeDoLab, codigoRfc, haQuantoTempo,
  materiaDaRfc,
  type Rfc, type Versao, type Inscricao, type Comentario, type Tag, type Pagina,
} from '../../lib/api';
import { idiomaDe, rota, separarIdioma, t } from '../../lib/i18n';
import { renderizarMarkdown, renderizarComentario } from '../../lib/markdown';
import RelacaoIdeia from '../../components/astro/RelacaoIdeia.astro';
import { acompanharLigado, estouAcompanhando } from '../../lib/ideia';
import AtualizacoesRfc from '../../components/astro/AtualizacoesRfc.astro';
import {
  cicloLigado, LIMITE_CICLO, listarAtualizacoes, projetoDaRfc, publicarAtualizacao,
  type EstadoAtualizacoes,
} from '../../lib/ciclo';

/* Esta é a única página pública em SSR. Motivo: ela precisa saber
   coisas que dependem de QUEM está lendo — se você já se inscreveu, se
   o comentário é seu, se a RFC é seu rascunho. Nada disso existe em
   build time.

   SSR não prejudica indexação: o crawler recebe o mesmo HTML completo.
   O que se perde é cache, não conteúdo. */

const lang = idiomaDe(Astro);
const { slug } = Astro.params;
const usuario = Astro.locals.usuario;
/* O caminho de volta leva o prefixo do idioma: redirect e ?voltar= que
   perdessem o /en jogariam quem lê em inglês de volta pro português.
   Astro.url pode vir com ou sem o prefixo (depende da reescrita do
   middleware), então o prefixo é tirado e posto de novo. */
const voltar = rota(lang, separarIdioma(Astro.url.pathname).caminho);
const paraEntrar = `${rota(lang, '/entrar')}?voltar=${encodeURIComponent(voltar)}`;

/* A discussão é paginada e a página escolhida vive na querystring, do
   mesmo jeito que o modo de edição: editar, cancelar e remover têm que
   devolver a pessoa pra onde ela estava lendo. */
const pedida = Number(Astro.url.searchParams.get('p'));
const paginaPedida = Number.isInteger(pedida) && pedida > 0 ? pedida : null;

function comPagina(extra?: string) {
  const partes: string[] = [];
  if (paginaPedida) partes.push(`p=${paginaPedida}`);
  if (extra) partes.push(extra);
  return partes.length ? `?${partes.join('&')}` : '';
}

/* Leitura que respeita quem está lendo. Com sessão a chamada vai
   assinada — é o que faz o autor enxergar o próprio rascunho, que pra
   qualquer outra pessoa é 404. Sem sessão não há cookie pra ler e a
   chamada sai sem Authorization, igual à leitura pública.

   Devolve também SE FALHOU, não só o vazio: a tela precisa separar
   "não há nada aqui" de "não falei com o servidor". Cada leitura
   carrega a própria falha, porque a tela precisa dizer QUAL parte
   faltou (comentários, inscrições), não só que algo caiu. */
interface Leitura<T> {
  dado: T;
  falhou: boolean;
}

async function ler<T>(caminho: string, aoFalhar: T): Promise<Leitura<T>> {
  const r = await comSessao<T>(Astro.cookies, 'GET', caminho);
  return {
    dado: r.ok && r.dado != null ? r.dado : aoFalhar,
    /* 404 é resposta legítima — a ideia não existe, ou é rascunho de
       outra pessoa — e não queda do backend. */
    falhou: !r.ok && r.status !== 404,
  };
}

const leituraRfc = await ler<Rfc | null>(`/rfcs/${slug}`, null);
const rfc = leituraRfc.dado;

/* Moderação (PUBLIC_MODERACAO): RFC oculta só aparece pra autor e
   mantenedores; pra o resto, uma tela que diz o que houve. */
const oculta = ocultaParaMim(rfc, usuario);
const ocultaVisivel = moderacaoLigada() && !!rfc?.hiddenAt && !oculta;
const voltarComPagina = () => `${voltar}${comPagina()}`;

/* Ideia que não existe pra quem pede é 404 de verdade, com a tela de
   vazio, e não redirect pra lista: redirect esconderia de quem mandou o
   link que o endereço está errado. Servidor fora é 503 e é outra coisa:
   mandar pra /rfcs, que é servida de cache e parece saudável, faria a
   pessoa concluir que a ideia foi apagada. */
const semRede = !rfc && leituraRfc.falhou;
if (!rfc) {
  Astro.response.status = semRede ? 503 : 404;
  if (semRede) Astro.response.headers.set('Retry-After', '30');
}

/* Erro fica onde a ação foi disparada: quem errou no comentário não
   deve descobrir isso na coluna lateral. */
let erroParticipacao: string | null = null;
let erroDiscussao: string | null = null;

/* O que a pessoa escreveu não pode sumir junto com o erro: sem isso,
   um 500 apaga um texto longo e a única saída é escrever de novo. */
let acaoFalha: string | null = null;
let corpoEnviado: string | null = null;
let alvoEnviado = '';

/* C1 (PUBLIC_CICLO): atualização de progresso tem o próprio erro e o
   próprio texto, pra não se misturar com os da discussão. */
const ciclo = cicloLigado();
let erroAtualizacao: string | null = null;
let textoAtualizacao: string | null = null;

if (rfc && !oculta && Astro.request.method === 'POST') {
  if (!usuario) return Astro.redirect(paraEntrar);

  const dados = await Astro.request.formData();
  const acao = String(dados.get('acao') ?? '');
  const corpo = String(dados.get('corpo') ?? '').trim();
  const alvo = String(dados.get('comentario') ?? '');

  if (acao === 'entrar-na-ideia') {
    const r = await comSessao(Astro.cookies, 'POST', `/rfcs/${rfc.id}/enroll`, {});
    /* A troca entre "em discussão" e "em construção" é recalculada pelo
       servidor na mesma transação da inscrição. Por isso recarregamos e
       mostramos o que a API disser: o frontend não opina sobre status. */
    if (r.ok) return Astro.redirect(voltar);
    erroParticipacao = t(lang, r.status === 409 ? 'rfcs.det.erro.inscricao.conflito' : 'rfcs.det.erro.inscricao');

  } else if (acao === 'sair-da-ideia') {
    const r = await comSessao(Astro.cookies, 'DELETE', `/rfcs/${rfc.id}/enroll`);
    if (r.ok) return Astro.redirect(voltar);
    erroParticipacao = t(lang, r.status === 404 ? 'rfcs.det.erro.sair.naoestava' : 'rfcs.det.erro.sair');

  } else if (acao === 'atualizacao' && ciclo) {
    const { min, max } = LIMITE_CICLO.atualizacao;
    if (corpo.length < min || corpo.length > max) {
      erroAtualizacao = t(lang, 'ciclo.atualizacoes.erro.tamanho', { min, max });
    } else {
      const r = await publicarAtualizacao(Astro.cookies, rfc.id, corpo);
      if (r.ok) return Astro.redirect(`${voltar}#atualizacoes`, 303);
      erroAtualizacao = t(lang, r.indisponivel
        ? 'ciclo.indisponivel'
        : r.status === 403
          ? 'ciclo.atualizacoes.erro.permissao'
          : r.status === 409
            ? 'ciclo.atualizacoes.erro.estado'
            : 'ciclo.atualizacoes.erro.publicar');
    }
    if (erroAtualizacao) textoAtualizacao = corpo;

  } else if (acao === 'comentar') {
    if (!corpo) {
      erroDiscussao = t(lang, 'rfcs.det.erro.comentar.vazio');
    } else {
      const r = await comSessao(Astro.cookies, 'POST', `/rfcs/${rfc.id}/comments`, { body: corpo });
      /* Sem página na volta: o padrão é a última, que é onde o
         comentário recém-publicado está. */
      if (r.ok) return Astro.redirect(`${voltar}#discussao`);
      erroDiscussao = t(lang, r.status === 403 ? 'rfcs.det.erro.comentar.arquivada' : 'rfcs.det.erro.comentar');
    }

  } else if (acao === 'editar-comentario') {
    if (!corpo) {
      erroDiscussao = t(lang, 'rfcs.det.erro.editar.vazio');
    } else {
      const r = await comSessao(Astro.cookies, 'PATCH', `/comments/${alvo}`, { body: corpo });
      if (r.ok) return Astro.redirect(`${voltar}${comPagina()}#c-${alvo}`);
      erroDiscussao = t(lang, r.status === 403 || r.status === 404
        ? 'rfcs.det.erro.editar.alheio'
        : 'rfcs.det.erro.editar');
    }

  } else if (acao === 'remover-comentario') {
    const r = await comSessao(Astro.cookies, 'DELETE', `/comments/${alvo}`);
    if (r.ok) return Astro.redirect(`${voltar}${comPagina()}#c-${alvo}`);
    erroDiscussao = t(lang, r.status === 403 || r.status === 404
      ? 'rfcs.det.erro.remover.alheio'
      : 'rfcs.det.erro.remover');
  }

  if (erroDiscussao) {
    acaoFalha = acao;
    corpoEnviado = corpo;
    alvoEnviado = alvo;
  }
}

const semComentarios: Pagina<Comentario> = {
  data: [], meta: { page: 1, limit: LIMITE_API, total: 0, totalPages: 0 },
};

/* A API devolve a discussão em ordem crescente e paginada. Sem pedir
   página, quem abre a RFC vê só os comentários mais antigos e nunca o
   próprio, recém-publicado — que cai na última página. Por isso o
   padrão aqui é a ÚLTIMA página; as anteriores ficam a um link. */
const caminhoComentarios = (p: number) =>
  `/rfcs/${rfc?.id}/comments?page=${p}&limit=${LIMITE_API}`;

/* Sem ideia não há o que ler: a tela de vazio não faz quatro chamadas
   a um id que não existe. */
const semLeitura = <T,>(dado: T): Leitura<T> => ({ dado, falhou: false });

const [leituraVersoes, leituraInscricoes, primeiraLeitura, leituraTags] = rfc
  ? await Promise.all([
    ler<Versao[]>(`/rfcs/${rfc.id}/versions`, []),
    ler<Inscricao[]>(`/rfcs/${rfc.id}/enrollments`, []),
    ler<Pagina<Comentario>>(caminhoComentarios(paginaPedida ?? 1), semComentarios),
    ler<Tag[]>(`/rfcs/${rfc.id}/tags`, []),
  ])
  : [
    semLeitura<Versao[]>([]),
    semLeitura<Inscricao[]>([]),
    semLeitura(semComentarios),
    semLeitura<Tag[]>([]),
  ];

/* Só a primeira leitura sabe quantas páginas existem. A segunda ida à
   API acontece apenas na discussão longa de quem não pediu página. */
const ultimaPagina = primeiraLeitura.dado.meta.totalPages;
const leituraComentarios = paginaPedida == null && ultimaPagina > 1
  ? await ler<Pagina<Comentario>>(caminhoComentarios(ultimaPagina), semComentarios)
  : primeiraLeitura;

/* Atualizações de progresso: só pedidas com a flag ligada e numa ideia
   que já saiu do rascunho. 404 e 405 viram "a API ainda não oferece". */
const mostraAtualizacoes = ciclo && rfc != null && rfc.status !== 'DRAFT';
const atualizacoes: EstadoAtualizacoes = mostraAtualizacoes
  ? await listarAtualizacoes(Astro.cookies, rfc!.id)
  : { tipo: 'indisponivel' };

const versoes = leituraVersoes.dado;
const inscricoes = leituraInscricoes.dado;
const tags = leituraTags.dado;
const comentarios = leituraComentarios.dado;
const falhaComentarios = leituraComentarios.falhou;
const falhaInscricoes = leituraInscricoes.falhou;
const paginaAtual = comentarios.meta.page;
const totalPaginas = comentarios.meta.totalPages;

const ativos = inscricoes.filter((i) => i.leftAt == null);
const m = rfc ? materiaDaRfc(rfc) : null;

const inscrito = usuario != null && ativos.some((i) => i.user.id === usuario.id);
const rascunhoMeu = rfc?.status === 'DRAFT' && usuario?.id === rfc.author.id;

/* Rascunho e ideia arquivada não recebem inscrição — a API recusa com
   409, então o botão nem aparece. */
const aberta = rfc != null && rfc.status !== 'DRAFT' && rfc.status !== 'ARCHIVED';

/* Arquivada também não recebe comentário: a API responde 403 sempre.
   Deixar o campo na tela seria oferecer um caminho que nunca dá certo. */
const discussaoAberta = rfc?.status !== 'ARCHIVED';

/* ---------------- o que cada ato vai causar ----------------
   Esta tela mostra a consequência do ato enquanto o ato acontece, então
   ela precisa prever o que o servidor vai decidir. O cálculo abaixo
   espelha recomputeRfcStatus da API: só inscrição de BUILDER conta, e
   estado terminal (publicada, arquivada) não se mexe. É o único ponto
   da tela que depende de uma regra do backend — se ela mudar lá, a
   previsão daqui mente. */
const construtores = ativos.filter((i) => i.role === 'BUILDER');

/* Quem saiu vem da mesma leitura de inscrições. Hoje a API filtra
   leftAt: null e esta lista chega sempre vazia, então o bloco não
   renderiza — e é por isso que a prévia de sair não promete migração
   pra cá. Quando o backend devolver as encerradas, o bloco aparece
   sozinho, sem mudar nada aqui. */
const quemSaiu = inscricoes.filter((i) => i.leftAt != null);

/* Publica atualização quem escreveu ou está inscrito, e só em
   construção. A API é quem decide de verdade; isto só evita o botão
   que nunca daria certo. */
const podePublicarAtualizacao = mostraAtualizacoes && rfc?.status === 'IN_BUILDING'
  && usuario != null && (inscrito || usuario.id === rfc.author.id);
const projeto = ciclo && rfc ? projetoDaRfc(rfc) : null;

const podeEntrar = aberta && usuario != null && !inscrito;
const podeSair = aberta && inscrito;

/* Sair só devolve a ideia pra "em discussão" se eu for o último
   construtor: com mais gente dentro, o chip nem pisca. */
const souUltimoConstrutor =
  usuario != null && construtores.length === 1 && construtores[0].user.id === usuario.id;

const estadoPrevisto = podeEntrar && rfc?.status === 'IN_DISCUSSION'
  ? 'IN_BUILDING'
  : podeSair && rfc?.status === 'IN_BUILDING' && souUltimoConstrutor
    ? 'IN_DISCUSSION'
    : null;

/* A cara de alguém na tela são duas letras do @ — é o que o VISAO §5.3
   permite mostrar de uma identidade pseudônima. */
const iniciais = (nome: string) => nome.slice(0, 2).toUpperCase();

/* Editar acontece no lugar do texto, e o modo de edição vive na
   querystring: sem isso a tela precisaria de estado no cliente pra uma
   coisa que o servidor já sabe renderizar. */
const editando = Astro.url.searchParams.get('editar');

/* Cada erro fica no formulário que o gerou. O da edição só pode ficar
   inline quando aquele formulário está mesmo na tela; o resto (remoção,
   edição de comentário alheio) aparece no topo da discussão. */
const edicaoNaTela = comentarios.data.some(
  (c) => c.id === editando && usuario != null && c.author.id === usuario.id && !c.isDeleted,
);
const erroNovoComentario = acaoFalha === 'comentar' ? erroDiscussao : null;
const erroEdicao = acaoFalha === 'editar-comentario' && alvoEnviado === editando && edicaoNaTela
  ? erroDiscussao
  : null;
const erroSolto = erroDiscussao && !erroNovoComentario && !erroEdicao ? erroDiscussao : null;

const textoNovoFalha = acaoFalha === 'comentar' ? corpoEnviado : null;
const textoEdicaoFalha = acaoFalha === 'editar-comentario' ? corpoEnviado : null;

const tituloDiscussaoVazia = t(lang, falhaComentarios
  ? 'rfcs.det.vazio.falha.titulo'
  : 'rfcs.det.vazio.titulo');

const textoDiscussaoVazia = t(lang, falhaComentarios
  ? 'rfcs.det.vazio.falha.texto'
  : !discussaoAberta
    ? 'rfcs.det.vazio.arquivada'
    : usuario
      ? 'rfcs.det.vazio.logado'
      : 'rfcs.det.vazio.anonimo');

/* O corpo vem em markdown escrito por qualquer pessoa. O renderer e as
   regras de segurança dele moram em lib/markdown.ts, o mesmo que o
   editor usa na prévia: o que se vê ao escrever é o que se lê aqui. */
const corpoHtml = rfc ? renderizarMarkdown(rfc.body) : '';

/* Acompanhar (PUBLIC_ACOMPANHAR): só pergunta com sessão e flag. null
   esconde o botão, inclusive quando a API ainda não tem o endpoint. */
const acompanhando = rfc && usuario && acompanharLigado()
  ? await estouAcompanhando(Astro.cookies, rfc.id)
  : null;
const erroAcompanhar = Astro.url.searchParams.get('acompanhar') === 'erro';

cachePublico(
  Astro,
  semRede || leituraVersoes.falhou || falhaInscricoes || falhaComentarios || leituraTags.falhou
    || atualizacoes.tipo === 'erro',
);
---

{rfc && !oculta ? (
<Layout title={`${codigoRfc(rfc.number, lang)} · ${rfc.title}`} description={rfc.summary} imagem={`/og/rfc/${rfc.slug}.png`}>
  {/* data-previa é o interruptor da vitrine: o botão de participação o
      liga, e daqui pra baixo cada peça que vai mudar se mostra mudando.
      Fica no palco porque o chip está no cabeçalho e os círculos na
      coluna lateral — precisa de um ancestral comum aos dois. */}
  <div class="palco" id="palco" data-previa="nao">
    <Nav atual="rfcs" />

    <header class="topo-ideia">
      <a class="volta" href={rota(lang, '/rfcs')}>{t(lang, 'rfcs.volta')}</a>
      <div class="chips">
        <span class="chip codigo">{codigoRfc(rfc.number, lang)}</span>
        {/* O chip é o mesmo objeto antes e depois do ato: o ponto vive
            sempre no markup e só aparece em "em discussão", pra troca de
            estado não precisar criar nem destruir nó. */}
        <span
          class:list={['chip', rfc.status === 'IN_DISCUSSION' && 'vivo']}
          id="chip-estado"
          data-estado={rfc.status}
        >
          <span class="ponto"></span><span class="rotulo-estado">{rotuloDoStatus(rfc.status, lang)}</span>
        </span>
        {estadoPrevisto && (
          <span class="virando" id="chip-virando" aria-hidden="true">
            <span class="seta">&rarr;</span>
            <span class="chip">{rotuloDoStatus(estadoPrevisto, lang)}</span>
          </span>
        )}
        <a class="chip" href={rota(lang, `/labs/${rfc.lab.slug}`)}>
          <span aria-hidden="true">{rfc.lab.glyph}</span> {nomeDoLab(rfc.lab, lang)}
        </a>
      </div>
      <h1 class="titulo-duplo grande">{rfc.title}</h1>
      <p class="resumo">{rfc.summary}</p>
      <RelacaoIdeia parte="origem" rfc={rfc} lang={lang} logado={!!usuario} />
    </header>

    {rascunhoMeu && (
      <p class="aviso-rascunho">
        <b>{t(lang, 'rfcs.det.rascunho.negrito')}</b>{t(lang, 'rfcs.det.rascunho.texto')}<a href={rota(lang, `/rfcs/${rfc.slug}/editar`)}>{t(lang, 'rfcs.det.rascunho.acao')}</a>
      </p>
    )}

    {projeto && (
      <aside class="virou-projeto" aria-labelledby="virou-projeto">
        <p class="chip" id="virou-projeto">{t(lang, 'ciclo.virou.rotulo')}</p>
        {projeto.resumo && <p class="virou-resumo">{projeto.resumo}</p>}
        <a class="botao" href={projeto.url} rel="nofollow ugc noopener" target="_blank">
          {t(lang, 'ciclo.virou.abrir')}<span class="so-leitor"> ({t(lang, 'ciclo.virou.externo')})</span>
        </a>
      </aside>
    )}

    {ocultaVisivel && (
      <p class="aviso-rascunho">
        <b>{t(lang, 'moderacao.estado.oculta.aviso')}</b>{t(lang, 'moderacao.estado.oculta.aviso.texto')}<a href={rota(lang, '/contestar')}>{t(lang, 'moderacao.estado.oculta.aviso.acao')}</a>
      </p>
    )}

    <figure class="capa-larga">
      <Materia
        tipo={m!.tipo}
        lab={rfc.lab.slug}
        semente={m!.semente}
        alt={t(lang, 'comum.materia.alt', { codigo: codigoRfc(rfc.number, lang) })}
      />
    </figure>

    <div class="leitura">
      <div class="coluna-corpo">
        <article class="corpo-rfc" set:html={corpoHtml}></article>
        {mostraAtualizacoes && (
          <AtualizacoesRfc
            estado={atualizacoes.tipo}
            itens={atualizacoes.tipo === 'ok' ? atualizacoes.itens : []}
            podePublicar={podePublicarAtualizacao}
            erro={erroAtualizacao}
            texto={textoAtualizacao}
          />
        )}
      </div>

      {/* ---------- discussão ---------- */}
      <section class="secao-discussao" aria-labelledby="titulo-discussao">
        <div class="cab-discussao" id="discussao">
          <h2 id="titulo-discussao">{t(lang, 'rfcs.det.discussao')}</h2>
          <p class="apoio">
            {t(lang, comentarios.meta.total === 1 ? 'rfcs.det.comentarios.um' : 'rfcs.det.comentarios.varios', { n: comentarios.meta.total })}
            {totalPaginas > 1 && t(lang, 'rfcs.det.pagina', { p: paginaAtual, n: totalPaginas })}
          </p>
        </div>

        <div class="discussao">
          {erroSolto && <p class="aviso-erro" role="alert">{erroSolto}</p>}

          {paginaAtual > 1 && (
            <p class="convite">
              <a href={`?p=${paginaAtual - 1}#discussao`}>{t(lang, 'rfcs.det.anteriores')}</a>
            </p>
          )}

          {comentarios.data.length > 0 ? comentarios.data.map((c) => {
            const meu = usuario != null && c.author.id === usuario.id && !c.isDeleted;
            const emEdicao = meu && editando === c.id;
            return (
              <div class:list={['comentario', c.isDeleted && 'removido']} id={`c-${c.id}`}>
                <div class="cabeca">
                  <span class="inicial" aria-hidden="true">
                    {iniciais(c.author.username)}
                  </span>
                  {autorSuspenso(c.author)
                    ? <span class="quando" title={t(lang, 'moderacao.estado.suspenso.rotulo')}>{t(lang, 'moderacao.estado.suspenso')}</span>
                    : <a href={rota(lang, `/users/${c.author.username}`)}>@{c.author.username}</a>}
                  <span class="quando">{haQuantoTempo(c.createdAt, lang)}</span>
                  {c.isEdited && <span class="quando">{t(lang, 'rfcs.det.editado')}</span>}
                  {!c.isDeleted && c.author.id !== usuario?.id && (
                    <BotaoReportar tipo="comentario" id={c.id} voltar={voltarComPagina()} />
                  )}
                </div>

                {emEdicao ? (
                  <form method="post">
                    <input type="hidden" name="acao" value="editar-comentario" />
                    <input type="hidden" name="comentario" value={c.id} />
                    {erroEdicao && (
                      <p class="aviso-erro" role="alert" id={`erro-edicao-${c.id}`}>{erroEdicao}</p>
                    )}
                    <div class:list={['campo', erroEdicao && 'com-erro']} style="margin-bottom:0">
                      <label class="rotulo" for={`edicao-${c.id}`}>{t(lang, 'rfcs.det.editar.rotulo')}</label>
                      <textarea
                        class="entrada"
                        id={`edicao-${c.id}`}
                        name="corpo"
                        required
                        maxlength="5000"
                        aria-describedby={erroEdicao ? `erro-edicao-${c.id}` : undefined}
                        aria-invalid={erroEdicao ? 'true' : undefined}
                      >{alvoEnviado === c.id && textoEdicaoFalha != null ? textoEdicaoFalha : c.body}</textarea>
                    </div>
                    <div class="acoes-edicao">
                      <button class="botao" type="submit">{t(lang, 'rfcs.det.salvar')}</button>
                      <a class="botao-secundario" href={`${voltar}${comPagina()}#c-${c.id}`}>{t(lang, 'rfcs.det.cancelar')}</a>
                    </div>
                  </form>
                ) : (
                  <div class="corpo-comentario" set:html={renderizarComentario(c.body, lang)}></div>
                )}

                {meu && !emEdicao && (
                  <div class="acoes-comentario">
                    <a href={`${comPagina(`editar=${c.id}`)}#c-${c.id}`}>{t(lang, 'rfcs.det.editar')}</a>
                    <form
                      method="post"
                      data-confirmar={t(lang, 'rfcs.det.remover.confirmar')}
                    >
                      <input type="hidden" name="acao" value="remover-comentario" />
                      <input type="hidden" name="comentario" value={c.id} />
                      <button type="submit">{t(lang, 'rfcs.det.remover')}</button>
                    </form>
                  </div>
                )}
              </div>
            );
          }) : (
            <Vazio
              falha={falhaComentarios}
              titulo={tituloDiscussaoVazia}
              texto={textoDiscussaoVazia}
              acaoHref={!falhaComentarios && !usuario ? paraEntrar : undefined}
              acaoTexto={!falhaComentarios && !usuario ? t(lang, 'rfcs.det.vazio.entrar') : undefined}
            />
          )}

          {paginaAtual < totalPaginas && (
            <p class="convite">
              <a href={`?p=${paginaAtual + 1}#discussao`}>{t(lang, 'rfcs.det.seguintes')}</a>
            </p>
          )}

          {!discussaoAberta ? (
            <p class="convite">
              {t(lang, 'rfcs.det.arquivada.convite')}
            </p>
          ) : usuario ? (
            /* O campo de escrever É o comentário: mesma classe, mesma
               cabeça, mesmo corpo, no fim da mesma lista. Enquanto está
               vazio ele é uma superfície rebaixada; ao receber texto,
               firma em cartão. Não há nó espelho copiando o que você
               digita — logo não há como o preview divergir do resultado,
               nem como texto de terceiro virar HTML. */
            <form
              class:list={['comentario', 'novo-comentario', 'nascendo', erroNovoComentario && 'com-erro']}
              id="comentario-nascendo"
              method="post"
              data-escrito="nao"
            >
              <input type="hidden" name="acao" value="comentar" />
              <div class="cabeca">
                <span class="inicial" aria-hidden="true">
                  {iniciais(usuario.username)}
                </span>
                <span class="quem">@{usuario.username}</span>
                {/* "hoje" é o que haQuantoTempo devolve pra um comentário
                    recém-publicado: a prévia diz a data que vai aparecer. */}
                <span class="quando">{t(lang, 'comum.tempo.hoje')}</span>
              </div>
              {erroNovoComentario && (
                <p class="aviso-erro" role="alert" id="erro-novo-comentario">{erroNovoComentario}</p>
              )}
              <label class="so-leitor" for="novo-comentario">{t(lang, 'rfcs.det.novo.rotulo')}</label>
              <textarea
                class="entrada corpo-nascendo"
                id="novo-comentario"
                name="corpo"
                rows="3"
                required
                maxlength="5000"
                placeholder={t(lang, 'rfcs.det.novo.placeholder')}
                aria-describedby={erroNovoComentario
                  ? 'erro-novo-comentario ajuda-novo-comentario'
                  : 'ajuda-novo-comentario'}
                aria-invalid={erroNovoComentario ? 'true' : undefined}
              >{textoNovoFalha ?? ''}</textarea>
              <div class="pe-nascendo">
                <span class="ajuda" id="ajuda-novo-comentario">
                  {t(lang, 'rfcs.det.novo.ajuda')} {t(lang, 'ideia.formato')}
                </span>
                <button class="botao" type="submit">{t(lang, 'rfcs.det.novo.acao')}</button>
              </div>
            </form>
          ) : comentarios.data.length > 0 && (
            <p class="convite">
              {t(lang, 'rfcs.det.anonimo.convite')}
              <a href={paraEntrar}>{t(lang, 'comum.nav.entrar')}</a>
            </p>
          )}
        </div>
      </section>

      {/* ---------- coluna lateral ---------- */}
      <aside class="lado-rfc">
        <div class="bloco">
          <p class="titulo-bloco">{t(lang, 'rfcs.det.lado.titulo')}</p>
          <p class="lado-resumo">
            {falhaInscricoes
              ? t(lang, 'rfcs.det.lado.falha')
              : ativos.length === 0
                ? t(lang, 'rfcs.det.lado.ninguem')
                : t(lang, ativos.length === 1 ? 'rfcs.det.lado.um' : 'rfcs.det.lado.varios', { n: ativos.length })}
          </p>

          {erroParticipacao && <p class="aviso-erro" role="alert">{erroParticipacao}</p>}

          {!aberta ? (
            <p class="nota-lado">
              {t(lang, rfc.status === 'DRAFT' ? 'rfcs.det.lado.rascunho' : 'rfcs.det.lado.arquivada')}
            </p>
          ) : !usuario ? (
            <a class="botao" href={paraEntrar}>{t(lang, 'rfcs.det.construir')}</a>
          ) : inscrito ? (
            <form method="post" data-guarda-estado>
              <input type="hidden" name="acao" value="sair-da-ideia" />
              <button class="botao-secundario" type="submit" data-previa-de="sair">{t(lang, 'rfcs.det.sair')}</button>
              <p class="nota-lado com-espaco">
                {t(lang, 'rfcs.det.sair.nota')}
              </p>
            </form>
          ) : (
            <form method="post" data-guarda-estado>
              <input type="hidden" name="acao" value="entrar-na-ideia" />
              <button class="botao" type="submit" data-previa-de="entrar">{t(lang, 'rfcs.det.construir')}</button>
              <p class="nota-lado com-espaco">
                {t(lang, 'rfcs.det.entrar.nota')}
              </p>
            </form>
          )}

          <RelacaoIdeia
            parte="acoes" rfc={rfc} lang={lang} logado={!!usuario}
            acompanhando={acompanhando} erroAcompanhar={erroAcompanhar}
          />
        </div>

        {(ativos.length > 0 || (podeEntrar && usuario)) && (
          <div class="bloco">
            <p class="titulo-bloco">{t(lang, 'rfcs.det.construindo')}</p>
            <div class="lista-pessoas">
              {ativos.map((i) => (
                <a
                  class:list={['pessoa', usuario?.id === i.user.id && 'sou-eu']}
                  href={rota(lang, `/users/${i.user.username}`)}
                >
                  <span class="inicial">
                    {iniciais(i.user.username)}
                  </span>
                  @{i.user.username}
                </a>
              ))}
              {/* A fila de quem constrói já mostra você no fim dela. Fica
                  esmaecida enquanto é hipótese e firma quando o botão é
                  apontado — no celular, onde não há hover, ela continua
                  sendo a explicação do que o botão faz. */}
              {podeEntrar && usuario && (
                <span class="pessoa fantasma">
                  <span class="inicial">
                    {iniciais(usuario.username)}
                  </span>
                  @{usuario.username}
                  <em class="nota">{t(lang, 'rfcs.det.voce.se.entrar')}</em>
                </span>
              )}
            </div>
          </div>
        )}

        {/* Só dado real: quem de fato saiu. Não há fantasma "você, se
            sair" aqui porque a API não devolve inscrição encerrada — e
            uma prévia que promete um bloco que nunca vai receber você
            ensina errado. A consequência que a tela pode mostrar de
            verdade é a de cima: seu círculo deixando a fila. */}
        {quemSaiu.length > 0 && (
          <div class="bloco">
            <p class="titulo-bloco">{t(lang, 'rfcs.det.passaram')}</p>
            <div class="lista-pessoas">
              {quemSaiu.map((i) => (
                <a class="pessoa" href={rota(lang, `/users/${i.user.username}`)}>
                  <span class="inicial">
                    {iniciais(i.user.username)}
                  </span>
                  @{i.user.username}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="bloco">
          <p class="titulo-bloco">{t(lang, 'rfcs.det.historico')}</p>
          <div class="linha"><span>{t(lang, 'rfcs.det.escrita.por')}</span>{autorSuspenso(rfc.author) ? <b>{t(lang, 'moderacao.estado.suspenso')}</b> : <a href={rota(lang, `/users/${rfc.author.username}`)}><b>@{rfc.author.username}</b></a>}</div>
          {rfc.publishedAt && (
            <div class="linha"><span>{t(lang, 'rfcs.det.publicada')}</span><b>{haQuantoTempo(rfc.publishedAt, lang)}</b></div>
          )}
          <div class="linha"><span>{t(lang, 'rfcs.det.ultima.mudanca')}</span><b>{haQuantoTempo(rfc.updatedAt, lang)}</b></div>
          <div class="linha"><span>{t(lang, 'rfcs.det.versoes')}</span>{versoes.length > 1 ? <a class="link-versoes" href={rota(lang, `/rfcs/${rfc.slug}/versoes`)}><b>{versoes.length}</b></a> : <b>{versoes.length || 1}</b>}</div>
          {versoes.length > 1 && (
            <p class="nota-lado com-espaco">
              {t(lang, 'rfcs.det.versoes.nota')}
            </p>
          )}
          {rfc.author.id !== usuario?.id && <BotaoReportar tipo="rfc" id={rfc.id} voltar={voltarComPagina()} />}
        </div>

        {tags.length > 0 && (
          <div class="bloco">
            <p class="titulo-bloco">{t(lang, 'rfcs.det.tags')}</p>
            <div class="nuvem-tags">
              {tags.map((tg) => <a class="tag" href={rota(lang, `/rfcs?tag=${tg.slug}`)}>{tg.name}</a>)}
            </div>
          </div>
        )}
      </aside>
    </div>

    <Rodape />
  </div>
</Layout>
) : (
<Layout title={`Idearium · ${t(lang, semRede ? 'rfcs.det.falha.titulo' : 'rfcs.det.inexistente.titulo')}`}>
  <div class="palco">
    <Nav atual="rfcs" />

    <header class="topo-ideia">
      <a class="volta" href={rota(lang, '/rfcs')}>{t(lang, 'rfcs.volta')}</a>
    </header>

    {oculta ? (
      <Vazio
        titulo={t(lang, 'moderacao.estado.oculta.titulo')}
        texto={t(lang, 'moderacao.estado.oculta.texto')}
        acaoHref={rota(lang, '/rfcs')}
        acaoTexto={t(lang, 'moderacao.estado.oculta.acao')}
      />
    ) : (
      <Vazio
        falha={semRede}
        titulo={t(lang, semRede ? 'rfcs.det.falha.titulo' : 'rfcs.det.inexistente.titulo')}
        texto={t(lang, semRede ? 'rfcs.det.falha.texto' : 'rfcs.det.inexistente.texto')}
        acaoHref={semRede ? undefined : rota(lang, '/rfcs')}
        acaoTexto={semRede ? undefined : t(lang, 'rfcs.det.inexistente.acao')}
      />
    )}

    <Rodape />
  </div>
</Layout>
)}

<style>
  /* ---------- cabeçalho e capa ---------- */
  .topo-ideia { padding: 64px 8px 32px; display: grid; justify-items: start; }
  .topo-ideia .volta {
    font-size: 13.5px; color: var(--t-65); text-decoration: none;
    display: inline-flex; align-items: center; min-height: 40px;
    transition: color var(--dur) var(--ease);
  }
  .topo-ideia .volta:hover { color: var(--t-100); }
  .topo-ideia .chips { margin: 24px 0 28px; }
  .topo-ideia .titulo-duplo { max-width: 22ch; }
  .topo-ideia .resumo {
    margin: 24px 0 0; max-width: 56ch;
    font-size: 17px; line-height: 1.5; color: var(--t-65);
  }
  .topo-ideia a.chip { text-decoration: none; transition: background var(--dur) var(--ease); }
  .topo-ideia a.chip:hover { background: var(--t-12); }
  @media (max-width: 520px) { .topo-ideia { padding: 40px 4px 24px; } }

  .capa-larga {
    position: relative; margin: 0 8px 56px;
    height: clamp(240px, 38vw, 440px);
    border-radius: var(--r-fora); overflow: hidden;
  }
  .capa-larga canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 520px) { .capa-larga { margin: 0 4px 40px; } }

  /* chip de estado: o ponto só aparece em "em discussão" */
  #chip-estado .ponto { display: none; }
  #chip-estado.vivo .ponto { display: block; }

  /* aviso de rascunho: superfície rebaixada, sem cor de alarme */
  .aviso-rascunho {
    background: var(--rebaixo);
    border-radius: var(--r-dentro);
    padding: 14px 18px;
    margin: 0 8px 32px;
    font-size: 13.5px;
    color: var(--t-65);
  }
  .aviso-rascunho b { font-weight: 500; color: var(--t-100); }
  .aviso-rascunho a { color: var(--t-100); margin-left: 6px; }

  /* ---------- a leitura: coluna de texto + lateral ---------- */
  .leitura {
    display: grid;
    grid-template-columns: minmax(0, 68ch) 300px;
    grid-template-areas: "corpo lado" "discussao lado";
    justify-content: space-between;
    column-gap: 56px;
    row-gap: 80px;
    padding: 0 8px 96px;
    align-items: start;
  }
  .leitura .coluna-corpo { grid-area: corpo; min-width: 0; display: grid; gap: 64px; }
  .virou-projeto {
    display: grid; gap: 12px; justify-items: start;
    background: var(--rebaixo); border-radius: var(--r-dentro);
    padding: 18px 20px; margin: 0 8px 32px;
  }
  .virou-projeto .virou-resumo { margin: 0; font-size: 15px; color: var(--t-75); }
  .leitura .corpo-rfc { grid-area: corpo; padding: 0; font-size: 16.5px; line-height: 1.7; min-width: 0; }
  .leitura .secao-discussao { grid-area: discussao; min-width: 0; }
  .leitura .lado-rfc { grid-area: lado; top: 24px; }
  @media (max-width: 980px) {
    .leitura {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "corpo" "lado" "discussao";
      row-gap: 56px;
    }
    .leitura .lado-rfc { position: static; }
  }
  @media (max-width: 520px) { .leitura { padding: 0 4px 64px; } }

  /* ---------- lateral ---------- */
  .lado-resumo { margin: 0 0 18px; font-size: 14px; line-height: 1.45; color: var(--t-75); }
  .nota-lado { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--t-65); }
  .nota-lado.com-espaco { margin-top: 12px; }
  .lado-rfc form { display: block; }
  .lado-rfc .botao,
  .lado-rfc .botao-secundario { width: 100%; height: 44px; }
  .lado-rfc .linha a { color: var(--t-100); text-decoration: none; }
  .lado-rfc .linha a:hover { text-decoration: underline; }
  .lado-rfc .linha a.link-versoes { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--t-35); }
  .pessoa { min-height: 32px; }

  /* o chip prestes a virar: vazado, sem competir com o estado atual */
  .virando { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; opacity: 0.6; transition: opacity var(--dur) var(--ease); }
  .palco[data-previa="entrar"] .virando,
  .palco[data-previa="sair"] .virando { opacity: 1; }
  .virando .seta { font-size: 12px; color: var(--t-50); }
  .virando .chip { background: transparent; box-shadow: inset 0 0 0 1px var(--t-12); color: var(--t-65); }

  /* você, se entrar: esmaecido até apontar o botão. Só opacidade. */
  .pessoa.fantasma { opacity: 0.55; flex-wrap: wrap; transition: opacity var(--dur) var(--ease); }
  .pessoa.fantasma .inicial { box-shadow: inset 0 0 0 1.5px var(--t-35); }
  .pessoa.fantasma .nota { margin-left: auto; font-size: 11.5px; font-style: normal; color: var(--t-65); white-space: nowrap; }
  .palco[data-previa="entrar"] .pessoa.fantasma { opacity: 1; }
  .pessoa.sou-eu { transition: opacity var(--dur) var(--ease); }
  .palco[data-previa="sair"] .pessoa.sou-eu { opacity: 0.35; }

  /* ---------- discussão ---------- */
  .cab-discussao { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
  .cab-discussao h2 { margin: 0; font-size: 28px; font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; color: var(--t-100); }
  .cab-discussao .apoio { font-variant-numeric: tabular-nums; }
  .discussao { margin-top: 0; }

  /* comentário: linha sobre fundo branco, separada por fio, sem cartão */
  .comentario {
    background: none; box-shadow: none; border-radius: 0;
    padding: 24px 0; margin: 0;
    border-top: 1px solid var(--t-12);
  }
  .comentario .cabeca { margin-bottom: 10px; }
  .comentario .cabeca .inicial {
    width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center;
    font-size: 10px; font-weight: 600; color: var(--t-100);
    background: var(--color-chip); flex-shrink: 0;
  }
  .comentario.removido .cabeca .inicial { opacity: 0.5; }
  .comentario p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--t-75); white-space: pre-wrap; overflow-wrap: anywhere; }
  .comentario .acoes-comentario { gap: 4px; margin-top: 4px; align-items: center; }
  .comentario .acoes-comentario a,
  .comentario .acoes-comentario button {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px 0 0;
    font-size: 13px; color: var(--t-65);
    text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--t-35);
  }
  .comentario .acoes-comentario a:hover,
  .comentario .acoes-comentario button:hover { color: var(--t-100); }
  .acoes-edicao { display: flex; gap: 8px; align-items: center; margin-top: 14px; flex-wrap: wrap; }
  .acoes-edicao .botao,
  .acoes-edicao .botao-secundario { height: 40px; }

  .convite { margin: 0; padding: 16px 0 0; font-size: 13.5px; color: var(--t-65); }
  .convite a { color: var(--t-100); margin-left: 6px; }

  /* o campo de escrever é um comentário um passo antes de existir:
     superfície rebaixada, firma em branco com anel quando recebe foco */
  .comentario.nascendo {
    background: var(--rebaixo);
    border: 0; border-radius: 20px;
    padding: 20px 22px;
    margin-top: 24px;
    transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .nascendo:focus-within,
  .nascendo[data-escrito="sim"] { background: var(--cartao); box-shadow: 0 0 0 1px var(--t-12); }
  .nascendo:focus-within { box-shadow: 0 0 0 2px var(--tinta); }
  .nascendo.com-erro { box-shadow: 0 0 0 2px var(--tinta); }
  .nascendo .quem { color: var(--t-100); font-weight: 500; }

  .nascendo textarea.corpo-nascendo {
    background: transparent; border: 0; border-radius: 0;
    padding: 0; min-height: 0;
    font-size: 15px; line-height: 1.6; color: var(--t-75);
    resize: none;
  }
  .nascendo textarea.corpo-nascendo:hover,
  .nascendo textarea.corpo-nascendo:focus { background: transparent; border-color: transparent; outline: none; }

  .pe-nascendo {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--t-12);
  }
  .pe-nascendo .ajuda { flex: 1; min-width: 190px; font-size: 12.5px; color: var(--t-65); }
  .pe-nascendo .botao { height: 40px; }

  /* o rótulo do campo existe pra leitor de tela; a cabeça do comentário
     nomeia o campo na tela */
  .so-leitor {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%);
    white-space: nowrap; border: 0;
  }

  .tag { min-height: 32px; }
</style>

<script>
  /* Remover comentário não tem desfazer. Sem JS o formulário envia
     direto — a confirmação é melhoria, não requisito. */
  function ligarConfirmacao() {
    document.querySelectorAll<HTMLFormElement>('form[data-confirmar]').forEach((f) => {
      f.addEventListener('submit', (e) => {
        if (!confirm(f.dataset.confirmar!)) e.preventDefault();
      });
    });
  }

  /* ---------- a prévia do ato ----------
     Apontar o botão liga o estado no palco; o CSS faz o resto. Só
     vitrine: nada aqui envia, grava ou decide. */
  function ligarPrevia() {
    const palco = document.getElementById('palco');
    if (!palco) return;
    for (const botao of document.querySelectorAll<HTMLElement>('[data-previa-de]')) {
      const qual = botao.dataset.previaDe!;
      const liga = () => { palco.dataset.previa = qual; };
      const desliga = () => { palco.dataset.previa = 'nao'; };
      botao.addEventListener('mouseenter', liga);
      botao.addEventListener('focus', liga);
      botao.addEventListener('mouseleave', desliga);
      botao.addEventListener('blur', desliga);
    }
  }

  /* ---------- o chip virando de verdade ----------
     Entrar e sair recarregam a página, então a troca de estado já vem
     pronta do servidor e ninguém veria acontecer. O clique anota qual
     era o estado; na volta, o chip começa no estado antigo e faz o
     swap de três fases — o mesmo do átrio, agora com dado real.

     sessionStorage e não querystring: a lógica de POST e o redirect
     ficam intocados, e sem JS a página segue funcionando igual. */
  const CHAVE_ESTADO = 'idearium:estado-antes';

  function ligarLembrete() {
    const chip = document.getElementById('chip-estado');
    const rotulo = chip?.querySelector<HTMLElement>('.rotulo-estado');
    if (!chip || !rotulo) return;

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-guarda-estado]')) {
      form.addEventListener('submit', () => {
        try {
          sessionStorage.setItem(CHAVE_ESTADO, JSON.stringify({
            caminho: location.pathname,
            estado: chip.dataset.estado,
            rotulo: rotulo.textContent,
          }));
        } catch {
          /* storage bloqueado: perde-se a animação, não o ato */
        }
      });
    }
  }

  function ligarSwapDeEstado() {
    const chip = document.getElementById('chip-estado');
    const rotulo = chip?.querySelector<HTMLElement>('.rotulo-estado');
    if (!chip || !rotulo) return;

    let bruto: string | null = null;
    try {
      bruto = sessionStorage.getItem(CHAVE_ESTADO);
      sessionStorage.removeItem(CHAVE_ESTADO);
    } catch {
      return;
    }
    if (!bruto) return;

    let antes: { caminho?: string; estado?: string; rotulo?: string };
    try {
      antes = JSON.parse(bruto);
    } catch {
      return;
    }

    /* outra ideia, ou estado que não mudou: não há troca pra mostrar */
    if (antes.caminho !== location.pathname) return;
    if (!antes.estado || antes.estado === chip.dataset.estado) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const depois = rotulo.textContent ?? '';
    const vivoDepois = chip.classList.contains('vivo');

    rotulo.textContent = antes.rotulo ?? depois;
    chip.classList.toggle('vivo', antes.estado === 'IN_DISCUSSION');

    const dur = parseInt(getComputedStyle(rotulo).getPropertyValue('--swap-dur')) || 150;

    /* meio segundo parado antes: sem essa pausa a troca acontece junto
       com a entrada da página e não se lê como consequência do clique */
    setTimeout(() => {
      rotulo.classList.add('saindo');
      setTimeout(() => {
        rotulo.textContent = depois;
        chip.classList.toggle('vivo', vivoDepois);
        rotulo.classList.remove('saindo');
        rotulo.classList.add('entrando-de-baixo');
        void rotulo.offsetWidth;              // reflow: sem isso o salto anima
        rotulo.classList.remove('entrando-de-baixo');
      }, dur);
    }, 520);
  }

  /* ---------- o comentário tomando forma ----------
     A caixa firma quando recebe texto e cresce com ele, pra a altura
     ser a do comentário que vai entrar na thread. O texto nunca é
     copiado pra outro nó: quem mostra é o próprio campo. */
  function ligarComentarioNascendo() {
    const form = document.getElementById('comentario-nascendo');
    const campo = document.getElementById('novo-comentario') as HTMLTextAreaElement | null;
    if (!form || !campo) return;

    const acompanhar = () => {
      form.dataset.escrito = campo.value.trim() ? 'sim' : 'nao';
      campo.style.height = 'auto';
      campo.style.height = campo.scrollHeight + 'px';
    };

    campo.addEventListener('input', acompanhar);
    acompanhar();               // envio que falhou volta com texto dentro
  }

  document.addEventListener('astro:page-load', () => {
    ligarConfirmacao();
    ligarPrevia();
    ligarLembrete();
    ligarSwapDeEstado();
    ligarComentarioNascendo();
  });
</script>
