---
/* ================================================================
   /rfcs/nova — escrever uma ideia (F4)
   ================================================================
   Tela de autoria. Exige sessão e é SSR: o formulário faz POST pra
   ela mesma, sem nenhum fetch no cliente e sem token no browser.

   A decisão central desta tela é de produto, não de código: salvar
   NÃO publica. O VISAO §6 separa rascunho de publicação porque o
   número da RFC é permanente — e um número permanente não pode
   nascer de um clique acidental. Por isso a tela repete isso duas
   vezes: na nota da prévia e na nota abaixo do botão.

   Desenho: coluna de escrita calma (título, resumo, laboratório, tags,
   corpo) e, ao lado, só duas coisas: o cartão que a ideia vai virar e
   a ajuda curta de markdown. O cartão é o CartaoIdeia de verdade, com a
   Materia de verdade, e o chip fica travado em `rascunho`, porque
   criar não publica. Ver o objeto nascendo ensina o formato sem uma
   linha de texto a mais, que é o problema pedagógico do produto
   (VISAO §7).
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import Vazio from '../../components/astro/Vazio.astro';
/* O mesmo componente do átrio, da listagem e da tela de edição, sem
   adaptação: a prévia precisa ser o objeto que vai existir. */
import CartaoIdeia from '../../components/astro/CartaoIdeia.astro';
import EditorCorpo from '../../components/astro/EditorCorpo.astro';
import { listarLabs, apiIndisponivel, nomeDoLab, type Rfc } from '../../lib/api';
import { idiomaDe, rota, t } from '../../lib/i18n';
import { comSessao } from '../../lib/sessao';

const lang = idiomaDe(Astro);
const loc = lang === 'en' ? 'en' : 'pt-BR';
const usuario = Astro.locals.usuario;
/* Sem sessão, entrar e voltar pra cá, no mesmo idioma. O ?voltar= leva o
   caminho já com o prefixo (exigirSessao não sabe do idioma). */
if (!usuario) {
  return Astro.redirect(`${rota(lang, '/entrar')}?voltar=${encodeURIComponent(rota(lang, '/rfcs/nova'))}`);
}

/* Os mesmos números do CreateRfcDto da API, repetidos aqui de
   propósito: a pessoa precisa saber o limite antes de escrever, não
   depois de o servidor recusar o texto pronto. */
const LIMITE = {
  titulo:  { min: 5,  max: 200 },
  resumo:  { min: 5,  max: 280 },
  corpo:   { min: 50, max: 50_000 },
  tag:     { min: 2,  max: 40 },
  tags:    { max: 10 },
};

/* Espelha o slugify() da API. É o slug, e não o texto digitado, que
   identifica a tag lá dentro: sem repetir a regra aqui, "C#" viraria
   "c", a API descartaria a tag no meio de um 200 e a pessoa seria
   redirecionada sem saber que perdeu tag. */
function slugDaTag(bruto: string) {
  return bruto
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

/** Aceita "praça, mobilidade , praça" e devolve ["praça","mobilidade"],
 *  separando o que a API engoliria em silêncio. */
function separarTags(bruto: string) {
  const porSlug = new Map<string, string>();
  const tags: string[] = [];
  const semLetras: string[] = [];
  const repetidas: string[] = [];

  for (const parte of bruto.split(',')) {
    const item = parte.trim();
    if (!item) continue;
    const slug = slugDaTag(item);
    if (slug.length < LIMITE.tag.min) { semLetras.push(item); continue; }
    const anterior = porSlug.get(slug);
    if (anterior) { repetidas.push(t(lang, 'rfcs.erro.tags.par', { a: item, b: anterior })); continue; }
    porSlug.set(slug, item);
    tags.push(item);
  }
  return { tags, semLetras, repetidas };
}

interface Campos { title: string; summary: string; body: string; labId: string; tags: string }

/* Validar aqui, e não só no servidor da API, é o que devolve o erro
   grudado no campo certo. A API responde uma lista de mensagens sem
   dizer a qual campo cada uma pertence. */
function validar(v: Campos, tags: ReturnType<typeof separarTags>) {
  const e: Record<string, string> = {};

  if (v.title.length < LIMITE.titulo.min) e.title = t(lang, 'rfcs.erro.titulo.min', { min: LIMITE.titulo.min });
  else if (v.title.length > LIMITE.titulo.max) e.title = t(lang, 'rfcs.erro.titulo.max', { max: LIMITE.titulo.max });

  if (v.summary.length < LIMITE.resumo.min) e.summary = t(lang, 'rfcs.erro.resumo.min', { min: LIMITE.resumo.min });
  else if (v.summary.length > LIMITE.resumo.max) e.summary = t(lang, 'rfcs.erro.resumo.max', { max: LIMITE.resumo.max });

  if (v.body.length < LIMITE.corpo.min) e.body = t(lang, 'rfcs.nova.erro.corpo.min', { min: LIMITE.corpo.min });
  else if (v.body.length > LIMITE.corpo.max) e.body = t(lang, 'rfcs.erro.corpo.max', { max: LIMITE.corpo.max });

  if (!v.labId) e.labId = t(lang, 'rfcs.nova.erro.lab');

  if (tags.tags.length > LIMITE.tags.max) e.tags = t(lang, 'rfcs.erro.tags.max', { max: LIMITE.tags.max });
  else if (tags.tags.some((tag) => tag.length < LIMITE.tag.min || tag.length > LIMITE.tag.max))
    e.tags = t(lang, 'rfcs.erro.tags.tamanho', { min: LIMITE.tag.min, max: LIMITE.tag.max });
  else if (tags.semLetras.length)
    e.tags = t(lang, 'rfcs.erro.tags.semletras', { lista: tags.semLetras.join(', '), min: LIMITE.tag.min });
  else if (tags.repetidas.length)
    e.tags = t(lang, 'rfcs.erro.tags.repetidas', { lista: tags.repetidas.join('; ') });

  return e;
}

const labs = await listarLabs();
const semLabs = labs.length === 0;
/* lido aqui, logo após a busca: vale só pra esta requisição */
const semRede = apiIndisponivel();

let valores: Campos = { title: '', summary: '', body: '', labId: '', tags: '' };
let erros: Record<string, string> = {};
let avisoGeral = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  valores = {
    title:   String(f.get('title') ?? '').trim(),
    summary: String(f.get('summary') ?? '').trim(),
    body:    String(f.get('body') ?? '').trim(),
    labId:   String(f.get('labId') ?? ''),
    tags:    String(f.get('tags') ?? ''),
  };

  const tags = separarTags(valores.tags);
  erros = validar(valores, tags);

  if (Object.keys(erros).length === 0) {
    const r = await comSessao<Rfc>(Astro.cookies, 'POST', '/rfcs', {
      title: valores.title,
      summary: valores.summary,
      body: valores.body,
      labId: valores.labId,
    });

    if (r.ok && r.dado) {
      /* As tags são uma segunda chamada: a API define o conjunto
         inteiro num endpoint separado. Se ela falhar, o rascunho já
         existe — então segue pra edição avisando o que faltou, em vez
         de perder o texto ou fingir que deu tudo certo. */
      let tagsOk = true;
      if (tags.tags.length > 0) {
        const rt = await comSessao(Astro.cookies, 'POST', `/rfcs/${r.dado.id}/tags`, { tags: tags.tags });
        tagsOk = rt.ok;
      }
      return Astro.redirect(rota(lang, `/rfcs/${r.dado.slug}/editar?criada=1${tagsOk ? '' : '&tags=falhou'}`));
    }

    avisoGeral = r.erro ?? t(lang, 'rfcs.nova.erro.salvar');
  }
}

const descreve = (campo: string) =>
  [`ajuda-${campo}`, erros[campo] && `erro-${campo}`].filter(Boolean).join(' ');

/* ================================================================
   O cartão que está sendo fabricado
   ================================================================
   É o CartaoIdeia de verdade, com `comoLink={false}` porque a RFC
   ainda não tem endereço. Prévia que reimplementa o cartão diverge
   dele na primeira mudança do componente — e aqui a divergência
   apareceria em segundos: salvar redireciona pra tela de edição, que
   mostra o mesmo objeto pelo mesmo componente.

   O que alimenta o componente é o rascunho como ele vai voltar da
   API, montado com o que já se sabe: sem número (então o código sai
   'rascunho' pela codigoRfc, igual à tela seguinte), em DRAFT, e com
   a versão 1 que o POST cria junto — daí o `v0.1` no pé.
   ================================================================ */
const VAZIO = {
  titulo: t(lang, 'rfcs.nova.previa.titulo'),
  resumo: t(lang, 'rfcs.nova.previa.resumo'),
  lab:    t(lang, 'rfcs.nova.previa.lab'),
};

const labEscolhido = labs.find((l) => l.id === valores.labId) ?? null;

/* A capa é desenhada a partir do id e do número da RFC, e nenhum dos
   dois existe antes de salvar. Uma identidade provisória sorteada uma
   vez deixa o desenho parado enquanto se escreve: fazê-lo reagir ao
   título ensinaria uma causalidade que o sistema não tem. */
const idProvisorio = Math.random().toString(36).slice(2);

const agora = new Date().toISOString();
const rascunhoProvisorio = {
  id: idProvisorio,
  number: null,
  slug: '',
  title: valores.title.trim() || VAZIO.titulo,
  summary: valores.summary.trim() || VAZIO.resumo,
  locale: 'pt-BR',
  status: 'DRAFT' as const,
  publishedAt: null,
  createdAt: agora,
  updatedAt: agora,
  author: { id: '', username: usuario!.username, fullName: null, avatarUrl: null },
  _count: { versions: 1 },
  lab: labEscolhido
    ? { id: labEscolhido.id, slug: labEscolhido.slug, name: labEscolhido.name, glyph: labEscolhido.glyph }
    : { id: '', slug: '', name: VAZIO.lab, glyph: '' },
};

/* O que passa de 280 continua visível e riscado, mas o riscado aqui
   não quer dizer "cortado do cartão": passar do limite impede o
   salvamento, então nenhum cartão truncado chega a existir. É o que a
   medida abaixo do cartão diz com todas as letras. */
const resumoPrevia = valores.summary.trim();
const resumoSobra = resumoPrevia.slice(LIMITE.resumo.max);

/* Textos que o script monta no cliente: chegam prontos, com o marcador
   no lugar do número, e o script só troca o marcador. */
const medidaOk = t(lang, 'rfcs.nova.medida.ok', { atual: '{atual}', max: LIMITE.resumo.max });
const medidaFora = t(lang, 'rfcs.nova.medida.fora', { atual: '{atual}', max: LIMITE.resumo.max, sobra: '{sobra}' });
const textoMin = t(lang, 'rfcs.contador.min', { n: '{n}', min: '{min}' });
---

<Layout
  title={t(lang, 'rfcs.nova.titulo')}
  description={t(lang, 'rfcs.nova.descricao')}
>
  <div class="palco">
    <Nav atual="rfcs" />

    <header class="cabecalho-escrita">
      <a class="volta" href={rota(lang, '/rfcs')}>{t(lang, 'rfcs.volta')}</a>
      <h1 class="titulo-duplo">{t(lang, 'rfcs.nova.h1.antes')}<span class="apagado">{t(lang, 'rfcs.nova.h1.serif')}{t(lang, 'rfcs.nova.h1.depois')}</span></h1>
      <p class="apoio">{t(lang, 'rfcs.nova.sub')}</p>
    </header>

    {semLabs ? (
      <Vazio
        falha={semRede}
        titulo={semRede ? t(lang, 'comum.vazio.falha.titulo') : t(lang, 'rfcs.nova.semlabs.titulo')}
        texto={semRede ? t(lang, 'rfcs.nova.semlabs.falha') : t(lang, 'rfcs.nova.semlabs.texto')}
        acaoHref={rota(lang, '/rfcs')}
        acaoTexto={t(lang, 'rfcs.nova.semlabs.acao')}
      />
    ) : (
      <form class="escrita" method="post" novalidate>
        {avisoGeral && (
          <p class="aviso-erro aviso-topo" role="alert">
            <b>{t(lang, 'rfcs.nova.erro.salvar.negrito')}</b> {avisoGeral}
          </p>
        )}
        {Object.keys(erros).length > 0 && (
          <p class="aviso-erro aviso-topo" role="alert">
            <b>{t(lang, 'rfcs.form.falta.negrito')}</b>{t(lang, 'rfcs.form.falta.texto')}
          </p>
        )}

        <div class="escrita-grade">
          <div class="coluna-escrita">

            <div class:list={['campo', erros.title && 'com-erro']}>
              <div class="linha-rotulo">
                <label class="rotulo" for="title">{t(lang, 'rfcs.form.titulo')}</label>
                <span class="mono contador" aria-hidden="true" data-contador="title" data-texto-min={textoMin} data-min={LIMITE.titulo.min} data-max={LIMITE.titulo.max}></span>
              </div>
              <input
                class="entrada"
                id="title"
                name="title"
                type="text"
                value={valores.title}
                aria-describedby={descreve('title')}
                aria-invalid={erros.title ? 'true' : undefined}
                placeholder={t(lang, 'rfcs.nova.titulo.placeholder')}
              />
              <span class="ajuda" id="ajuda-title">
                {t(lang, 'rfcs.form.faixa', { min: LIMITE.titulo.min, max: LIMITE.titulo.max })}{t(lang, 'rfcs.nova.titulo.ajuda')}
              </span>
              {erros.title && <span class="erro-campo" id="erro-title">{erros.title}</span>}
            </div>

            <div class:list={['campo', erros.summary && 'com-erro']}>
              <div class="linha-rotulo">
                <label class="rotulo" for="summary">{t(lang, 'rfcs.form.resumo')}</label>
                <span class="mono contador" aria-hidden="true" data-contador="summary" data-texto-min={textoMin} data-min={LIMITE.resumo.min} data-max={LIMITE.resumo.max}></span>
              </div>
              <textarea
                class="entrada"
                id="summary"
                name="summary"
                rows="3"
                aria-describedby={descreve('summary')}
                aria-invalid={erros.summary ? 'true' : undefined}
                placeholder={t(lang, 'rfcs.nova.resumo.placeholder')}
              >{valores.summary}</textarea>
              <span class="ajuda" id="ajuda-summary">
                {t(lang, 'rfcs.form.faixa', { min: LIMITE.resumo.min, max: LIMITE.resumo.max })}{t(lang, 'rfcs.nova.resumo.ajuda')}
              </span>
              {erros.summary && <span class="erro-campo" id="erro-summary">{erros.summary}</span>}
            </div>

            <div class:list={['campo', erros.labId && 'com-erro']}>
              <label class="rotulo" for="labId">{t(lang, 'rfcs.nova.lab.rotulo')}</label>
              <select
                class="entrada"
                id="labId"
                name="labId"
                aria-describedby={descreve('labId')}
                aria-invalid={erros.labId ? 'true' : undefined}
              >
                <option value="">{t(lang, 'rfcs.nova.lab.escolha')}</option>
                {/* slug e nome curto viajam no <option> porque é o
                    cartão ao lado que precisa deles: o value é o id,
                    e id não pinta capa nem escreve chip */}
                {labs.map((l) => (
                  <option
                    value={l.id}
                    selected={valores.labId === l.id}
                    data-slug={l.slug}
                    data-nome={nomeDoLab(l, lang)}
                  >
                    {l.glyph} {nomeDoLab(l, lang)}
                  </option>
                ))}
              </select>
              <span class="ajuda" id="ajuda-labId">
                {t(lang, 'rfcs.nova.lab.ajuda')}
              </span>
              {erros.labId && <span class="erro-campo" id="erro-labId">{erros.labId}</span>}
            </div>

            <div class:list={['campo', erros.tags && 'com-erro']}>
              <label class="rotulo" for="tags">{t(lang, 'rfcs.form.tags')}</label>
              <input
                class="entrada"
                id="tags"
                name="tags"
                type="text"
                value={valores.tags}
                aria-describedby={descreve('tags')}
                aria-invalid={erros.tags ? 'true' : undefined}
                placeholder={t(lang, 'rfcs.nova.tags.placeholder')}
              />
              <span class="ajuda" id="ajuda-tags">
                {t(lang, 'rfcs.nova.tags.ajuda', { max: LIMITE.tags.max, min: LIMITE.tag.min, tam: LIMITE.tag.max })}
              </span>
              {erros.tags && <span class="erro-campo" id="erro-tags">{erros.tags}</span>}
            </div>

            <div class:list={['campo', erros.body && 'com-erro']}>
              <div class="linha-rotulo">
                <label class="rotulo" for="body">{t(lang, 'rfcs.form.corpo')}</label>
                <span class="mono contador" aria-hidden="true" data-contador="body" data-texto-min={textoMin} data-min={LIMITE.corpo.min} data-max={LIMITE.corpo.max}></span>
              </div>
              <EditorCorpo campo="body">
                <textarea
                  class="entrada corpo-longo"
                  id="body"
                  name="body"
                  aria-describedby={descreve('body')}
                  aria-invalid={erros.body ? 'true' : undefined}
                  placeholder={t(lang, 'rfcs.nova.corpo.placeholder')}
                >{valores.body}</textarea>
              </EditorCorpo>
              <span class="ajuda" id="ajuda-body">
                {t(lang, 'rfcs.nova.corpo.ajuda', { min: LIMITE.corpo.min, max: LIMITE.corpo.max.toLocaleString(loc) })}
              </span>
              {erros.body && <span class="erro-campo" id="erro-body">{erros.body}</span>}
            </div>

            <div class="rodape-form">
              <button class="botao" type="submit">{t(lang, 'rfcs.nova.salvar')}</button>
              <a class="botao-secundario" href={rota(lang, '/rfcs')}>{t(lang, 'rfcs.nova.descartar')}</a>
            </div>
            <p class="apoio">{t(lang, 'rfcs.nova.bloco.nota')}</p>
          </div>

          <aside class="lado-escrita">
            {/* O estado da prévia mora no invólucro, e não dentro do
                cartão: os nós de lá são do CartaoIdeia e esta tela não
                os cria, só os reescreve. */}
            <section
              class="previa-nova"
              data-titulo={valores.title.trim() ? 'cheio' : 'vazio'}
              data-resumo={resumoPrevia ? 'cheio' : 'vazio'}
              data-cabe={resumoSobra ? 'nao' : 'sim'}
              data-vazio-titulo={VAZIO.titulo}
              data-vazio-resumo={VAZIO.resumo}
              data-vazio-lab={VAZIO.lab}
              data-max={LIMITE.resumo.max}
              data-medida-ok={medidaOk}
              data-medida-fora={medidaFora}
            >
              <h2 class="rotulo-previa">{t(lang, 'rfcs.nova.previa.rotulo')}</h2>

              <CartaoIdeia rfc={rascunhoProvisorio} comoLink={false} />

              <p
                class:list={['medida', resumoSobra && 'fora']}
                id="previa-medida"
                aria-hidden="true"
              >{resumoSobra
                ? t(lang, 'rfcs.nova.medida.fora', { atual: resumoPrevia.length, max: LIMITE.resumo.max, sobra: resumoSobra.length })
                : t(lang, 'rfcs.nova.medida.ok', { atual: resumoPrevia.length, max: LIMITE.resumo.max })}</p>

              <p class="nota-previa">
                {t(lang, 'rfcs.nova.previa.nota.antes')}<b>{t(lang, 'rfcs.nova.previa.nota.negrito')}</b>{t(lang, 'rfcs.nova.previa.nota.depois')}
              </p>
            </section>

            <section class="ajuda-md">
              <h2 class="rotulo-previa">{t(lang, 'rfcs.nova.md.titulo')}</h2>
              <dl>
                <div><dt class="codigo">## título</dt><dd>{t(lang, 'rfcs.nova.md.secao')}</dd></div>
                <div><dt class="codigo">**texto**</dt><dd>{t(lang, 'rfcs.nova.md.negrito')}</dd></div>
                <div><dt class="codigo">*texto*</dt><dd>{t(lang, 'rfcs.nova.md.italico')}</dd></div>
                <div><dt class="codigo">[texto](https://…)</dt><dd>{t(lang, 'rfcs.nova.md.link')}</dd></div>
                <div><dt class="codigo">- item</dt><dd>{t(lang, 'rfcs.nova.md.lista')}</dd></div>
                <div><dt class="codigo">&gt; texto</dt><dd>{t(lang, 'rfcs.nova.md.citacao')}</dd></div>
              </dl>
              <p class="apoio">{t(lang, 'rfcs.nova.md.nota')}</p>
            </section>
          </aside>
        </div>
      </form>
    )}

    <Rodape />
  </div>
</Layout>

<style>
  .cabecalho-escrita { padding: 56px 4px 40px; }
  .cabecalho-escrita .volta {
    display: inline-block;
    font-size: 13px;
    color: var(--t-65);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .cabecalho-escrita .volta:hover { color: var(--t-100); }
  .cabecalho-escrita .titulo-duplo { max-width: 14ch; margin-bottom: 16px; }

  .aviso-topo { margin: 0 4px 24px; max-width: 640px; }

  .escrita-grade {
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 320px);
    justify-content: space-between;
    gap: 56px;
    align-items: start;
    padding: 0 4px;
  }
  @media (max-width: 900px) {
    .escrita-grade { grid-template-columns: minmax(0, 1fr); gap: 48px; }
  }

  .coluna-escrita .campo { margin-bottom: 28px; }
  .coluna-escrita .entrada { min-height: 44px; }
  .coluna-escrita textarea.entrada { min-height: 96px; }
  .coluna-escrita textarea.entrada.corpo-longo {
    min-height: 360px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13.5px;
  }

  /* o contador mora na linha do rótulo, colado no limite que ele mede,
     mas FORA do <label>: dentro dele o número entraria no nome acessível
     do campo e seria reanunciado a cada tecla digitada */
  .campo > .linha-rotulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .linha-rotulo > .rotulo { margin-bottom: 0; }
  .contador { font-size: 12px; color: var(--t-65); }
  /* fora do intervalo pesa mais, sem cor gritante */
  .contador.fora { color: var(--t-100); font-weight: 600; }

  .rodape-form { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .rodape-form .botao,
  .rodape-form .botao-secundario { height: 44px; padding: 0 22px; }
  .coluna-escrita > .apoio { margin-top: 16px; }

  .lado-escrita { display: grid; gap: 40px; position: sticky; top: 24px; }
  @media (max-width: 900px) { .lado-escrita { position: static; } }

  .ajuda-md dl { margin: 0 0 14px; display: grid; gap: 2px; }
  .ajuda-md dl > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--t-07);
    font-size: 13px;
  }
  .ajuda-md dt { color: var(--t-75); min-width: 0; overflow-wrap: anywhere; }
  .ajuda-md dd { margin: 0; color: var(--t-65); text-align: right; }
</style>

{/* Global de propósito, e todo prefixado por uma classe que só existe
    nesta tela: os nós da prévia vêm do CartaoIdeia.astro, e regra
    escopada não entra em componente importado. */}
<style is:global>
  .previa-nova { display: grid; gap: 12px; }

  .previa-nova .rotulo-previa,
  .ajuda-md .rotulo-previa {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--t-100);
    margin: 0 0 2px;
  }

  /* o cartão nasce em opacity 0 esperando o observador do átrio, que
     aqui não existe: a prévia é o que precisa estar visível primeiro */
  .previa-nova .ideia { opacity: 1; margin-bottom: 0; }

  /* Sem slug o CartaoIdeia escreve `background: var(--color-)`, que
     apaga o fundo do chip. O !important é o preço de não reimplementar
     o componente: só uma declaração importante vence uma inline. */
  .previa-nova .chip.pastel { background: var(--color-chip) !important; }

  /* placeholder no idioma do produto, nunca esqueleto cinza: é a
     primeira coisa que a pessoa vê e já ensina o formato. O estado
     mora no invólucro pra valer já no HTML servido. */
  .previa-nova[data-titulo="vazio"] .ideia h3 { color: var(--t-50); }
  .previa-nova[data-resumo="vazio"] .ideia .miolo > p { color: var(--t-50); }

  /* o que sai não some, fica riscado: aqui o riscado quer dizer "isto
     impede o salvamento", nenhum cartão truncado chega a existir */
  .previa-nova .excedente {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    color: var(--t-50);
  }
  /* o objeto inteiro fica marcado, não só o número */
  .previa-nova[data-cabe="nao"] .ideia { box-shadow: var(--sombra-alta); }

  /* a medida fica FORA do cartão: contador dentro dele seria uma peça
     que o objeto real nunca tem */
  .previa-nova .medida {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--t-65);
    font-variant-numeric: tabular-nums;
  }
  .previa-nova .medida.fora { color: var(--t-100); font-weight: 600; }

  .previa-nova .nota-previa {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--t-65);
    max-width: 42ch;
  }
  .previa-nova .nota-previa b { font-weight: 600; color: var(--t-100); }
</style>

<script>
  function ligarContadores() {
    const marcadores = document.querySelectorAll<HTMLElement>('[data-contador]');

    for (const marcador of marcadores) {
      const campo = document.getElementById(marcador.dataset.contador!) as
        HTMLInputElement | HTMLTextAreaElement | null;
      if (!campo) continue;

      const min = Number(marcador.dataset.min);
      const max = Number(marcador.dataset.max);

      const atualizar = () => {
        const n = campo.value.trim().length;
        const curto = n > 0 && n < min;
        marcador.textContent = curto
          ? marcador.dataset.textoMin!.replace('{n}', String(n)).replace('{min}', String(min))
          : `${n} / ${max}`;
        marcador.classList.toggle('fora', curto || n > max);
      };

      campo.addEventListener('input', atualizar);
      atualizar();
    }
  }

  /* ---------- o cartão sendo fabricado ----------
     Tudo aqui é vitrine: nenhum destes nós entra no POST. O que muda
     é só o que a pessoa já digitou, refletido no objeto que a ideia
     vai virar. */
  function ligarPrevia() {
    const previa = document.querySelector<HTMLElement>('.previa-nova');
    if (!previa) return;                  // sem laboratório cadastrado não há formulário

    const titulo = document.getElementById('title') as HTMLInputElement | null;
    const resumo = document.getElementById('summary') as HTMLTextAreaElement | null;
    const seletor = document.getElementById('labId') as HTMLSelectElement | null;

    /* Os nós vêm do CartaoIdeia.astro, então a busca é pelo markup dele
       de propósito: o dia em que o componente mudar, a prévia muda
       junto ou quebra na cara — nunca mente em silêncio. */
    const tela = previa.querySelector<HTMLCanvasElement>('.capa canvas');
    const alvoTitulo = previa.querySelector<HTMLElement>('.ideia h3');
    const alvoResumo = previa.querySelector<HTMLElement>('.ideia .miolo > p');
    const chipLab = previa.querySelector<HTMLElement>('.ideia .chip.pastel');
    const medida = previa.querySelector<HTMLElement>('.medida');
    if (!titulo || !resumo || !seletor || !tela ||
        !alvoTitulo || !alvoResumo || !chipLab || !medida) return;

    const max = Number(previa.dataset.max);

    /* A Materia repinta no `resize` e não expõe outro gancho. Pedir a
       repintura por um evento sintético custa esse desvio, mas o
       desenho continua saindo do componente de verdade: reescrevê-lo
       aqui faria a prévia divergir do átrio com o tempo. */
    const pedirRepintura = () => window.dispatchEvent(new Event('resize'));

    const aplicarTitulo = () => {
      const t = titulo.value.trim();
      alvoTitulo.textContent = t || previa.dataset.vazioTitulo!;
      previa.dataset.titulo = t ? 'cheio' : 'vazio';
    };

    const aplicarResumo = () => {
      const r = resumo.value.trim();
      const sobra = r.length - max;

      alvoResumo.textContent = '';
      previa.dataset.resumo = r ? 'cheio' : 'vazio';
      if (!r) {
        alvoResumo.textContent = previa.dataset.vazioResumo!;
      } else {
        alvoResumo.append(r.slice(0, max));
        if (sobra > 0) {
          const excedente = document.createElement('span');
          excedente.className = 'excedente';
          excedente.textContent = r.slice(max);
          alvoResumo.append(excedente);
        }
      }

      /* o excedente não é cortado do cartão: ele impede o cartão. A API
         recusa resumo acima do limite, então prometer truncamento aqui
         seria ensinar uma consequência que o sistema não produz. */
      previa.dataset.cabe = sobra > 0 ? 'nao' : 'sim';
      medida.textContent = sobra > 0
        ? previa.dataset.medidaFora!.replace('{atual}', String(r.length)).replace('{sobra}', String(sobra))
        : previa.dataset.medidaOk!.replace('{atual}', String(r.length));
      medida.classList.toggle('fora', sobra > 0);
    };

    const aplicarLab = () => {
      const opcao = seletor.selectedOptions[0];
      const slug = opcao?.dataset.slug ?? '';

      chipLab.textContent = slug ? (opcao!.dataset.nome ?? '') : previa.dataset.vazioLab!;
      /* a Materia existe com qualquer lab (sem slug usa a composição
         padrão): repinta sempre */
      tela.dataset.lab = slug;
      pedirRepintura();
    };

    titulo.addEventListener('input', aplicarTitulo);
    resumo.addEventListener('input', aplicarResumo);
    seletor.addEventListener('change', aplicarLab);

    aplicarTitulo();
    aplicarResumo();
    aplicarLab();
  }

  document.addEventListener('astro:page-load', () => {
    ligarContadores();
    ligarPrevia();
  });
</script>
