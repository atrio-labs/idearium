---
/* ================================================================
   /confirmar-email/:token — confirma a troca de email (C3)
   ================================================================
   Quem pediu a troca em /perfil recebe um link no email NOVO. Abrir o
   link faz POST /auth/confirm-email/:token, no servidor. A mesma
   ressalva de /verificar-email vale: scanner de email que abre a URL
   antes da pessoa gasta o token.

   Estados: ok, expirado, inválido e falha (API fora). Com PUBLIC_CONTA
   desligada a rota não existe (404).
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import { CONTA_LIGADA, confirmarEmail } from '../../lib/conta';
import { idiomaDe, rota, t } from '../../lib/i18n';

if (!CONTA_LIGADA) return new Response(null, { status: 404 });

const lang = idiomaDe(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const r = await confirmarEmail(Astro.params.token ?? '');
type Estado = 'ok' | 'expirado' | 'invalido' | 'falha';
const estado: Estado = r.ok
  ? 'ok'
  : r.codigo === 'TOKEN_EXPIRED' || r.status === 410
    ? 'expirado'
    : r.status === 400 || r.status === 404 || r.codigo === 'TOKEN_INVALID'
      ? 'invalido'
      : 'falha';

const logado = Astro.locals.usuario != null;
const acaoHref = logado ? rota(lang, '/perfil') : rota(lang, '/entrar?voltar=%2Fperfil');
const acaoTexto = logado ? t(lang, 'auth.verificar.acao.perfil') : t(lang, 'auth.verificar.acao.entrar');
---

<Layout title={t(lang, 'seguranca.confirmar.titulo')} description={t(lang, 'seguranca.confirmar.descricao')}>
  <div class="palco pagina-conta">
    <Nav />

    <div class="form-estreito">
      <header class="cabeca-estreita">
        {estado === 'ok' && <h1 class="titulo-duplo">{t(lang, 'seguranca.confirmar.ok.h1.antes')}<span class="apagado">{t(lang, 'seguranca.confirmar.ok.h1.apagado')}</span></h1>}
        {estado === 'expirado' && <h1 class="titulo-duplo">{t(lang, 'seguranca.confirmar.expirado.h1.antes')}<span class="apagado">{t(lang, 'seguranca.confirmar.expirado.h1.apagado')}</span></h1>}
        {estado === 'invalido' && <h1 class="titulo-duplo">{t(lang, 'seguranca.confirmar.invalido.h1.antes')}<span class="apagado">{t(lang, 'seguranca.confirmar.invalido.h1.apagado')}</span></h1>}
        {estado === 'falha' && <h1 class="titulo-duplo">{t(lang, 'seguranca.confirmar.falha.h1.antes')}<span class="apagado">{t(lang, 'seguranca.confirmar.falha.h1.apagado')}</span></h1>}

        <p class="apoio" role={estado === 'ok' ? 'status' : undefined}>
          {estado === 'ok' && t(lang, 'seguranca.confirmar.ok.texto')}
          {estado === 'expirado' && t(lang, 'seguranca.confirmar.expirado.texto')}
          {estado === 'invalido' && t(lang, 'seguranca.confirmar.invalido.texto')}
          {estado === 'falha' && t(lang, 'seguranca.confirmar.falha.texto')}
        </p>
      </header>

      {estado !== 'falha' && (
        <div class="acoes-form">
          <a class="botao" href={acaoHref}>{acaoTexto}</a>
        </div>
      )}
    </div>

    <Rodape />
  </div>
</Layout>
