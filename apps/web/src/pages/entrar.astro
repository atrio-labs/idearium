---
/* ================================================================
   /entrar — quem já tem conta entra (F2.1)
   ================================================================
   Formulário POST no próprio arquivo, sem fetch no cliente: os dois
   tokens precisam virar cookie httpOnly no servidor (ver lib/sessao),
   e um POST tradicional é o único jeito de a resposta já sair com o
   Set-Cookie no lugar. Sem JS, a tela continua funcionando.

   `?voltar=` guarda pra onde a pessoa ia quando o guard de rota a
   interceptou (exigirSessao monta esse link). Só caminho interno é
   aceito: "//evil.com" é caminho válido pro browser e viraria redirect
   aberto se eu confiasse no valor cru.

   ----------------------------------------------------------------
   DESENHO: a tela mostra a consequência do ato
   ----------------------------------------------------------------
   Conta no Idearium não é portão — o site inteiro se lê sem ela. Uma
   tela de login com dois campos num cartão branco diz o contrário, e
   diz errado. Então a coluna da direita mostra o que a sessão muda:
   os três atos que ela destrava, cada um preso ao CHIP DE ESTADO que
   lhe corresponde no sistema — o mesmo vocabulário que a abertura do
   átrio ensina. Dois desses atos movem o chip e um só acontece dentro
   dele; o conector de cada linha diz qual é qual.

   Quem chegou por `?voltar=` vê o que especificamente a trouxe, e,
   quando o caminho é uma RFC, o cartão real dela (CartaoIdeia, o
   mesmo componente do átrio, com a matéria rodando na semente da
   própria ideia). Cartão parecido feito à mão mentiria.
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import CartaoIdeia from '../components/astro/CartaoIdeia.astro';
import BotoesSociais from '../components/astro/BotoesSociais.astro';
import { OAUTH_ATIVO } from '../lib/oauth';
import { entrar, destinoSeguro, comSessao } from '../lib/sessao';
import { rotuloDoStatus, type Rfc } from '../lib/api';
import { idiomaDe, rota, separarIdioma, t } from '../lib/i18n';

const lang = idiomaDe(Astro);

/* Astro.url chega sem o /en (o middleware reescreveu), então `voltar`
   nasce sem prefixo e o prefixo volta em cada redirect, por rota().
   separarIdioma cobre o link manual com /en dentro do parâmetro, que
   viraria /en/en/... */
const voltar = separarIdioma(
  destinoSeguro(Astro.url.searchParams.get('voltar'), Astro.url.origin),
).caminho;
const pediramVolta = voltar !== '/';
/* depois de /redefinir-senha (só existe com a flag ligada) */
const senhaRedefinida = OAUTH_ATIVO && Astro.url.searchParams.get('senha') === 'redefinida';

/* Quem já está logado não tem o que fazer aqui. Se veio de um guard de
   rota, mando direto pro destino em vez da raiz. */
if (Astro.locals.usuario) return Astro.redirect(rota(lang, voltar));

let erro: string | null = null;
/* Separa "o par email+senha está errado" de "a API caiu": só o primeiro
   pode marcar os campos como inválidos pro leitor de tela. */
let erroDeCampo = false;
let email = '';

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  email = String(dados.get('email') ?? '').trim();
  const senha = String(dados.get('senha') ?? '');

  if (!email || !senha) {
    erro = t(lang, 'conta.entrar.erro.vazio');
    erroDeCampo = true;
  } else {
    try {
      const r = await entrar(Astro.cookies, email, senha);
      if (r.ok) return Astro.redirect(rota(lang, voltar));
      erro = r.erro;
      erroDeCampo = true;
    } catch {
      /* entrar() deixa erro de rede subir; sem isto a tela vira 500 e a
         pessoa não sabe se errou a senha ou se a API caiu */
      erro = t(lang, 'conta.entrar.erro.rede');
    }
  }
}

/* O destino precisa sobreviver ao POST, então vai na ação do formulário. */
const acao = rota(lang, pediramVolta
  ? `/entrar?voltar=${encodeURIComponent(voltar)}`
  : '/entrar');
const linkCriar = rota(lang, pediramVolta
  ? `/criar-conta?voltar=${encodeURIComponent(voltar)}`
  : '/criar-conta');

/* ---------------- o que trouxe a pessoa até aqui ----------------
   Resolvido DEPOIS do POST de propósito: login que dá certo redireciona
   ali em cima e não paga a chamada.

   O guard só preserva o caminho, então o caminho é a única evidência do
   que a pessoa ia fazer. `/rfcs/:slug` cobre dois atos (comentar e se
   inscrever) porque a página de RFC manda os dois pra cá pelo mesmo
   link — a frase diz os dois em vez de chutar um. */
const partes = voltar.split('?')[0].split('/').filter(Boolean);
const slugDestino = partes[0] === 'rfcs' && partes[1] && partes[1] !== 'nova'
  ? partes[1]
  : null;
const editando = slugDestino != null && partes[2] === 'editar';

/* comSessao, e não obterRfc: obterRfc marca a falha da API na requisição
   (lib/requisicao.ts) e acenderia o aviso de "sem resposta" do resto da
   página, que aqui não tem lista pra avisar. Sem cookie a chamada sai
   sem Authorization, igual à leitura pública — rascunho alheio continua
   404. */
let rfcDestino: Rfc | null = null;
if (slugDestino) {
  const r = await comSessao<Rfc>(Astro.cookies, 'GET', `/rfcs/${slugDestino}`);
  rfcDestino = r.dado;
}

/* `marca` diz quais atos da lista ficam na tinta cheia: são a
   consequência concreta do que a pessoa tentou fazer. */
function lerDestino(): { frase: string | null; caminho?: string; marca: string[] } {
  if (!pediramVolta) return { frase: null, marca: [] };
  if (voltar === '/rfcs/nova') {
    return { frase: t(lang, 'conta.entrar.destino.nova'), marca: ['escrever'] };
  }
  if (voltar === '/perfil') {
    return { frase: t(lang, 'conta.entrar.destino.perfil'), marca: [] };
  }
  if (editando) {
    return {
      frase: rfcDestino
        ? t(lang, 'conta.entrar.destino.editar.ideia')
        : t(lang, 'conta.entrar.destino.editar'),
      marca: [],
    };
  }
  if (slugDestino) {
    return rfcDestino
      ? { frase: t(lang, 'conta.entrar.destino.ideia'),
          marca: ['comentar', 'inscrever'] }
      : { frase: t(lang, 'conta.entrar.destino.ideia.falha'), marca: [] };
  }
  return { frase: null, caminho: voltar, marca: [] };
}
const destino = lerDestino();

/* Os três atos, na ordem do ciclo que a abertura do átrio ensina. Os
   rótulos vêm de statusLabel: sinônimo inventado aqui quebraria o
   vocabulário que a pessoa acabou de aprender lá.

   O conector muda de ato pra ato porque a relação com o estado muda.
   Escrever e se inscrever MOVEM o chip: a API grava DRAFT na criação e
   recalcula em construção quando entra alguém pra construir. Comentar
   não move nada — a API só lê o estado pra decidir se libera. Dizer
   "vira em discussão" no comentar prometeria uma transição que o
   sistema não executa, e quem está aprendendo o vocabulário aqui
   aprenderia errado. Pior: numa ideia já em construção, o chip do
   cartão logo acima diria o contrário na mesma tela. */
const atos = [
  {
    chave: 'escrever',
    verbo: t(lang, 'conta.entrar.ato.escrever'),
    antes: t(lang, 'conta.entrar.ato.escrever.antes'),
    estado: rotuloDoStatus('DRAFT', lang),
    depois: null,
    vivo: false,
    /* a frase-âncora do produto explica exatamente este ato, e aqui ela
       tem referente: solta no rodapé era só slogan */
    gloss: t(lang, 'conta.entrar.ato.escrever.gloss'),
  },
  {
    chave: 'comentar',
    verbo: t(lang, 'conta.entrar.ato.comentar'),
    /* "de X em diante" é o que a API faz: comentário vale a partir da
       publicação e segue valendo depois, só arquivada barra */
    antes: t(lang, 'conta.entrar.ato.comentar.antes'),
    estado: rotuloDoStatus('IN_DISCUSSION', lang),
    depois: t(lang, 'conta.entrar.ato.comentar.depois'),
    vivo: true,
  },
  {
    chave: 'inscrever',
    verbo: t(lang, 'conta.entrar.ato.inscrever'),
    antes: t(lang, 'conta.entrar.ato.inscrever.antes'),
    estado: rotuloDoStatus('IN_BUILDING', lang),
    depois: null,
    vivo: false,
  },
];
---

<Layout
  title={t(lang, 'conta.entrar.titulo')}
  description={t(lang, 'conta.entrar.descricao')}
>
  <div class="palco">
    <Nav />

    <div class="entrada-dupla">
      {/* ---- coluna que se opera ---- */}
      <div class="lado-forma">
        <header class="cabecalho-pagina">
          <span class="mono" style="font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--t-35)">
            {t(lang, 'conta.entrar.rotulo')}
          </span>
          <h1>{t(lang, 'conta.entrar.h1.antes')}<span class="serif">{t(lang, 'conta.entrar.h1.serif')}</span>{t(lang, 'conta.entrar.h1.depois')}</h1>
          <p class="sub">
            {pediramVolta
              ? t(lang, 'conta.entrar.sub.volta')
              : t(lang, 'conta.entrar.sub.normal')}
          </p>
        </header>

        {senhaRedefinida && <p class="aviso-ok" role="status">{t(lang, 'auth.entrar.redefinida')}</p>}

        <form method="POST" action={acao}>
          {/* o erro só existe depois de um POST, que recarrega a página
              inteira — leitor de tela não anuncia live region que já veio
              pronta, então o foco vai pro texto do erro em vez do campo */}
          {erro && (
            <p class="aviso-erro" role="alert" id="erro-form" tabindex="-1" autofocus>
              {erro}
            </p>
          )}

          <div class={erroDeCampo ? 'campo com-erro' : 'campo'}>
            <label class="rotulo" for="email">{t(lang, 'conta.entrar.campo.email')}</label>
            <input
              class="entrada"
              id="email"
              name="email"
              type="email"
              value={email}
              required
              autocomplete="email"
              autocapitalize="none"
              spellcheck="false"
              aria-invalid={erroDeCampo ? 'true' : undefined}
              aria-describedby={erro ? 'erro-form' : undefined}
              autofocus={!erro}
            />
          </div>

          <div class={erroDeCampo ? 'campo com-erro' : 'campo'}>
            <label class="rotulo" for="senha">{t(lang, 'conta.entrar.campo.senha')}</label>
            <input
              class="entrada"
              id="senha"
              name="senha"
              type="password"
              required
              autocomplete="current-password"
              aria-invalid={erroDeCampo ? 'true' : undefined}
              aria-describedby={erro ? 'ajuda-senha erro-form' : 'ajuda-senha'}
            />
            <span class="ajuda" id="ajuda-senha">
              {OAUTH_ATIVO
                ? <a href={rota(lang, '/recuperar-senha')}>{t(lang, 'auth.entrar.esqueci')}</a>
                : t(lang, 'conta.entrar.ajuda.senha')}
            </span>
          </div>

          <div class="acoes-form">
            <button class="botao" type="submit">{t(lang, 'conta.entrar.botao.entrar')}</button>
            <span class="separador"></span>
            <a class="botao leve" href={linkCriar}>{t(lang, 'conta.entrar.botao.criar')}</a>
          </div>
        </form>

        {OAUTH_ATIVO && <BotoesSociais lang={lang} voltar={voltar} />}
      </div>

      {/* ---- coluna que acompanha: a consequência do ato ---- */}
      <aside class="consequencia" aria-label={t(lang, 'conta.entrar.aside')}>
        {pediramVolta && (
          <div class="veio-de">
            <p class="rotulo-mono">{t(lang, 'conta.entrar.veio.rotulo')}</p>
            {destino.caminho
              ? <p class="frase">{t(lang, 'conta.entrar.veio.antes')}<span class="mono caminho">{destino.caminho}</span>{t(lang, 'conta.entrar.veio.depois')}</p>
              : <p class="frase">{destino.frase}</p>}
            {rfcDestino && <CartaoIdeia rfc={rfcDestino} />}
            <hr class="divisor" />
          </div>
        )}

        <p class="rotulo-mono">
          {pediramVolta ? t(lang, 'conta.entrar.mais.volta') : t(lang, 'conta.entrar.mais.normal')}
        </p>
        {!pediramVolta && (
          <p class="frase">
            {t(lang, 'conta.entrar.intro')}
          </p>
        )}

        <ul class="atos">
          {atos.map((a) => (
            <li class="ato" data-trouxe={destino.marca.includes(a.chave) ? 'sim' : undefined}>
              <span class="verbo">{a.verbo}</span>
              <span class="vira">
                {a.antes}
                {a.vivo
                  ? <span class="chip pequeno vivo"><span class="ponto"></span>{a.estado}</span>
                  : <span class="chip pequeno">{a.estado}</span>}
                {a.depois && <span>{a.depois}</span>}
              </span>
              {a.gloss && <span class="gloss serif">{a.gloss}</span>}
            </li>
          ))}
        </ul>

        {/* o objeto que este formulário fabrica é a sessão, e o único
            campo dela que a pessoa escreve é o email */}
        <div class="sessao">
          <p class="linha mono">{t(lang, 'conta.entrar.sessao.entra')}<span class="valor" id="eco-email" data-vazio={t(lang, 'conta.entrar.sessao.vazio')}>{email || t(lang, 'conta.entrar.sessao.vazio')}</span></p>
          <p class="nota">{t(lang, 'conta.entrar.sessao.nota')}</p>
        </div>
      </aside>
    </div>

    <Rodape />
  </div>
</Layout>

<style>
  /* Duas colunas: o formulário é o que se opera, a consequência
     acompanha. Em tela estreita ela desce, e nunca some — no celular
     continua sendo a explicação. */
  .entrada-dupla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 316px;
    gap: 46px;
    align-items: start;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 900px) {
    .entrada-dupla { grid-template-columns: 1fr; gap: 30px; max-width: 520px; }
  }
  .lado-forma { max-width: 480px; }

  /* alinha o topo da coluna com o rótulo "entrar" do cabeçalho */
  .consequencia { padding-top: 30px; }
  @media (max-width: 900px) { .consequencia { padding-top: 0; } }

  .rotulo-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--t-35);
    margin: 0 0 10px;
  }
  .consequencia .frase { margin: 0 0 14px; font-size: 13.5px; color: var(--t-65); }
  .caminho { font-size: 11px; color: var(--t-90); overflow-wrap: anywhere; }

  .divisor { border: 0; height: 1px; background: var(--t-07); margin: 22px 0 20px; }

  /* Cada ato leva a um estado. A régua fina à esquerda é o que separa um
     do outro — no idioma da casa, sem ícone novo. */
  .atos { list-style: none; margin: 0; padding: 0; display: grid; gap: 15px; }
  .ato {
    display: grid;
    gap: 5px;
    padding-left: 13px;
    border-left: 2px solid var(--t-07);
  }
  .ato .verbo { font-size: 13.5px; color: var(--t-50); }
  .ato .vira {
    display: flex; align-items: center; gap: 7px; flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--t-35);
  }
  .ato .gloss { font-size: 14px; color: var(--t-50); margin-top: 1px; }

  /* o ato que trouxe a pessoa fica na tinta cheia; os outros continuam
     legíveis, só mais baixos */
  .ato[data-trouxe] { border-left-color: var(--t-75); }
  .ato[data-trouxe] .verbo { color: var(--t-100); font-weight: 450; }

  .sessao { margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--t-07); }
  .sessao .linha {
    margin: 0;
    font-size: 11px;
    color: var(--t-35);
    overflow-wrap: anywhere;
  }
  /* Departure Mono só tem 400: aqui a ênfase é a tinta, não o peso */
  .sessao .valor { color: var(--t-90); display: inline-block; }
  .sessao .nota { margin: 7px 0 0; font-size: 12.5px; color: var(--t-50); }

  /* ---- micro-animações, uma por peça ---- */

  /* os atos acendem de cima pra baixo, na ordem do ciclo */
  @keyframes ato-acende {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .consequencia.acesa .ato { animation: ato-acende 440ms var(--ease) both; }
  .consequencia.acesa .ato:nth-child(1) { animation-delay: 120ms; }
  .consequencia.acesa .ato:nth-child(2) { animation-delay: 210ms; }
  .consequencia.acesa .ato:nth-child(3) { animation-delay: 300ms; }

  /* o eco do email assenta quando passa de vazio a escrito */
  @keyframes eco-assenta {
    from { opacity: 0; transform: translateY(3px); filter: blur(2px); }
    to   { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .sessao .valor.trocou { animation: eco-assenta 240ms var(--ease) both; }

  @media (prefers-reduced-motion: reduce) {
    .consequencia.acesa .ato,
    .sessao .valor.trocou { animation: none; }
  }
</style>

<script>
  /* ---------- entrada por IntersectionObserver ----------
     o cartão real da RFC nasce com .vem (opacity 0); sem isto ele nunca
     apareceria nesta página */
  function ligarEntrada() {
    const olho = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('veio');
        olho.unobserve(e.target);
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll<HTMLElement>('.vem').forEach((el) => olho.observe(el));
  }

  /* ---------- os atos acendem quando a coluna entra em vista ----------
     A classe só liga a animação; sem JS a lista aparece inteira, porque
     é ela que explica a tela. */
  function ligarAtos() {
    const bloco = document.querySelector('.consequencia');
    if (!bloco) return;

    const olho = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('acesa');
        olho.unobserve(e.target);
      }
    }, { threshold: 0.2 });

    olho.observe(bloco);
  }

  /* ---------- eco do email na sessão ----------
     Nada de derivar inicial ou @ do email: no Idearium a identidade
     pública é o @username, que só existe depois do login. Ecoar o email
     como chave e dizer que ele não aparece em público é o que é verdade. */
  function ligarEcoDoEmail() {
    const campo = document.getElementById('email') as HTMLInputElement | null;
    const eco = document.getElementById('eco-email');
    if (!campo || !eco) return;

    let vazioAntes = campo.value.trim() === '';

    campo.addEventListener('input', () => {
      const valor = campo.value.trim();
      eco.textContent = valor || eco.dataset.vazio || '';

      /* animar a cada tecla tremeria a linha inteira; só a virada entre
         vazio e escrito é estado novo */
      const vazioAgora = valor === '';
      if (vazioAgora === vazioAntes) return;
      vazioAntes = vazioAgora;
      eco.classList.remove('trocou');
      void eco.offsetWidth;               // reflow: sem isso a animação não reinicia
      eco.classList.add('trocou');
    });
  }

  /* Só `astro:page-load`: com o ClientRouter ativo ele já dispara na
     carga inicial E em cada navegação. */
  document.addEventListener('astro:page-load', () => {
    ligarEntrada();
    ligarAtos();
    ligarEcoDoEmail();
  });
</script>
