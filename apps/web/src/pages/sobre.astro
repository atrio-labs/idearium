---
/* Página institucional: SSR, texto vem da coleção `institucional`.
   O idioma vem de locals.lang (camada i18n, outra frente); sem ele,
   pt-BR. Cache curto na borda: o texto só muda por commit. */
import { getEntry, render } from 'astro:content';
import Leitura from '../layouts/Leitura.astro';

const lang = (Astro.locals as any).lang === 'en' ? 'en' : 'pt-BR';
const entrada = await getEntry('institucional', `${lang}/sobre`);
if (!entrada) return new Response(null, { status: 404 });
const { Content } = await render(entrada);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<Leitura
  titulo={entrada.data.titulo}
  descricao={entrada.data.descricao}
  rascunho={entrada.data.rascunho}
  atualizado={entrada.data.atualizado}
  pagina="sobre"
  lang={lang}
>
  <Content />
</Leitura>
