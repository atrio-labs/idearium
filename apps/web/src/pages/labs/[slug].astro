---
/* /labs/:slug — um laboratório e suas ideias (F1.4). Página de
   referência do i18n.

   SSR: o lab é buscado pelo slug a cada requisição. Slug que a API não
   conhece é 404 de verdade, com a tela de vazio, e não redirect pra
   /labs — redirect esconderia do buscador e de quem mandou o link que
   o endereço está errado. API fora é 503, que é outra coisa. */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import CartaoIdeia from '../../components/astro/CartaoIdeia.astro';
import Materia from '../../components/astro/Materia.astro';
import Vazio from '../../components/astro/Vazio.astro';
import { obterLab, listarTodasRfcs, nomeDoLab, materiaDoLab, apiIndisponivel } from '../../lib/api';
import { idiomaDe, rota, t } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

const lang = idiomaDe(Astro);
const { slug } = Astro.params;
const [lab, rfcs] = await Promise.all([
  obterLab(slug!),
  listarTodasRfcs({ lab: slug }),
]);
const semRede = apiIndisponivel();

if (!lab) Astro.response.status = semRede ? 503 : 404;
cachePublico(Astro, semRede);

const nome = lab ? nomeDoLab(lab, lang) : '';
const m = materiaDoLab(slug!);
---

{lab ? (
  <Layout
    title={`Idearium · ${nome}`}
    description={lab.description ?? t(lang, 'labs.meta.descricao', { nome })}
  >
    <div class="palco">
      <Nav atual="labs" />

      <header class="cabeca">
        <a class="volta" href={rota(lang, '/labs')}>{t(lang, 'labs.volta')}</a>
        <div class="linha">
          <h1 class="titulo-duplo grande">
            <span class="glyph" aria-hidden="true">{lab.glyph}</span>{nome}. <span class="apagado">{t(lang, 'labs.lab.h1.apagado')}</span>
          </h1>
          <p class="apoio">{lab.description ?? t(lang, 'labs.descricao.padrao')}</p>
        </div>
      </header>

      {/* a mesma imagem do cartão do lab, larga: é a identidade dele */}
      <figure class="imagem-lab">
        <Materia tipo={m.tipo} lab={lab.slug} semente={m.semente} alt={t(lang, 'labs.materia.alt', { nome })} />
      </figure>

      <p class="contagem">
        {t(lang, rfcs.length === 1 ? 'labs.contagem.um' : 'labs.contagem.varios', { n: rfcs.length })}
      </p>

      {rfcs.length > 0 ? (
        <div class="grade">
          {rfcs.map((rfc) => <CartaoIdeia rfc={rfc} ocultarLab />)}
        </div>
      ) : (
        <Vazio
          titulo={t(lang, 'labs.lab.vazio.titulo', { nome })}
          texto={t(lang, 'labs.lab.vazio.texto')}
          acaoHref={rota(lang, '/rfcs/nova')}
          acaoTexto={t(lang, 'comum.acao.escrever.primeira')}
        />
      )}

      <Rodape />
    </div>
  </Layout>
) : (
  <Layout title={t(lang, 'labs.titulo')}>
    <div class="palco">
      <Nav atual="labs" />
      <Vazio
        falha={semRede}
        titulo={t(lang, semRede ? 'comum.vazio.falha.titulo' : 'labs.inexistente.titulo')}
        texto={t(lang, semRede ? 'labs.vazio.falha.texto' : 'labs.inexistente.texto')}
        acaoHref={rota(lang, '/labs')}
        acaoTexto={t(lang, 'labs.inexistente.acao')}
      />
      <Rodape />
    </div>
  </Layout>
)}

<style>
  /* mesmo ajuste de contraste do átrio: o apagado do global fica
     abaixo de 3:1 */
  .titulo-duplo .apagado { color: #858585; }

  .cabeca { padding: var(--espaco-7) 4px var(--espaco-7); }
  .volta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: var(--text-apoio);
    color: var(--t-65);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .volta:hover { color: var(--t-100); }
  .linha {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--espaco-7);
    align-items: end;
    margin-top: var(--espaco-7);
  }
  .linha .titulo-duplo { max-width: 16ch; }
  .glyph { color: var(--t-65); margin-right: 0.3em; }

  .imagem-lab {
    position: relative;
    margin: 0 0 var(--espaco-8);
    height: clamp(180px, 26vw, 320px);
    border-radius: var(--r-fora);
    overflow: hidden;
  }
  .imagem-lab :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* o --t-50 do global não chega a 4,5:1 em texto pequeno */
  .contagem { margin: 0; padding: 0 4px var(--espaco-5); color: var(--t-65); }

  @media (max-width: 900px) {
    .linha { grid-template-columns: 1fr; gap: var(--espaco-4); margin-top: var(--espaco-5); }
  }
</style>

<script>
  /* .vem → .veio: o CartaoIdeia nasce com opacidade 0 (global.css) */
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12 });
    document.querySelectorAll('.vem').forEach((el) => olho.observe(el));
  });
</script>
