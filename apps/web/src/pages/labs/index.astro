---
/* /labs — os seis domínios (F1.4). Página de referência do i18n.
   Título em dois tons com o apoio ao lado, e um cartão branco por lab
   com a Materia dele (CartaoLab). */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import Vazio from '../../components/astro/Vazio.astro';
import CartaoLab from '../../components/astro/CartaoLab.astro';
import { listarLabs, apiIndisponivel } from '../../lib/api';
import { idiomaDe, t } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

const lang = idiomaDe(Astro);
const labs = await listarLabs();
const semRede = apiIndisponivel();
cachePublico(Astro, semRede);
---

<Layout title={t(lang, 'labs.titulo')}>
  <div class="palco">
    <Nav atual="labs" />

    <header class="cabeca">
      <h1 class="titulo-duplo grande">
        {t(lang, 'labs.h1.antes')}<span class="apagado">{t(lang, 'labs.h1.apagado')}</span>
      </h1>
      <p class="apoio">{t(lang, 'labs.sub')}</p>
    </header>

    {semRede && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'labs.aviso')}
      </p>
    )}

    {labs.length > 0 ? (
      <div class="grade-labs">
        {labs.map((lab) => <CartaoLab lab={lab} grande />)}
      </div>
    ) : (
      <Vazio
        falha={semRede}
        titulo={t(lang, semRede ? 'comum.vazio.falha.titulo' : 'labs.vazio.titulo')}
        texto={semRede ? t(lang, 'labs.vazio.falha.texto') : undefined}
      />
    )}

    <Rodape />
  </div>
</Layout>

<style>
  /* mesmo ajuste de contraste do átrio: o apagado do global fica
     abaixo de 3:1 */
  .titulo-duplo .apagado { color: #858585; }

  .cabeca {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--espaco-7);
    align-items: end;
    padding: var(--espaco-9) 4px var(--espaco-8);
  }
  .grade-labs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--espaco-4);
    margin-bottom: var(--espaco-8);
  }

  @media (max-width: 900px) {
    .cabeca { grid-template-columns: 1fr; gap: var(--espaco-4); padding: var(--espaco-8) 4px var(--espaco-7); }
  }
</style>
