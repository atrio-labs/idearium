---
/* ================================================================
   index.astro — o átrio, direção minimalista
   ================================================================
   Consome a API a cada requisição (SSR), com cache HTTP pra quem não
   está logado (lib/cache.ts): ideia nova aparece sem rebuild.

   Página de referência do i18n: todo texto vem de src/i18n/atrio.ts,
   labs.ts e comum.ts, e todo link passa por `rota`.

   Estrutura, de cima pra baixo:
     nav
     herói      frase âncora em dois tons; apoio e duas ações à
                direita; a Materia larga embaixo
     frase      o que o Idearium é, em dois tons, e três colunas
                curtas: propor, discutir, construir
     recentes   as três ideias mais novas (CartaoIdeia)
     labs       os seis domínios, cada um com a sua Materia
     rodapé

   Saiu do átrio anterior: o destaque com trilha, errata e pedido, o
   chip que percorria o ciclo e os rostos empilhados (VISAO §9: o
   átrio mostra ideias, não a plateia delas).
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import Materia from '../components/astro/Materia.astro';
import CartaoIdeia from '../components/astro/CartaoIdeia.astro';
import CartaoLab from '../components/astro/CartaoLab.astro';
import Vazio from '../components/astro/Vazio.astro';
import { listarLabs, listarRfcs, apiIndisponivel } from '../lib/api';
import { idiomaDe, rota, t } from '../lib/i18n';
import { cachePublico } from '../lib/cache';

const lang = idiomaDe(Astro);
const [labs, pagina] = await Promise.all([
  listarLabs(),
  /* três cabem numa linha da grade; a listagem completa está em /rfcs */
  listarRfcs({ limit: 3, sort: 'recent' }),
]);
const recentes = pagina.data;

/* aviso de uma ação de conta que termina aqui (excluir conta, sair de
   todos os aparelhos); só valores conhecidos, nunca texto da URL */
const pedidoAviso = Astro.url.searchParams.get('aviso');
const avisoConta =
  pedidoAviso === 'conta-removida' ? 'seguranca.aviso.conta-removida'
  : pedidoAviso === 'saiu-todos' ? 'seguranca.aviso.saiu-todos'
  : null;

const semRede = apiIndisponivel();
cachePublico(Astro, semRede);

const colunas = [
  { titulo: t(lang, 'atrio.propor.titulo'), texto: t(lang, 'atrio.propor.texto') },
  { titulo: t(lang, 'atrio.discutir.titulo'), texto: t(lang, 'atrio.discutir.texto') },
  { titulo: t(lang, 'atrio.construir.titulo'), texto: t(lang, 'atrio.construir.texto') },
];
---

<Layout title={t(lang, 'atrio.titulo')}>
  <div class="palco">
    <Nav />

    {avisoConta && <p class="aviso-ok" role="status">{t(lang, avisoConta)}</p>}

    {/* ============ HERÓI ============ */}
    <header class="heroi">
      <h1 class="titulo-duplo grande">
        {t(lang, 'atrio.heroi.antes')}<span class="apagado">{t(lang, 'atrio.heroi.apagado')}</span>
      </h1>
      <div class="lado">
        <p class="apoio">{t(lang, 'atrio.heroi.apoio')}</p>
        <div class="acoes">
          <a class="botao" href={rota(lang, '/rfcs/nova')}>{t(lang, 'atrio.heroi.escrever')}</a>
          <a class="botao-secundario" href={rota(lang, '/rfcs')}>{t(lang, 'atrio.heroi.ver')}</a>
        </div>
      </div>
    </header>

    {/* semente fixa: a capa do átrio é sempre a mesma imagem */}
    <figure class="imagem-heroi">
      <Materia tipo="mancha" lab="idearium" semente={2026} alt={t(lang, 'atrio.heroi.alt')} />
    </figure>

    {/* ============ FRASE + COLUNAS ============ */}
    <section class="secao frase">
      <h2 class="titulo-duplo">
        {t(lang, 'atrio.frase.antes')}<span class="apagado">{t(lang, 'atrio.frase.apagado')}</span>
      </h2>
      <div class="colunas">
        {colunas.map((c) => (
          <div>
            <h3>{c.titulo}</h3>
            <p class="apoio">{c.texto}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ============ IDEIAS RECENTES ============ */}
    <section class="secao">
      <div class="cabeca-secao">
        <h2 class="titulo-duplo">
          {t(lang, 'atrio.recentes.antes')}<span class="apagado">{t(lang, 'atrio.recentes.apagado')}</span>
        </h2>
        <a class="botao-secundario" href={rota(lang, '/rfcs')}>{t(lang, 'atrio.recentes.todas')}</a>
      </div>

      {semRede && (
        <p class="aviso-api">
          <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'atrio.aviso.texto')}
        </p>
      )}

      {recentes.length > 0 ? (
        <div class="grade">
          {recentes.map((rfc) => <CartaoIdeia rfc={rfc} />)}
        </div>
      ) : (
        <Vazio
          falha={semRede}
          titulo={t(lang, semRede ? 'comum.vazio.falha.titulo' : 'atrio.vazio.titulo')}
          texto={t(lang, semRede ? 'atrio.vazio.falha.texto' : 'atrio.vazio.texto')}
          acaoHref={semRede ? undefined : rota(lang, '/rfcs/nova')}
          acaoTexto={semRede ? undefined : t(lang, 'comum.acao.escrever.primeira')}
        />
      )}
    </section>

    {/* ============ LABS ============ */}
    {labs.length > 0 && (
      <section class="secao">
        <div class="cabeca-secao">
          <h2 class="titulo-duplo">
            {t(lang, 'labs.h1.antes')}<span class="apagado">{t(lang, 'labs.h1.apagado')}</span>
          </h2>
          <a class="botao-secundario" href={rota(lang, '/labs')}>{t(lang, 'atrio.labs.todos')}</a>
        </div>
        <div class="grade-labs">
          {labs.map((lab) => <CartaoLab lab={lab} />)}
        </div>
      </section>
    )}

    <Rodape />
  </div>
</Layout>

<style>
  /* O tom apagado do global (#B5B5B5) fica abaixo de 3:1 no branco e
     no cinza da moldura. Título grande pede 3:1 (AA texto grande);
     este cinza dá 3,7:1 no branco e 3,2:1 no cinza. */
  .titulo-duplo .apagado { color: #858585; }

  /* ---------- herói ---------- */
  .heroi {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--espaco-7);
    align-items: end;
    padding: var(--espaco-9) 4px var(--espaco-7);
  }
  .heroi .titulo-duplo { max-width: 14ch; }
  .heroi .lado { display: grid; gap: var(--espaco-5); justify-items: start; }
  .acoes { display: flex; gap: var(--espaco-2); flex-wrap: wrap; }

  /* alvo de toque: o botão global tem 38px */
  .acoes .botao,
  .acoes .botao-secundario,
  .cabeca-secao .botao-secundario { height: 44px; padding: 0 22px; }

  .imagem-heroi {
    position: relative;
    margin: 0;
    height: clamp(240px, 42vw, 560px);
    border-radius: var(--r-fora);
    overflow: hidden;
  }
  .imagem-heroi :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* ---------- seções ---------- */
  .secao { padding: var(--espaco-9) 4px 0; }
  .secao:last-of-type { padding-bottom: var(--espaco-8); }

  .frase .titulo-duplo { max-width: 26ch; }
  .colunas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--espaco-6);
    margin-top: var(--espaco-8);
  }
  .colunas h3 {
    margin: 0 0 var(--espaco-2);
    font-size: 17px;
    letter-spacing: -0.015em;
    color: var(--t-100);
  }

  .cabeca-secao {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--espaco-5);
    flex-wrap: wrap;
    margin-bottom: var(--espaco-7);
  }
  .cabeca-secao .titulo-duplo { max-width: 20ch; }

  .grade-labs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--espaco-3);
  }

  @media (max-width: 900px) {
    .heroi { grid-template-columns: 1fr; gap: var(--espaco-5); padding-top: var(--espaco-8); }
    .colunas { grid-template-columns: 1fr; gap: var(--espaco-5); margin-top: var(--espaco-6); }
    .secao { padding-top: var(--espaco-8); }
  }
</style>

<script>
  /* .vem → .veio: o CartaoIdeia nasce com opacidade 0 (global.css) e
     aparece por opacidade quando entra na tela. Sem isto ele não
     apareceria. */
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12 });
    document.querySelectorAll('.vem').forEach((el) => olho.observe(el));
  });
</script>
