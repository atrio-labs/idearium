---
/* ================================================================
   index.astro — o átrio, direção Matéria
   ================================================================
   Agora consome a API de verdade (F1.1). As páginas públicas são
   pré-renderizadas, então estas chamadas rodam em build time.

   Estrutura, de cima pra baixo:
     nav          pílula flutuante, sticky
     abertura     explica o ciclo ENSINANDO o vocabulário
     destaque     uma RFC, com matéria + trilha + errata + pedido
     grade        as demais ideias
     labs         os seis domínios
     chamada      escrever uma ideia
     rodapé
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import Materia from '../components/astro/Materia.astro';
import CartaoIdeia from '../components/astro/CartaoIdeia.astro';
import Vazio from '../components/astro/Vazio.astro';
import {
  listarLabs, listarDestaques, listarRfcs, listarVersoes, listarInscricoes,
  listarComentarios, apiIndisponivel,
  statusLabel, nomeCurtoDoLab, codigoRfc, haQuantoTempo, materiaDaRfc,
} from '../lib/api';

/* Página pública: pré-renderizada em build. O SSR do adapter existe
   só pras rotas com sessão. */
export const prerender = true;

const labs = await listarLabs();

/* O átrio precisa de 4 RFCs (1 destaque + 3 na grade) e /rfcs/featured
   devolve 3. Em vez de duas chamadas, uso a listagem: mesma ordem de
   recência, e sobra margem se o número de destaques mudar.
   Anotado no ROADMAP_FRONTEND como ponto de contrato com o Kae. */
const pagina = await listarRfcs({ limit: 4, sort: 'recent' });
const [destaque, ...outras] = pagina.data;

/* Só o destaque carrega o detalhe: os cartões da grade não precisam. */
const versoes   = destaque ? await listarVersoes(destaque.id) : [];
const inscritos = destaque ? await listarInscricoes(destaque.id) : [];
const comentarios = destaque ? await listarComentarios(destaque.id) : null;

const ativos = inscritos.filter((i) => i.leftAt == null);
const mostrados = ativos.slice(0, 4);
const restantes = ativos.length - mostrados.length;

/* A errata compara as duas últimas versões do corpo. Não existe
   endpoint de diff, então acho o primeiro parágrafo que mudou — que é
   o caso real de errata: uma frase corrigida, não o texto reescrito. */
function acharErrata(vs: typeof versoes) {
  if (vs.length < 2) return null;
  const ordenadas = [...vs].sort((a, b) => a.version - b.version);
  const antes = ordenadas.at(-2)!;
  const agora = ordenadas.at(-1)!;
  const pa = antes.body.split('\n');
  const pb = agora.body.split('\n');
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const a = (pa[i] ?? '').trim();
    const b = (pb[i] ?? '').trim();
    if (a && b && a !== b) {
      return { de: a, para: b, versao: agora.version, data: agora.createdAt };
    }
  }
  return null;
}
const errata = acharErrata(versoes);

/* A trilha: cada barrinha é um passo dado, não porcentagem. Os passos
   nomeados vêm do que existe de fato — versões, discussão, inscrições. */
const passos = destaque ? [
  { dado: versoes.length >= 1, titulo: 'Proposta escrita',
    resto: `e numerada como ${codigoRfc(destaque.number)}` },
  { dado: (comentarios?.meta.total ?? 0) > 0, titulo: 'Discutida em público',
    resto: (comentarios?.meta.total ?? 0) > 0
      ? `${comentarios!.meta.total} ${comentarios!.meta.total === 1 ? 'comentário' : 'comentários'}`
      : '— ninguém comentou ainda' },
  { dado: ativos.length > 0, titulo: 'Alguém se inscreveu',
    resto: ativos.length
      ? `${ativos.length} ${ativos.length === 1 ? 'pessoa' : 'pessoas'} construindo`
      : '— a vaga está aberta' },
] : [];
const passosDados = passos.filter((p) => p.dado).length;

const m = destaque ? materiaDaRfc(destaque) : null;
const semRede = apiIndisponivel;
---

<Layout title="Idearium · Átrio">
  <div class="palco">
    <Nav />

    {/* ============ ABERTURA ============ */}
    <header class="abertura vem">
      <h1>Ideias abertas, esperando <span class="serif">quem sabe fazer</span>.</h1>
      <p class="sub">
        Alguém vê um problema de perto e escreve. Outra pessoa sabe construir e
        procura no que aplicar isso. O Idearium é o lugar onde os dois se
        encontram — sem gatekeeper, sem taxa, e com o crédito dividido.
      </p>

      {/* O chip percorre o ciclo UMA vez quando a abertura entra em
          vista, e para em "publicada". Ciclo único, não loop: o ponto
          de "em discussão" já respira em 2.6s. */}
      <p class="demo-ciclo" id="demo-ciclo">
        uma ideia atravessa quatro estados:
        <span class="chip pequeno" id="chip-demo">
          <span class="ponto"></span><span class="rotulo-estado" id="chip-demo-txt">rascunho</span>
        </span>
      </p>

      <div class="fluxo">
        <div class="etapa">
          <span class="n">01</span>
          <h3>Alguém escreve</h3>
          <p>Uma ideia vira proposta numerada. Não precisa saber construir — precisa conhecer o problema.</p>
          <div class="vira">vira <span class="chip pequeno">{statusLabel.DRAFT}</span></div>
        </div>
        <div class="etapa">
          <span class="n">02</span>
          <h3>A comunidade refina</h3>
          <p>Gente comenta, contesta, corrige. A proposta muda e o histórico fica: nada é apagado.</p>
          <div class="vira">vira <span class="chip pequeno vivo"><span class="ponto"></span>{statusLabel.IN_DISCUSSION}</span></div>
        </div>
        <div class="etapa">
          <span class="n">03</span>
          <h3>Alguém se inscreve</h3>
          <p>Quem sabe fazer entra. Sem aprovação e sem contrato — e pode sair quando quiser, publicamente.</p>
          <div class="vira">vira <span class="chip pequeno">{statusLabel.IN_BUILDING}</span></div>
        </div>
        <div class="etapa">
          <span class="n">04</span>
          <h3>Vira real, e segue aberta</h3>
          <p>Quando existe, o crédito é de todos que passaram por ela. E outra cidade pode construir de novo.</p>
          <div class="vira">vira <span class="chip pequeno">{statusLabel.PUBLISHED}</span></div>
        </div>
      </div>
    </header>

    {/* ============ DESTAQUE ============ */}
    <div class="faixa-rotulo">
      <span class="r">uma delas, agora</span>
      <a href="/rfcs">ver todas as ideias abertas &rarr;</a>
    </div>

    {semRede && (
      <p class="aviso-api">
        <b>Não consegui falar com o servidor.</b> O que aparece abaixo pode estar
        incompleto. O conteúdo volta sozinho quando a API responder.
      </p>
    )}

    {destaque && m ? (
      <article class="cartao destaque vem">
        <figure class="materia">
          <Materia
            tipo={m.tipo}
            lab={destaque.lab.slug}
            semente={m.semente}
            legenda={`${destaque.lab.glyph} ${nomeCurtoDoLab(destaque.lab.name)} · ${haQuantoTempo(destaque.publishedAt)}`}
            alt={`Campo de dados em dithering, ${codigoRfc(destaque.number)}`}
          />
        </figure>

        <div class="conteudo">
          <div class="chips">
            <span class="chip pastel" style={`background: var(--color-${destaque.lab.slug})`}>
              {nomeCurtoDoLab(destaque.lab.name)}
            </span>
            {destaque.status === 'IN_DISCUSSION'
              ? <span class="chip vivo"><span class="ponto"></span>{statusLabel[destaque.status]}</span>
              : <span class="chip">{statusLabel[destaque.status]}</span>}
            <span class="codigo">{codigoRfc(destaque.number)}</span>
          </div>

          <h1>{destaque.title}</h1>
          <p class="resumo">{destaque.summary}</p>

          <div class="trilha">
            <div class="cabeca">
              <span class="titulo">O que já existe</span>
              <span class="versao">v0.{versoes.length || 1} · {haQuantoTempo(destaque.updatedAt)}</span>
            </div>

            <div class="barras" role="img" aria-label={`${passosDados} de ${passos.length} passos dados`}>
              {passos.map((p) => <i class={p.dado ? 'feito' : ''}></i>)}
            </div>

            <div class="passos">
              {passos.map((p) => (
                <div class:list={['passo', p.dado && 'dado']}>
                  <span class="caixa">
                    {p.dado && (
                      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6.3 L4.4 9.2 L10.5 3" /></svg>
                    )}
                  </span>
                  <span><b>{p.titulo}</b> {p.resto}</span>
                </div>
              ))}
            </div>

            {errata && (
              <div class="errata" data-aberta="nao">
                <button class="gatilho" type="button" aria-expanded="false">
                  <span class="chevron"></span> errata · 1 correção
                </button>
                <div class="fole"><div><div class="corpo">
                  <span class="riscado">{errata.de}</span>
                  {errata.para}
                  <span class="data">corrigido {haQuantoTempo(errata.data)} · v0.{errata.versao}</span>
                </div></div></div>
              </div>
            )}
          </div>
        </div>

        <div class="pedido">
          <div class="texto">
            <p class="rotulo">para sair do papel</p>
            <p>
              {ativos.length === 0
                ? <>Ninguém se inscreveu ainda. <b>Pode ser você.</b></>
                : <>Já tem <b>{ativos.length} {ativos.length === 1 ? 'pessoa' : 'pessoas'}</b> construindo. Cabe mais.</>}
            </p>
          </div>
          <div class="acoes">
            <a class="botao" href={`/rfcs/${destaque.slug}`}>quero construir</a>
            <a class="botao leve" href={`/rfcs/${destaque.slug}#discussao`}>ler a discussão</a>
            {mostrados.length > 0 && (
              <span class="rostos" aria-label={`${ativos.length} pessoas inscritas`}>
                {mostrados.map((i, n) => (
                  <span style={`background: var(--color-${labs[n % (labs.length || 1)]?.slug ?? 'cidades'})`}>
                    {i.user.username.slice(0, 2).toUpperCase()}
                  </span>
                ))}
                {restantes > 0 && <span style="background: var(--color-t-12)">+{restantes}</span>}
              </span>
            )}
          </div>
        </div>
      </article>
    ) : (
      <Vazio
        falha={semRede}
        titulo={semRede ? 'O servidor não respondeu' : 'Nenhuma ideia publicada ainda'}
        texto={semRede
          ? 'Assim que a API voltar, as ideias aparecem aqui sem você precisar fazer nada.'
          : 'A primeira ideia publicada aparece aqui. Não precisa saber fazer — precisa conhecer o problema.'}
        acaoHref={semRede ? undefined : '/rfcs/nova'}
        acaoTexto={semRede ? undefined : 'escrever a primeira'}
      />
    )}

    {/* ============ GRADE ============ */}
    {outras.length > 0 && (
      <div class="grade">
        {outras.map((rfc) => <CartaoIdeia rfc={rfc} />)}
      </div>
    )}

    {/* ============ LABS ============ */}
    {labs.length > 0 && (
      <div class="labs-faixa vem">
        {labs.map((lab) => (
          <a class="lab-card" href={`/labs/${lab.slug}`}>
            <span class="fita" style={`background: var(--color-${lab.slug})`}></span>
            <span class="txt">
              <span class="nome"><span class="glyph" aria-hidden="true">{lab.glyph}</span>{nomeCurtoDoLab(lab.name)}</span>
              <span class="qtd">
                {lab.rfcsCount} {lab.rfcsCount === 1 ? 'ideia' : 'ideias'}
              </span>
            </span>
          </a>
        ))}
      </div>
    )}

    {/* ============ CHAMADA ============ */}
    <section class="cartao chamada vem">
      <h2>Escreva uma ideia. <span class="serif">Não precisa saber fazer.</span></h2>
      <p>Precisa só querer que aconteça. Quem sabe fazer está aqui, procurando no que aplicar isso.</p>
      <a class="botao" href="/rfcs/nova">escrever uma ideia</a>
    </section>

    <Rodape />
  </div>
</Layout>

<script>
  /* ---------- entrada por IntersectionObserver ----------
     dispara as micro-animações nomeadas do global.css (.vem → .veio) */
  function ligarEntrada() {
    const olho = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('veio');
        olho.unobserve(e.target);
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = (i * 70) + 'ms';
      olho.observe(el);
    });
  }

  /* ---------- chip demonstrativo: swap em três fases ----------
     Percorre o ciclo UMA vez e para em "publicada". */
  const CICLO = ['rascunho', 'em discussão', 'em construção', 'publicada'];

  function ligarChipDemo() {
    const linha = document.getElementById('demo-ciclo');
    const chip = document.getElementById('chip-demo');
    const txt = document.getElementById('chip-demo-txt');
    if (!linha || !chip || !txt) return;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      txt.textContent = CICLO[CICLO.length - 1];
      return;
    }

    const dur = parseInt(getComputedStyle(txt).getPropertyValue('--swap-dur')) || 150;
    let i = 0;

    const passo = () => {
      i++;
      txt.classList.add('saindo');
      setTimeout(() => {
        txt.textContent = CICLO[i];
        chip.classList.toggle('vivo', CICLO[i] === 'em discussão');
        txt.classList.remove('saindo');
        txt.classList.add('entrando-de-baixo');
        void txt.offsetWidth;                 // reflow: sem isso o salto anima
        txt.classList.remove('entrando-de-baixo');
        if (i < CICLO.length - 1) setTimeout(passo, 1100);
      }, dur);
    };

    const olho = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        olho.unobserve(e.target);
        setTimeout(passo, 900);
      }
    }, { threshold: 0.6 });

    olho.observe(linha);
  }

  /* ---------- errata: fole 0fr → 1fr ---------- */
  function ligarErrata() {
    document.querySelectorAll<HTMLElement>('.errata').forEach((el) => {
      const gatilho = el.querySelector<HTMLButtonElement>('.gatilho');
      if (!gatilho) return;
      gatilho.addEventListener('click', () => {
        const abrindo = el.dataset.aberta !== 'sim';
        el.dataset.aberta = abrindo ? 'sim' : 'nao';
        gatilho.setAttribute('aria-expanded', String(abrindo));
      });
    });
  }

  /* Só `astro:page-load`: com o ClientRouter ativo ele já dispara na
     carga inicial E em cada navegação. Chamar os dois duplicava os
     listeners e a errata alternava duas vezes por clique. */
  document.addEventListener('astro:page-load', () => {
    ligarEntrada();
    ligarChipDemo();
    ligarErrata();
  });
</script>
