---
/* ================================================================
   /perfil — os próprios dados e o perfil de builder (F2.5)
   ================================================================
   Tela com sessão: SSR, sem `prerender`. O middleware já resolveu
   quem é a pessoa; aqui só se confere e se lê o perfil completo.

   DOIS FORMULÁRIOS SEPARADOS, e não um só com dois blocos.
   O motivo não é visual: `PATCH /builders/me` é um UPSERT. Um botão
   único gravaria um BuilderProfile em quem só entrou pra corrigir o
   próprio nome — e ter BuilderProfile é justamente o que coloca a
   pessoa na lista de mãos. Aparecer numa lista pública precisa ser
   escolha explícita, então cada bloco tem o seu envio.

   Depois de gravar, redireciono pra própria página com ?salvo=…
   em vez de responder o POST direto. Assim a pessoa continua aqui
   (é o pedido da HU) sem que recarregar reenvie o formulário, e o
   que aparece na tela é o que o servidor tem de fato.
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import Vazio from '../components/astro/Vazio.astro';
import CartaoMao from '../components/astro/CartaoMao.astro';
import type { Perfil } from '../lib/api';
import { comSessao, desvincular, exigirSessao, reenviarVerificacao } from '../lib/sessao';
import { NOME_DO_PROVEDOR, OAUTH_ATIVO, PROVEDORES, ehProvedor } from '../lib/oauth';
import { idiomaDe, rota, t, type Idioma } from '../lib/i18n';

const lang = idiomaDe(Astro);
const usuario = Astro.locals.usuario;
/* exigirSessao devolve /entrar?voltar=... sem prefixo (Astro.url chega
   sem o /en); rota() põe o prefixo, e /entrar põe de volta no destino. */
const destino = exigirSessao(usuario, Astro.url);
if (destino) return Astro.redirect(rota(lang, destino));

/* Não há `GET /builders/me`: no controller da API o `me` cai na rota
   `:username` e volta 404. O builderProfile vem dentro de /users/me,
   então uma leitura só resolve os dois blocos. */
const leitura = await comSessao<Perfil>(Astro.cookies, 'GET', '/users/me');
/* sessão morreu entre o middleware e esta chamada */
if (leitura.status === 401) return Astro.redirect(rota(lang, exigirSessao(null, Astro.url)!));

const eu = leitura.dado;
const bp = eu?.builderProfile ?? null;

/* O que os campos mostram: o que a API tem, sobrescrito pelo que a
   pessoa digitou quando o envio falha — ninguém deve perder texto. */
let perfil = {
  fullName: eu?.fullName ?? '',
  bio: eu?.bio ?? '',
  avatarUrl: eu?.avatarUrl ?? '',
  preferredLocale: eu?.preferredLocale ?? 'pt-BR',
};
let builder = {
  headline: bp?.headline ?? '',
  topics: (bp?.topics ?? []).join(', '),
  isOpenToWork: bp?.isOpenToWork ?? true,
};

/* Etapa 6 (só com PUBLIC_OAUTH=1). O contrato proposto põe estes três
   campos em /users/me; ausentes, nada é afirmado: `hasPassword`
   desconhecido conta como "tem senha" pra não travar a pessoa à toa
   (a API recusa de qualquer jeito o que deixaria a conta sem entrada). */
const ext = (eu ?? {}) as { emailVerified?: boolean; hasPassword?: boolean; linkedProviders?: string[] };
const ligados = ext.linkedProviders ?? [];
const temSenha = ext.hasPassword !== false;
/* sem senha e com um só provedor: desligar deixaria a conta sem entrada */
const unicoMetodo = !temSenha && ligados.length <= 1;
const emailNaoVerificado = OAUTH_ATIVO && ext.emailVerified === false;
let erroEmail = '';
let erroConta = '';

let erroPerfil = '';
let erroBuilder = '';
let erroTemas = '';
let erroAvatar = '';

const LIMITE_TEMAS = 10;
const LIMITE_TAMANHO_TEMA = 50;

/* O `type="url"` do browser aceita `http://localhost/eu.png`, e o
   `@IsUrl` da API não: ele exige domínio com ponto. Sem esta checagem
   o 400 volta como aviso solto no topo, sem dizer qual campo errou. */
function enderecoDeImagemValido(valor: string) {
  try {
    const url = new URL(valor);
    return (url.protocol === 'https:' || url.protocol === 'http:') && url.hostname.includes('.');
  } catch {
    return false;
  }
}

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  const texto = (nome: string) => String(dados.get(nome) ?? '').trim();

  if (OAUTH_ATIVO && dados.get('formulario') === 'reenviar') {
    const resposta = await reenviarVerificacao(Astro.cookies);
    if (resposta.ok) return Astro.redirect(rota(lang, '/perfil?conta=reenviada'), 303);
    erroEmail = t(lang, 'auth.perfil.email.erro');
  }

  if (OAUTH_ATIVO && dados.get('formulario') === 'desvincular') {
    const provedor = texto('provedor');
    if (!ehProvedor(provedor)) {
      erroConta = t(lang, 'auth.perfil.contas.erro');
    } else if (unicoMetodo) {
      erroConta = t(lang, 'auth.perfil.contas.erro.ultima');
    } else {
      const resposta = await desvincular(Astro.cookies, provedor);
      if (resposta.ok) return Astro.redirect(rota(lang, '/perfil?conta=desconectada'), 303);
      erroConta = resposta.status === 409
        ? t(lang, 'auth.perfil.contas.erro.ultima')
        : t(lang, 'auth.perfil.contas.erro');
    }
  }

  if (dados.get('formulario') === 'perfil') {
    perfil = {
      fullName: texto('fullName'),
      bio: texto('bio'),
      avatarUrl: texto('avatarUrl'),
      preferredLocale: texto('preferredLocale') || 'pt-BR',
    };

    if (perfil.avatarUrl && !enderecoDeImagemValido(perfil.avatarUrl)) {
      erroAvatar = t(lang, 'conta.perfil.avatar.erro');
    } else {
      /* campo em branco vira null, que é como a API apaga. String vazia
         não serve: em avatarUrl ela reprova no IsUrl e volta 400. */
      const resposta = await comSessao(Astro.cookies, 'PATCH', '/users/me', {
        fullName: perfil.fullName || null,
        bio: perfil.bio || null,
        avatarUrl: perfil.avatarUrl || null,
        preferredLocale: perfil.preferredLocale,
      });

      if (resposta.ok) {
        /* quem trocou o idioma continua no perfil, já no idioma escolhido */
        const novo: Idioma = perfil.preferredLocale === 'en' ? 'en' : 'pt-BR';
        return Astro.redirect(rota(novo, '/perfil?salvo=perfil'), 303);
      }
      erroPerfil = resposta.erro ?? t(lang, 'conta.perfil.erro.salvar');
    }
  }

  if (dados.get('formulario') === 'builder') {
    builder = {
      headline: texto('headline'),
      topics: texto('topics'),
      isOpenToWork: dados.get('isOpenToWork') != null,
    };

    const temas = builder.topics.split(',').map((t) => t.trim()).filter(Boolean);

    /* A vírgula é invenção desta tela, não do contrato: a API recebe
       lista. Então o erro de tamanho é checado aqui, onde dá pra
       dizer "temas" em vez de devolver o índice do array. */
    if (temas.length > LIMITE_TEMAS) {
      erroTemas = t(lang, 'conta.perfil.temas.max', { n: LIMITE_TEMAS });
    } else if (temas.some((t) => t.length > LIMITE_TAMANHO_TEMA)) {
      erroTemas = t(lang, 'conta.perfil.temas.tamanho', { n: LIMITE_TAMANHO_TEMA });
    } else {
      const resposta = await comSessao(Astro.cookies, 'PATCH', '/builders/me', {
        headline: builder.headline || null,
        topics: temas,
        isOpenToWork: builder.isOpenToWork,
      });

      if (resposta.ok) return Astro.redirect(rota(lang, '/perfil?salvo=builder'), 303);
      erroBuilder = resposta.erro ?? t(lang, 'conta.perfil.erro.salvar');
    }
  }
}

/* O formulário posta pra própria URL, que depois do primeiro sucesso
   já é /perfil?salvo=… — ler o parâmetro num POST faria o envio que
   falhou mostrar erro e "salvo" ao mesmo tempo. */
const salvo = Astro.request.method === 'POST' ? null : Astro.url.searchParams.get('salvo');
/* resultado de reenviar/conectar/desconectar (e do callback OAuth) */
const conta = Astro.request.method === 'POST' || !OAUTH_ATIVO ? null : Astro.url.searchParams.get('conta');

/* A prévia parte do mesmo texto do campo, cortada pelo mesmo limite
   que o envio aplica: cartão com 12 etiquetas prometeria um salvamento
   que a validação recusa. Depois daqui quem mexe nela é o JS. */
const temasPrevia = builder.topics
  .split(',')
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, LIMITE_TEMAS);
---

<Layout title={t(lang, 'conta.perfil.titulo')} description={t(lang, 'conta.perfil.descricao')}>
  <div class="palco">
    <Nav />

    {/* Marca o documento antes do conteúdo: a entrada animada só pode
        esconder o formulário e a prévia se houver JS depois pra
        devolvê-los. Sem JS, a prévia continua lá — ela é a explicação. */}
    <script is:inline>document.documentElement.classList.add('com-js');</script>

    {eu ? (
      <div class="oficina">
          <header class="cabecalho-pagina cabeca">
            <a class="volta" href={rota(lang, `/users/${eu.username}`)}>
              {t(lang, 'conta.perfil.ver')} &rarr;
            </a>
            <h1>{t(lang, 'conta.perfil.h1.antes')}<span class="serif">{t(lang, 'conta.perfil.h1.serif')}</span>{t(lang, 'conta.perfil.h1.depois')}</h1>
            <p class="sub">
              {t(lang, 'conta.perfil.sub.antes')}@{eu.username}{t(lang, 'conta.perfil.sub.depois')}
            </p>

            {conta === 'reenviada' && <p class="aviso-ok" role="status">{t(lang, 'auth.perfil.email.reenviado')}</p>}
            {erroEmail && <p class="aviso-erro" role="alert">{erroEmail}</p>}
            {emailNaoVerificado && (
              <form method="POST" class="email-aviso">
                <input type="hidden" name="formulario" value="reenviar" />
                <span>{t(lang, 'auth.perfil.email.aviso')}</span>
                <button class="botao-secundario" type="submit">{t(lang, 'auth.perfil.email.reenviar')}</button>
              </form>
            )}
          </header>

          {/* ---------- quem você é ---------- */}
          <section class="bloco vem quem">
            <p class="titulo-bloco">{t(lang, 'conta.perfil.quem.titulo')}</p>

            {salvo === 'perfil' && <p class="aviso-ok" role="status">{t(lang, 'conta.perfil.quem.salvo')}</p>}
            {erroPerfil && <p class="aviso-erro" role="alert">{erroPerfil}</p>}

            <form method="POST">
              <input type="hidden" name="formulario" value="perfil" />

              <div class="campo">
                <label class="rotulo" for="fullName">{t(lang, 'conta.perfil.nome.rotulo')}</label>
                <input
                  class="entrada"
                  id="fullName"
                  name="fullName"
                  type="text"
                  maxlength="100"
                  value={perfil.fullName}
                  aria-describedby="ajuda-fullName"
                  autocomplete="name"
                />
                <span class="ajuda" id="ajuda-fullName">
                  {t(lang, 'conta.perfil.nome.ajuda.antes')}@{eu.username}{t(lang, 'conta.perfil.nome.ajuda.depois')}
                </span>
              </div>

              <div class="campo">
                <label class="rotulo" for="bio">{t(lang, 'conta.perfil.bio.rotulo')}</label>
                <textarea
                  class="entrada"
                  id="bio"
                  name="bio"
                  maxlength="500"
                  aria-describedby="ajuda-bio">{perfil.bio}</textarea>
                <span class="ajuda" id="ajuda-bio">
                  {t(lang, 'conta.perfil.bio.ajuda')}
                </span>
              </div>

              <div class:list={['campo', erroAvatar && 'com-erro']}>
                <label class="rotulo" for="avatarUrl">{t(lang, 'conta.perfil.avatar.rotulo')}</label>
                <input
                  class="entrada mono"
                  id="avatarUrl"
                  name="avatarUrl"
                  type="url"
                  maxlength="500"
                  placeholder="https://"
                  value={perfil.avatarUrl}
                  aria-describedby={erroAvatar ? 'erro-avatarUrl ajuda-avatarUrl' : 'ajuda-avatarUrl'}
                  aria-invalid={erroAvatar ? 'true' : undefined}
                />
                {erroAvatar && <span class="erro-campo" id="erro-avatarUrl">{erroAvatar}</span>}
                <span class="ajuda" id="ajuda-avatarUrl">
                  {t(lang, 'conta.perfil.avatar.ajuda')}
                </span>
              </div>

              <div class="campo">
                <label class="rotulo" for="preferredLocale">{t(lang, 'conta.perfil.idioma.rotulo')}</label>
                <select
                  class="entrada"
                  id="preferredLocale"
                  name="preferredLocale"
                  aria-describedby="ajuda-preferredLocale">
                  <option value="pt-BR" selected={perfil.preferredLocale === 'pt-BR'}>português</option>
                  <option value="en" selected={perfil.preferredLocale === 'en'}>english</option>
                </select>
                <span class="ajuda" id="ajuda-preferredLocale">
                  {t(lang, 'conta.perfil.idioma.ajuda')}
                </span>
              </div>

              <div class="acoes-form">
                <span class="separador"></span>
                <button class="botao" type="submit">{t(lang, 'conta.perfil.quem.botao')}</button>
              </div>
            </form>
          </section>

          {/* ---------- perfil de builder ---------- */}
          <section class="bloco vem oficio">
            <p class="titulo-bloco">{t(lang, 'conta.perfil.oficio.titulo')}</p>

            <p class="intro-oficio">
              {t(lang, 'conta.perfil.oficio.intro.antes')}@{eu.username}{t(lang, 'conta.perfil.oficio.intro.meio')}<a href={rota(lang, '/builders')}>{t(lang, 'comum.nav.builders')}</a>{t(lang, 'conta.perfil.oficio.intro.depois')}
            </p>

            {salvo === 'builder' && <p class="aviso-ok" role="status">{t(lang, 'conta.perfil.oficio.salvo')}</p>}
            {erroBuilder && <p class="aviso-erro" role="alert">{erroBuilder}</p>}

            <form method="POST">
              <input type="hidden" name="formulario" value="builder" />

              <div class="campo">
                <label class="rotulo" for="headline">{t(lang, 'conta.perfil.headline.rotulo')}</label>
                <input
                  class="entrada"
                  id="headline"
                  name="headline"
                  type="text"
                  maxlength="140"
                  value={builder.headline}
                  aria-describedby="ajuda-headline"
                />
                {/* o cartão ao lado já mostra onde a linha cai; o rótulo
                    só precisa dizer o que o cartão não tem como mostrar */}
                <span class="ajuda" id="ajuda-headline">
                  {t(lang, 'conta.perfil.headline.ajuda')}
                </span>
              </div>

              <div class:list={['campo', erroTemas && 'com-erro']}>
                <label class="rotulo" for="topics">{t(lang, 'conta.perfil.temas.rotulo')}</label>
                <input
                  class="entrada"
                  id="topics"
                  name="topics"
                  type="text"
                  value={builder.topics}
                  placeholder={t(lang, 'conta.perfil.temas.exemplo')}
                  aria-describedby={erroTemas ? 'erro-topics ajuda-topics' : 'ajuda-topics'}
                  aria-invalid={erroTemas ? 'true' : undefined}
                />
                {erroTemas && <span class="erro-campo" id="erro-topics">{erroTemas}</span>}
                <span class="ajuda" id="ajuda-topics">
                  {t(lang, 'conta.perfil.temas.ajuda', { max: LIMITE_TEMAS, tamanho: LIMITE_TAMANHO_TEMA })}
                </span>
              </div>

              <div class="campo">
                <label class="marcavel">
                  <input type="checkbox" name="isOpenToWork" checked={builder.isOpenToWork} />
                  <span class="caixa">
                    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6.3 L4.4 9.2 L10.5 3" /></svg>
                  </span>
                  <span>{t(lang, 'conta.perfil.disponivel')}</span>
                </label>
                <span class="ajuda">
                  {t(lang, 'conta.perfil.disponivel.ajuda')}
                </span>
              </div>

              <div class="acoes-form">
                <span class="separador"></span>
                <button class="botao" type="submit">{t(lang, 'conta.perfil.oficio.botao')}</button>
              </div>
            </form>
          </section>

          {/* ---------- contas conectadas (Etapa 6, atrás da flag) ---------- */}
          {OAUTH_ATIVO && (
            <section class="bloco vem conexoes">
              <p class="titulo-bloco">{t(lang, 'auth.perfil.contas.titulo')}</p>
              <p class="intro-oficio">{t(lang, 'auth.perfil.contas.intro')}</p>

              {conta === 'conectada' && <p class="aviso-ok" role="status">{t(lang, 'auth.perfil.contas.conectou')}</p>}
              {conta === 'desconectada' && <p class="aviso-ok" role="status">{t(lang, 'auth.perfil.contas.desconectou')}</p>}
              {conta === 'erro' && <p class="aviso-erro" role="alert">{t(lang, 'auth.perfil.contas.erro')}</p>}
              {erroConta && <p class="aviso-erro" role="alert">{erroConta}</p>}

              <ul class="provedores">
                {PROVEDORES.map((p) => {
                  const ligado = ligados.includes(p);
                  const ultimo = ligado && unicoMetodo;
                  return (
                    <li>
                      <div class="provedor-info">
                        <span class="provedor-nome">{NOME_DO_PROVEDOR[p]}</span>
                        <span class="provedor-estado">
                          {ligado ? t(lang, 'auth.perfil.contas.conectada') : t(lang, 'auth.perfil.contas.nao')}
                        </span>
                        {ultimo && <span class="provedor-motivo" id={`motivo-${p}`}>{t(lang, 'auth.perfil.contas.ultima')}</span>}
                      </div>
                      {ligado ? (
                        <form method="POST">
                          <input type="hidden" name="formulario" value="desvincular" />
                          <input type="hidden" name="provedor" value={p} />
                          <button
                            class="botao-secundario"
                            type="submit"
                            disabled={ultimo}
                            aria-describedby={ultimo ? `motivo-${p}` : undefined}
                          >{t(lang, 'auth.perfil.contas.desconectar')}</button>
                        </form>
                      ) : (
                        <form method="POST" action={rota(lang, `/entrar/${p}`)} data-astro-reload>
                          <button class="botao" type="submit">{t(lang, 'auth.perfil.contas.conectar')}</button>
                        </form>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {/* ---------- a consequência, enquanto o ato acontece ----------
              Não é ilustração do formulário: é o mesmo componente que a
              grade de /builders renderiza, com o texto que está sendo
              digitado agora. Se divergir, o culpado é o CartaoMao. */}
          <aside class="vitrine vem" id="vitrine">
            <p class="mono rotulo-vitrine">{t(lang, 'conta.perfil.vitrine.rotulo')}</p>

            <CartaoMao
              previa
              username={eu.username}
              headline={builder.headline}
              topics={temasPrevia}
              isOpenToWork={builder.isOpenToWork}
            />

            <p class="nota-vitrine" id="nota-fora" hidden={builder.isOpenToWork}>
              {t(lang, 'conta.perfil.vitrine.fora')}
            </p>
            {/* A nota anuncia recusa, e não corte: passando do limite o
                envio volta com erro e nada é gravado. Dizer "só os
                primeiros cabem" ensinaria um truncamento que não existe,
                e prévia que promete o que o sistema não faz mente. */}
            <p class="nota-vitrine" id="nota-excesso" hidden>
              {t(lang, 'conta.perfil.vitrine.excesso', { n: LIMITE_TEMAS })}
            </p>
            <p class="nota-vitrine">
              {bp
                ? <>{t(lang, 'conta.perfil.vitrine.nota.dentro.antes')}<a href={rota(lang, '/builders')}>{t(lang, 'comum.nav.builders')}</a>{t(lang, 'conta.perfil.vitrine.nota.dentro.depois')}</>
                : <>{t(lang, 'conta.perfil.vitrine.nota.fora.antes')}<a href={rota(lang, '/builders')}>{t(lang, 'comum.nav.builders')}</a>{t(lang, 'conta.perfil.vitrine.nota.fora.depois')}</>}
            </p>
          </aside>

          <div class="conta">
            <a href={rota(lang, `/users/${eu.username}`)}>{t(lang, 'conta.perfil.link.publico')}</a>
            <a href={rota(lang, '/sair')}>{t(lang, 'conta.perfil.link.sair')}</a>
          </div>
      </div>
    ) : (
      <div class="form-estreito">
        <Vazio
          falha
          titulo={t(lang, 'conta.perfil.falha.titulo')}
          texto={t(lang, 'conta.perfil.falha.texto')}
        />
      </div>
    )}

    <Rodape />
  </div>
</Layout>

<style>
  /* ----------------------------------------------------------------
     A bancada: o formulário à esquerda, a consequência à direita.
     A coluna do cartão é estreita e nunca é a primeira coisa lida —
     quem opera é o formulário. As posições são explícitas porque a
     vitrine acompanha o bloco de builder, não a página inteira:
     ficar ao lado do bloco errado seria explicar a coisa errada.
     ---------------------------------------------------------------- */
  .oficina {
    max-width: 880px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 296px;
    gap: 18px;
    align-items: start;
  }
  .cabeca  { grid-column: 1 / -1; grid-row: 1; }
  .quem    { grid-column: 1; grid-row: 2; }
  .oficio  { grid-column: 1; grid-row: 3; }
  .vitrine { grid-column: 2; grid-row: 3; position: sticky; top: 86px; }
  .conexoes { grid-column: 1; grid-row: 4; }
  .conta   { grid-column: 1 / -1; grid-row: 5; }

  /* Em tela estreita a vitrine desce pra logo abaixo do formulário que
     ela explica, e não some: no celular ela é a explicação. */
  @media (max-width: 900px) {
    .oficina { grid-template-columns: minmax(0, 1fr); }
    .cabeca, .quem, .oficio, .conexoes, .vitrine, .conta { grid-column: 1; grid-row: auto; }
    .vitrine { position: static; }
  }

  /* `.vem` nasce em opacity 0 no global.css e quem devolve é o
     observador. Aqui o padrão é visível e quem esconde é a classe
     posta pelo próprio JS. */
  .oficina .vem { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    html.com-js .oficina .vem { opacity: 0; }
  }

  .rotulo-vitrine {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--t-35);
    margin: 0 0 10px;
    padding-left: 2px;
  }
  .nota-vitrine {
    margin: 10px 2px 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--t-50);
  }
  .nota-vitrine a { color: var(--t-90); }
  #nota-fora, #nota-excesso { color: var(--t-75); }

  .intro-oficio { margin: 0 0 18px; font-size: 13.5px; color: var(--t-65); }
  .intro-oficio a { color: var(--t-90); }

  /* aviso de email não verificado: uma linha discreta sob o cabeçalho */
  .email-aviso {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin: -12px 0 0;
    font-size: 13px;
    color: var(--t-65);
  }

  .provedores { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .provedores li { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
  .provedor-info { display: grid; gap: 2px; max-width: 34ch; }
  .provedor-nome { font-size: 14px; font-weight: 500; color: var(--t-100); }
  .provedor-estado { font-size: 12.5px; color: var(--t-50); }
  .provedor-motivo { font-size: 12.5px; line-height: 1.45; color: var(--t-75); margin-top: 4px; }

  /* linha de links de conta: discreta de propósito, e fora do rodapé
     do site — sair é ação da pessoa, não navegação institucional */
  .conta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 20px 4px 0;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .conta a { color: var(--t-35); text-decoration: none; }
  .conta a:hover { color: var(--t-90); }
</style>

<script>
  const LIMITE_TEMAS = 10;

  function ligarEntrada() {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  }

  /* ---------- a prévia ao vivo ----------
     Nada aqui salva nada: o cartão só reflete o que os campos têm
     agora. Tudo entra por textContent — headline e tema são texto de
     gente, e innerHTML aqui seria injeção com a própria mão. */
  function ligarPrevia() {
    const vitrine = document.getElementById('vitrine');
    const campoHeadline = document.querySelector<HTMLInputElement>('#headline');
    const campoTemas = document.querySelector<HTMLInputElement>('#topics');
    const campoDisponivel = document.querySelector<HTMLInputElement>('input[name="isOpenToWork"]');
    if (!vitrine || !campoHeadline || !campoTemas || !campoDisponivel) return;

    const cartao = vitrine.querySelector<HTMLElement>('[data-cartao-mao]');
    const alvoHeadline = vitrine.querySelector<HTMLElement>('[data-headline]');
    const listaChips = vitrine.querySelector<HTMLElement>('[data-chips]');
    const chipDisponivel = vitrine.querySelector<HTMLElement>('[data-disponivel]');
    const notaFora = document.getElementById('nota-fora');
    const notaExcesso = document.getElementById('nota-excesso');
    if (!cartao || !alvoHeadline || !listaChips || !chipDisponivel || !notaFora || !notaExcesso) return;

    /* reinicia a animação: sem o reflow o chip que volta entra parado */
    function nascer(chip: HTMLElement) {
      chip.classList.remove('nasce');
      void chip.offsetWidth;
      chip.classList.add('nasce');
    }

    /* Reaproveita os chips que já estão certos e só cria os que
       faltam. Reconstruir a lista inteira faria todos piscarem a cada
       tecla, e o que a pessoa precisa ver é a vírgula virando etiqueta. */
    function sincronizarTemas(temas: string[]) {
      const fantasma = listaChips!.querySelector<HTMLElement>('[data-fantasma]');
      const atuais = Array.from(listaChips!.querySelectorAll<HTMLElement>('[data-tema]'));

      for (let i = temas.length; i < atuais.length; i++) atuais[i].remove();

      temas.forEach((tema, i) => {
        const existente = atuais[i];
        if (existente) {
          if (existente.textContent !== tema) existente.textContent = tema;
          return;
        }
        const chip = document.createElement('span');
        chip.className = 'chip pequeno';
        chip.dataset.tema = '';
        chip.textContent = tema;
        listaChips!.insertBefore(chip, fantasma);
        nascer(chip);
      });

      if (fantasma) fantasma.classList.toggle('escondido', temas.length > 0);
    }

    function pintar() {
      const linha = campoHeadline!.value.trim();
      alvoHeadline!.textContent = linha || alvoHeadline!.dataset.vazio || '';
      alvoHeadline!.classList.toggle('vazia', linha === '');

      const temas = campoTemas!.value.split(',').map((t) => t.trim()).filter(Boolean);
      sincronizarTemas(temas.slice(0, LIMITE_TEMAS));
      notaExcesso!.hidden = temas.length <= LIMITE_TEMAS;

      const disponivel = campoDisponivel!.checked;
      const estavaEscondido = chipDisponivel!.classList.contains('escondido');
      chipDisponivel!.classList.toggle('escondido', !disponivel);
      if (disponivel && estavaEscondido) nascer(chipDisponivel!);
      cartao!.classList.toggle('fora', !disponivel);
      notaFora!.hidden = disponivel;
    }

    campoHeadline.addEventListener('input', pintar);
    campoTemas.addEventListener('input', pintar);
    campoDisponivel.addEventListener('change', pintar);

    /* o browser restaura valor de campo ao voltar pra página; sem esta
       primeira pintura o cartão mostraria o estado do servidor */
    pintar();
  }

  document.addEventListener('astro:page-load', () => {
    ligarEntrada();
    ligarPrevia();
  });
</script>
