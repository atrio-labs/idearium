---
/* ================================================================
   /buscar — busca textual nas ideias (F5)
   ================================================================
   SSR, não pré-renderizada: o resultado depende da querystring, que
   só existe no pedido. Em troca, /buscar?q=água&lab=cidades vira um
   link que qualquer pessoa pode mandar pra outra.

   O formulário é GET puro. Sem JavaScript, escrever e apertar "buscar"
   funciona igual; com JavaScript, trocar um filtro reenvia sozinho.

   ----------------------------------------------------------------
   DESENHO: a tela mostra a consequência do ato
   ----------------------------------------------------------------
   O ato aqui é consultar, e a consequência é COMO A CONSULTA FOI
   ENTENDIDA. Por isso a coluna estreita ao lado do campo não é ajuda
   nem dica: é a consulta montada como o índice vai recebê-la —
   as palavras que ela exige, o dicionário, o recorte, o acento.
   Ela se remonta a cada tecla, e continua abaixo do campo na tela
   estreita, porque no celular ela é a explicação inteira.

   Os dois limites da busca aparecem NA TELA, não só neste comentário:
   ela distingue acento e lê um idioma por vez. O segundo é decisão de
   backend documentada (ROADMAP_BACKEND §2.5, "Cross-language search"):
   o search_vector é construído com o dicionário de cada idioma, então
   uma consulta em português não casa com o índice em inglês. Esconder
   isso faria a pessoa achar que a ideia não existe.
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import CartaoIdeia from '../components/astro/CartaoIdeia.astro';
import Vazio from '../components/astro/Vazio.astro';
import { t, rota, idiomaDe } from '../lib/i18n';
import {
  listarLabs, listarRfcs, nomeDoLab, apiIndisponivel, chamarApi,
  type Autor, type LabResumo, type Pagina, type RfcStatus,
} from '../lib/api';
import {
  fraseDaExigencia, lerConsulta, notaDeAcento, notaDoRadical,
  palavrasDaConsulta, semAcento, tradutorDe, CHAVES_LEITURA, type Idioma,
} from '../lib/leitura-busca';
import { nivelDeUso } from '../lib/peso-tag';
import { cachePublico } from '../lib/cache';

/* A api.ts ainda não expõe /search, então a chamada mora aqui, mas passa
   por `chamarApi` pra mandar o x-lang da requisição. Mesmo contrato do
   resto do cliente: nunca lança, e separa "não achei" de "não falei
   com o servidor". */
interface Achado {
  id: string;
  number: number | null;
  slug: string;
  title: string;
  summary: string;
  locale: string;
  status: RfcStatus;
  publishedAt: string | null;
  rank: number;
  author: Autor;
  lab: LabResumo;
}

interface TagResumo {
  id: string;
  slug: string;
  name: string;
  usageCount: number;
}

async function pedir<T>(
  caminho: string,
): Promise<{ dado: T | null; caiu: boolean; recusada: boolean }> {
  const r = await chamarApi<T>(caminho);
  /* 400 e 422 são a API recusando a consulta, e a pessoa precisa ler
     isso no campo. Todo o resto (404 de rota, 429, 502 de gateway, rede
     fora) é indisponibilidade: chamar de "nada encontrado" esconderia
     a queda. */
  const recusada = r.status === 400 || r.status === 422;
  const ok = r.status >= 200 && r.status < 300;
  return { dado: r.dado, caiu: !ok && !recusada, recusada };
}

/* Teto do SearchQueryDto. Pedir mais devolve 400, não uma lista maior. */
const LIMITE_BUSCA = 50;

const lang = idiomaDe(Astro);
const IDIOMAS: { valor: Idioma; texto: string }[] = [
  { valor: 'pt-BR', texto: t(lang, 'busca.idioma.pt-BR') },
  { valor: 'en', texto: t(lang, 'busca.idioma.en') },
];

const params = Astro.url.searchParams;
const termo = (params.get('q') ?? '').trim();
const labPedido = params.get('lab') ?? '';
/* Sem ?locale=, a busca segue o idioma da interface. A busca não cruza
   idiomas (ROADMAP_BACKEND §2.5), então o padrão certo é o idioma em
   que a pessoa está lendo. */
const localePedido = params.get('locale');
const idioma: Idioma =
  localePedido === 'en' || localePedido === 'pt-BR' ? localePedido : lang;

/* A API exige 2 caracteres. Vale avisar no campo em vez de mandar a
   consulta e traduzir um 400 depois. */
const curtoDemais = termo.length === 1;
const buscou = termo.length >= 2;

const labs = await listarLabs();

/* Slug de lab que não existe filtra a busca pra nada sem marcar pílula
   nenhuma: num link compartilhado com erro de digitação, a pessoa leria
   zero resultado como "não há ideia" em vez de "o recorte está errado".
   Só descarto quando tenho a lista pra comparar. */
const labEscolhido =
  labs.length > 0 && !labs.some((l) => l.slug === labPedido) ? '' : labPedido;

let achados: Achado[] = [];
let total = 0;
let caiu = false;
let recusada = false;
let populares: TagResumo[] = [];

const enderecoDaBusca = (q: string) => {
  const p = new URLSearchParams({ q, locale: idioma });
  if (labEscolhido) p.set('lab', labEscolhido);
  return rota(lang, `/buscar?${p}`);
};

if (buscou) {
  const p = new URLSearchParams({ q: termo, locale: idioma, limit: String(LIMITE_BUSCA) });
  if (labEscolhido) p.set('lab', labEscolhido);
  const r = await pedir<Pagina<Achado>>(`/search?${p}`);
  achados = r.dado?.data ?? [];
  total = r.dado?.meta.total ?? 0;
  caiu = r.caiu;
  recusada = r.recusada;
} else {
  /* Sem consulta, a tela ainda precisa oferecer um caminho. As tags mais
     usadas são o atalho mais honesto: são recortes reais do acervo. */
  const r = await pedir<Pagina<TagResumo>>('/tags?limit=12');
  populares = r.dado?.data ?? [];
  caiu = r.caiu;
}

/* A lista vem ordenada por uso, então a primeira é a mais usada do
   acervo inteiro — o mesmo topo que /tags usa pra calcular o peso. */
const maiorUso = populares[0]?.usageCount ?? 0;

/* ---- a palavra acentuada que existe de verdade ----
   "talvez falte acento" obriga a pessoa a adivinhar qual palavra e
   qual acento. Aqui a palavra vem do acervo: procuro nos títulos e
   resumos publicados uma que, sem acento, é exatamente a que foi
   digitada; reescrevo o termo; e só ofereço depois que a busca
   reescrita devolveu resultado. O que a tela promete, ela entrega.

   Custa duas chamadas, e só no caminho em que a busca rodou e não
   achou nada — que é justamente onde a pessoa está travada. */
async function acharTermoAcentuado(): Promise<{ termo: string; total: number } | null> {
  const acervo = await listarRfcs({ limit: 100, sort: 'recent', locale: idioma });
  if (acervo.data.length === 0) return null;

  const vocabulario = new Map<string, string>();   // sem acento → como está escrita
  for (const rfc of acervo.data) {
    for (const palavra of palavrasDaConsulta(`${rfc.title} ${rfc.summary}`)) {
      const chave = semAcento(palavra);
      if (chave === palavra.toLowerCase()) continue;   // não tem acento a oferecer
      if (!vocabulario.has(chave)) vocabulario.set(chave, palavra.toLowerCase());
    }
  }

  let trocou = false;
  /* Divide preservando os separadores pra devolver o termo com a
     pontuação e os espaços que a pessoa escreveu. */
  const reescrito = termo
    .split(/([^\p{L}\p{N}]+)/u)
    .map((pedaco) => {
      const acentuada = vocabulario.get(semAcento(pedaco));
      if (!acentuada || acentuada === pedaco.toLowerCase()) return pedaco;
      trocou = true;
      return acentuada;
    })
    .join('');

  if (!trocou) return null;

  const p = new URLSearchParams({ q: reescrito, locale: idioma, limit: '1' });
  if (labEscolhido) p.set('lab', labEscolhido);
  const prova = await pedir<Pagina<Achado>>(`/search?${p}`);
  const quantas = prova.dado?.meta.total ?? 0;
  return quantas > 0 ? { termo: reescrito, total: quantas } : null;
}

const sugestao =
  buscou && !caiu && !recusada && achados.length === 0
    ? await acharTermoAcentuado()
    : null;

/* /search não traz createdAt nem updatedAt (o SELECT do FTS não os
   busca). CartaoIdeia só lê `publishedAt ?? createdAt`, então repito
   publishedAt em vez de inventar uma data que não veio. */
const paraCartao = (a: Achado) => ({
  ...a,
  createdAt: a.publishedAt ?? '',
  updatedAt: a.publishedAt ?? '',
});

const labAtual = labs.find((l) => l.slug === labEscolhido);
const nomeCurto = (l: { slug: string; name: string }) => nomeDoLab(l, lang);
const filtrando = Boolean(labEscolhido) || idioma !== lang;

/* A leitura da consulta, montada aqui pra quem chega pelo link ou está
   sem JavaScript. O mesmo cálculo roda no navegador a cada tecla. */
const textosLeitura = Object.fromEntries(CHAVES_LEITURA.map((c) => [c, t(lang, c)]));
const tx = tradutorDe(textosLeitura);
const consulta = lerConsulta(termo, idioma);
const nota = notaDeAcento(termo, idioma, tx);
const radical = notaDoRadical(idioma, tx);
const nomeDoIdioma = IDIOMAS.find((i) => i.valor === idioma)!.texto;
const todosOsLabs = t(lang, 'busca.leitura.recorte.todos');
const recorte = labAtual ? nomeCurto(labAtual) : todosOsLabs;

/* O campo fala da consulta, o vazio fala do resultado. Sem essa separação
   uma consulta recusada aparecia como "nada encontrado", e a pessoa
   procurava o erro na palavra que escreveu. */
const erroNoCampo = curtoDemais
  ? t(lang, 'busca.erro.curto')
  : recusada
    ? t(lang, 'busca.erro.recusada')
    : null;

/* Com sugestão verificada, o texto do vazio sai de cena: a oferta
   concreta logo abaixo diz mais do que qualquer conselho. */
const textoVazio = sugestao
  ? t(lang, 'busca.semachado.sugestao')
  : filtrando
    ? t(lang, 'busca.semachado.recorte')
    : t(lang, 'busca.semachado.geral');

cachePublico(Astro, caiu || apiIndisponivel());
---

<Layout
  title={buscou ? t(lang, 'busca.titulo.termo', { termo }) : t(lang, 'busca.titulo')}
  description={t(lang, 'busca.descricao')}
>
  <div class="palco">
    <Nav atual="buscar" />

    {/* .vem nasce com opacity 0 e quem devolve a opacidade é o observer lá
        embaixo. Sem JavaScript ele nunca roda e a grade de resultados fica
        em branco, o oposto do que esta tela promete. */}
    <noscript><style is:inline>.vem { opacity: 1; }</style></noscript>

    <header class="abertura-busca">
      <h1 class="titulo-duplo">{t(lang, 'busca.h1.antes')}<span class="apagado">{t(lang, 'busca.h1.apagado')}</span></h1>
      <p class="apoio">
        {t(lang, 'busca.sub')}
        {' '}{t(lang, 'busca.sub.idioma')}
      </p>
    </header>

    {/* O formulário é o que se opera; a leitura acompanha, em coluna
        estreita. Abaixo de 920px ela desce, mas não some. */}
    <div class="oficina">
      <form class="forma-busca" method="get" action={rota(lang, '/buscar')} role="search"
        data-textos={JSON.stringify(textosLeitura)}>
        <div class:list={['campo', erroNoCampo && 'com-erro']}>
          <label class="rotulo" for="q">{t(lang, 'busca.campo.rotulo')}</label>
          <div class="caixa">
            <input
              class="entrada campo-grande"
              id="q"
              name="q"
              type="search"
              value={termo}
              placeholder={t(lang, 'busca.campo.exemplo')}
              maxlength="200"
              autocomplete="off"
              aria-describedby={erroNoCampo ? 'erro-q nota-acento' : 'nota-acento'}
            />
            <button class="botao enviar" type="submit">{t(lang, 'busca.botao')}</button>
          </div>
          {erroNoCampo && (
            <span class="erro-campo" id="erro-q">{erroNoCampo}</span>
          )}
        </div>

        <div class="filtros-busca">
          <div class="grupo" role="group" aria-labelledby="rotulo-idioma">
            <span class="rotulo-grupo" id="rotulo-idioma">{t(lang, 'busca.filtro.idioma')}</span>
            {IDIOMAS.map((i) => (
              <label class="opcao">
                <input type="radio" name="locale" value={i.valor} checked={idioma === i.valor}
                  data-leitura={i.texto} />
                <span class="filtro">{i.texto}</span>
              </label>
            ))}
          </div>

          <div class="grupo" role="group" aria-labelledby="rotulo-lab">
            <span class="rotulo-grupo" id="rotulo-lab">{t(lang, 'busca.filtro.lab')}</span>
            <label class="opcao">
              <input type="radio" name="lab" value="" checked={labEscolhido === ''}
                data-leitura={todosOsLabs} />
              <span class="filtro">{t(lang, 'busca.filtro.todos')}</span>
            </label>
            {labs.map((l) => (
              <label class="opcao">
                <input type="radio" name="lab" value={l.slug} checked={labEscolhido === l.slug}
                  data-leitura={nomeCurto(l)} />
                <span class="filtro">{nomeCurto(l)}</span>
              </label>
            ))}
          </div>
        </div>
      </form>

      {/* A consulta como o índice a recebe. Não tem aria-live de
          propósito: relida a cada tecla, ela viraria ruído para quem
          ouve. Quem depende do leitor de tela recebe a nota de acento
          pelo aria-describedby do campo, uma vez, no foco. */}
      <aside class="leitura">
        <p class="titulo-leitura">{t(lang, 'busca.leitura.titulo')}</p>

        {/* Só o que vira exigência entra na fila. A palavra comum não
            some da tela: ela desce pra linha de descarte logo abaixo,
            com o nome dela, porque sumir sem explicação faria a pessoa
            achar que a tela não a viu. */}
        <div class="consulta-lida">
          <div class="lexemas" id="lexemas" data-vazio={consulta.exigidas.length ? 'nao' : 'sim'}>
            {consulta.exigidas.length > 0
              ? consulta.exigidas.map((p, i) => (
                  <>
                    {i > 0 && <span class="junta">{tx('busca.leitura.junta')}</span>}
                    <span class="lexema novo" style={`--i:${i}`}>{p}</span>
                  </>
                ))
              : (
                  <span class="lexema fantasma">
                    {consulta.descartadas.length > 0
                      ? tx('busca.leitura.nada')
                      : tx('busca.leitura.fantasma')}
                  </span>
                )}
          </div>

          <p class="exige" id="exige">{fraseDaExigencia(consulta, tx)}</p>

          <p class="descartadas" id="descartadas" hidden={consulta.descartadas.length === 0}>
            <span class="rotulo-linha">{t(lang, 'busca.leitura.descartadas')}</span>
            <span class="fora" id="fora">
              {consulta.descartadas.map((p) => (
                <span class="lexema comum">{p}</span>
              ))}
            </span>
          </p>
        </div>

        <div class="linha">
          <span class="rotulo-linha">{t(lang, 'busca.leitura.dicionario')}</span>
          <b id="leitura-idioma">{nomeDoIdioma}</b>
        </div>
        <div class="linha">
          <span class="rotulo-linha">{t(lang, 'busca.leitura.recorte')}</span>
          <b id="leitura-lab">{recorte}</b>
        </div>
        <div class="linha">
          <span class="rotulo-linha">{t(lang, 'busca.leitura.peso')}</span>
          <b>{t(lang, 'busca.leitura.peso.valor')}</b>
        </div>

        <p class="nota-acento" id="nota-acento">
          {nota.map((tr) => (tr.forte ? <b>{tr.t}</b> : tr.t))}
        </p>

        <p class="nota-radical" id="nota-radical">
          {radical.map((tr) => (tr.forte ? <b>{tr.t}</b> : tr.t))}
        </p>
      </aside>
    </div>

    {caiu && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'busca.aviso.resto')}
      </p>
    )}

    {!buscou ? (
      <div class="convite vem">
        <h2 class="titulo-convite">{t(lang, 'busca.convite.rotulo')}</h2>
        <p class="apoio texto-convite">{t(lang, 'busca.convite.texto')}</p>
        {populares.length > 0 ? (
          <>
            {/* sem número: o usageCount que /tags devolve inclui rascunho e
                arquivada, então prometeria ideias que a tag não entrega. O
                uso aparece como peso, que é comparação e não promessa —
                mesmo cálculo de /tags, pra tag não mudar de peso entre as
                duas telas. */}
            <div class="nuvem-tags">
              {populares.map((tg) => (
                <a class="tag" href={rota(lang, `/tags/${tg.slug}`)}
                  data-peso={nivelDeUso(tg.usageCount, maiorUso)}>{tg.name}</a>
              ))}
            </div>
            <p class="saida">
              {t(lang, 'busca.convite.ordem')}<a href={rota(lang, '/tags')}>{t(lang, 'busca.convite.todas')}</a>
            </p>
          </>
        ) : (
          <p class="saida">
            {caiu
              ? t(lang, 'busca.convite.semtags.queda')
              : t(lang, 'busca.convite.semtags')}
            <a href={rota(lang, '/rfcs')}>{t(lang, 'busca.acao.ideias')}</a>
          </p>
        )}
      </div>
    ) : achados.length > 0 ? (
      <>
        <p class="apoio contagem">
          {t(lang, total === 1 ? 'busca.contagem.um' : 'busca.contagem.varios', { n: total })}
          {labAtual && t(lang, 'busca.contagem.lab', { lab: nomeCurto(labAtual) })}
          {t(lang, 'busca.contagem.idioma', { idioma: nomeDoIdioma })}
          {total > achados.length && t(lang, 'busca.contagem.mostrando', { n: achados.length })}
          {t(lang, 'busca.contagem.ordem')}
        </p>
        <div class="grade">
          {achados.map((a) => <CartaoIdeia rfc={paraCartao(a)} />)}
        </div>
      </>
    ) : caiu || recusada ? (
      <Vazio
        falha={caiu}
        titulo={t(lang, caiu ? 'comum.vazio.falha.titulo' : 'busca.recusada.titulo')}
        texto={t(lang, caiu ? 'busca.queda.texto' : 'busca.recusada.texto')}
      />
    ) : (
      /* Vazio.astro não recebe filho, e este caso precisa carregar a
         oferta com a palavra do acervo. Mesmas classes, então continua
         sendo o mesmo objeto na tela. */
      <div class="vazio sem-achado vem">
        <p class="chip rotulo">{t(lang, 'busca.semachado.rotulo')}</p>
        <h3>{t(lang, 'busca.semachado.titulo')}<span class="termo">{termo}</span></h3>
        <p class="texto apoio">{textoVazio}</p>

        {sugestao && (
          <a class="oferta" href={enderecoDaBusca(sugestao.termo)}>
            <span class="r">{t(lang, 'busca.oferta.rotulo')}</span>
            <span class="troca">
              <span class="de">{termo.toLowerCase()}</span>
              <span class="seta" aria-hidden="true">→</span>
              <span class="para">{sugestao.termo}</span>
            </span>
            <span class="conta">
              {t(lang, sugestao.total === 1 ? 'busca.oferta.um' : 'busca.oferta.varios', { n: sugestao.total })}
            </span>
          </a>
        )}

        <a class="botao leve" href={rota(lang, '/rfcs')}>{t(lang, 'busca.acao.ideias')}</a>
      </div>
    )}

    <Rodape />
  </div>
</Layout>

<style>
  .abertura-busca { padding: clamp(48px, 9vh, 88px) 4px 40px; display: grid; gap: 20px; }
  .abertura-busca h1 { max-width: 20ch; }
  .abertura-busca .apoio { max-width: 56ch; }

  /* o campo opera, a leitura acompanha: coluna estreita à direita.
     Abaixo de 920px ela desce, mas não some. */
  .oficina {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    align-items: start;
    margin-bottom: 56px;
  }
  @media (max-width: 920px) {
    .oficina { grid-template-columns: 1fr; gap: 32px; }
  }

  .forma-busca .campo { max-width: 680px; margin-bottom: 28px; }

  /* o campo é uma pílula grande com o botão dentro, na ponta */
  .caixa {
    position: relative;
    display: flex;
    align-items: center;
  }
  .campo-grande {
    height: 60px;
    padding: 0 132px 0 26px;
    font-size: 17px;
    letter-spacing: -0.01em;
    border-radius: var(--r-pilula);
    background: var(--rebaixo);
  }
  .campo-grande:focus-visible { outline: 2px solid var(--tinta); outline-offset: 2px; }
  .enviar {
    position: absolute;
    right: 8px;
    height: 44px;
    padding: 0 22px;
  }
  @media (max-width: 420px) {
    .campo-grande { padding-right: 112px; padding-left: 20px; }
    .enviar { padding: 0 16px; }
  }

  /* --- filtros: pílulas cinza; a escolhida fica preta.
     Radio de verdade, então sem JavaScript o botão "buscar" aplica. --- */
  .filtros-busca { display: grid; gap: 20px; max-width: 680px; }
  .grupo { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .rotulo-grupo { font-size: 12.5px; color: var(--t-65); width: 100%; margin-bottom: 2px; }
  .opcao { display: inline-flex; }
  .opcao input { position: absolute; opacity: 0; width: 0; height: 0; }
  .opcao .filtro {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    font-size: 13.5px;
    background: var(--color-chip);
    color: var(--t-100);
    cursor: pointer;
  }
  .opcao .filtro:hover { background: var(--t-12); }
  .opcao input:checked + .filtro { background: var(--tinta); color: #fff; }
  .opcao input:focus-visible + .filtro { outline: 2px solid var(--tinta); outline-offset: 3px; }

  /* --- a consulta como o índice a recebe: cinza, sem fio, sem sombra --- */
  .leitura {
    padding: 24px 24px 26px;
    background: var(--rebaixo);
    border-radius: var(--r-fora);
  }
  .titulo-leitura { margin: 0 0 16px; font-size: 13px; font-weight: 500; color: var(--t-100); }

  .lexemas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    margin-bottom: 12px;
  }
  .lexema {
    font-size: 12.5px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--r-pilula);
    background: var(--cartao);
    color: var(--t-100);
    overflow-wrap: anywhere;
  }
  .lexema.fantasma { background: transparent; box-shadow: inset 0 0 0 1px var(--t-12); color: var(--t-50); font-weight: 400; }
  /* a palavra descartada tem a forma da exigida e o corpo esvaziado */
  .lexema.comum { background: transparent; box-shadow: inset 0 0 0 1px var(--t-12); color: var(--t-50); font-weight: 400; }
  .junta { font-size: 12px; color: var(--t-50); }

  /* o que a consulta virou fica num bloco só, e o corte vem depois
     dele: a linha de descarte entra e sai conforme a pessoa escreve */
  .consulta-lida {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--t-12);
  }
  .exige { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--t-65); }

  .descartadas { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
  .descartadas[hidden] { display: none; }
  .descartadas .fora { display: flex; flex-wrap: wrap; gap: 6px; }

  .leitura .linha { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; font-size: 12.5px; }
  .leitura .rotulo-linha { color: var(--t-50); flex-shrink: 0; }
  .leitura .linha b { text-align: right; font-weight: 500; color: var(--t-100); }

  .nota-acento {
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--t-12);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--t-65);
  }
  .nota-acento b, .nota-radical b { font-weight: 500; color: var(--t-100); }
  .nota-radical { margin: 10px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--t-50); }

  .contagem { padding: 0 4px 24px; max-width: none; }

  /* --- convite: primeira visita --- */
  .convite { padding: 0 4px 24px; }
  .titulo-convite {
    margin: 0 0 12px;
    font-size: var(--text-titulo-sm);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--t-100);
  }
  .texto-convite { margin: 0 0 32px; max-width: 52ch; }
  .saida { margin: 28px 0 0; font-size: 13px; color: var(--t-50); }
  .saida a { color: var(--t-65); text-decoration: underline; text-decoration-color: var(--t-35); text-underline-offset: 3px; }
  .saida a:hover { color: var(--t-100); }
  .saida a:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; border-radius: 4px; }

  /* peso da tag = uso, igual em /tags: só tamanho e tom. Duplicado da
     outra tela porque a global.css é território compartilhado. */
  .convite .nuvem-tags { gap: 8px; }
  .convite .tag {
    height: auto;
    min-height: 40px;
    padding: 0 18px;
    font-size: 14px;
    background: var(--color-chip);
    color: var(--t-75);
  }
  .tag[data-peso="3"] { font-size: 19px; padding: 0 22px; color: var(--t-100); }
  .tag[data-peso="2"] { font-size: 16px; color: var(--t-100); }
  .tag[data-peso="1"] { background: var(--t-07); }
  .tag[data-peso="0"] { background: transparent; box-shadow: inset 0 0 0 1px var(--t-12); color: var(--t-50); }
  .tag[data-peso]:hover { background: var(--tinta); color: #fff; box-shadow: none; }
  .tag:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; }

  /* --- não achou --- */
  .sem-achado .termo { color: var(--t-35); overflow-wrap: anywhere; }
  .sem-achado .texto { margin-bottom: 24px; }

  /* a oferta é o objeto: a troca de palavra e o que ela devolve */
  .oferta {
    display: flex;
    width: fit-content;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 0 auto 24px;
    padding: 18px 26px 20px;
    border-radius: var(--r-dentro);
    background: var(--rebaixo);
    text-decoration: none;
    color: inherit;
  }
  .oferta:hover { background: var(--t-07); }
  .oferta:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; }
  .oferta .r { font-size: 12px; color: var(--t-50); text-align: center; }
  .oferta .troca { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: center; gap: 12px; font-size: 15px; font-weight: 500; }
  .oferta .de { color: var(--t-35); text-decoration: line-through; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .oferta .seta { color: var(--t-35); }
  .oferta .para { color: var(--t-100); background: var(--color-chip); padding: 4px 12px; border-radius: var(--r-pilula); overflow-wrap: anywhere; }
  .oferta .conta { font-size: 12.5px; color: var(--t-65); }
</style>

<script>
  import {
    fraseDaExigencia, lerConsulta, notaDeAcento, notaDoRadical, tradutorDe,
    type Idioma, type Trecho,
  } from '../lib/leitura-busca';

  document.addEventListener('astro:page-load', () => {
    const forma = document.querySelector<HTMLFormElement>('.forma-busca');

    /* ---------- a leitura se remonta a cada tecla ----------
       Mesmas funções que o servidor usou pra montar o HTML inicial,
       importadas do mesmo módulo. Se divergissem, a leitura mentiria
       enquanto a pessoa digita e só acertaria depois de enviar. */
    function ligarLeitura() {
      const campo = document.querySelector<HTMLInputElement>('#q');
      const caixa = document.querySelector<HTMLElement>('#lexemas');
      const exige = document.querySelector<HTMLElement>('#exige');
      const descartadas = document.querySelector<HTMLElement>('#descartadas');
      const fora = document.querySelector<HTMLElement>('#fora');
      const nota = document.querySelector<HTMLElement>('#nota-acento');
      const radical = document.querySelector<HTMLElement>('#nota-radical');
      if (!campo || !caixa || !exige || !descartadas || !fora || !nota || !radical) return;
      /* As frases da leitura chegam resolvidas no idioma da interface,
         num data-attribute: o navegador não carrega os dicionários. */
      let textos: Record<string, string> = {};
      try { textos = JSON.parse(forma?.dataset.textos ?? '{}'); } catch { /* sem textos: mostra a chave */ }
      const tx = tradutorDe(textos);

      /* O dicionário escolhido decide quais palavras são descartadas e
         quais exemplos as notas usam, então a leitura precisa do rádio
         marcado agora, não do que veio na querystring. */
      const idiomaAtual = (): Idioma =>
        forma?.querySelector<HTMLInputElement>('input[name="locale"]:checked')?.value === 'en'
          ? 'en'
          : 'pt-BR';

      const emTrechos = (trechos: Trecho[]) =>
        trechos.map((trecho) => {
          if (!trecho.forte) return document.createTextNode(trecho.t);
          const forte = document.createElement('b');
          forte.textContent = trecho.t;
          return forte;
        });

      const pilula = (classe: string, texto: string) => {
        const span = document.createElement('span');
        span.className = classe;
        span.textContent = texto;
        return span;
      };

      /* Quantas palavras já estavam na tela. Só o que passa desta conta
         nasce com a classe que anima. */
      let quantasAntes = lerConsulta(campo.value, idiomaAtual()).exigidas.length;

      const remontar = () => {
        const idioma = idiomaAtual();
        const consulta = lerConsulta(campo.value, idioma);

        caixa.dataset.vazio = consulta.exigidas.length ? 'nao' : 'sim';
        caixa.replaceChildren(
          ...(consulta.exigidas.length
            ? consulta.exigidas.flatMap((p, i) => {
                const lexema = pilula(i >= quantasAntes ? 'lexema novo' : 'lexema', p);
                lexema.style.setProperty('--i', '0');
                if (i === 0) return [lexema];
                return [pilula('junta', tx('busca.leitura.junta')), lexema];
              })
            : [pilula(
                'lexema fantasma',
                consulta.descartadas.length ? tx('busca.leitura.nada') : tx('busca.leitura.fantasma'),
              )]),
        );
        quantasAntes = consulta.exigidas.length;

        exige.textContent = fraseDaExigencia(consulta, tx);

        descartadas.hidden = consulta.descartadas.length === 0;
        fora.replaceChildren(...consulta.descartadas.map((p) => pilula('lexema comum', p)));

        nota.replaceChildren(...emTrechos(notaDeAcento(campo.value, idioma, tx)));
        radical.replaceChildren(...emTrechos(notaDoRadical(idioma, tx)));
      };

      campo.addEventListener('input', remontar);

      /* O rádio recarrega a página no clique, mas a seta do teclado só
         marca a opção. Sem isto, quem percorre os labs pelo teclado
         veria a leitura falando do recorte anterior. */
      if (forma) {
        for (const radio of forma.querySelectorAll<HTMLInputElement>('.opcao input')) {
          radio.addEventListener('change', () => {
            const alvo = radio.name === 'locale' ? '#leitura-idioma' : '#leitura-lab';
            const destino = document.querySelector<HTMLElement>(alvo);
            if (destino && radio.dataset.leitura) destino.textContent = radio.dataset.leitura;
            /* Trocar de dicionário troca o que é palavra comum e os
               exemplos das notas. Sem remontar, a coluna descreveria o
               índice anterior. */
            if (radio.name === 'locale') remontar();
          });
        }
      }
    }

    /* Trocar o laboratório ou o idioma reenvia na hora. É melhoria
       progressiva: sem isso o botão "buscar" faz o mesmo.

       Só clique de ponteiro reenvia. Num grupo de radios a seta já marca
       a opção enquanto percorre, então reenviar no `change` recarregaria
       a página a cada tecla e jogaria o foco pro topo — quem navega por
       teclado nunca chegaria no sexto lab. `detail` vem 0 no clique
       sintético do teclado; nesse caminho o "buscar" é quem envia. */
    if (forma) {
      for (const radio of forma.querySelectorAll<HTMLInputElement>('.opcao input')) {
        radio.addEventListener('click', (e) => {
          if ((e as MouseEvent).detail > 0) forma.requestSubmit();
        });
      }
    }

    ligarLeitura();

    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  });
</script>
