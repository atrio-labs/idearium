---
/* ================================================================
   /tags/:slug — as ideias marcadas com uma tag (F5)
   ================================================================
   SSR e não getStaticPaths, de propósito.

   Lab é catálogo fechado e semeado: getStaticPaths cabe lá. Tag é o
   contrário — nasce no instante em que alguém salva POST /rfcs/:id/tags,
   sem passar por deploy. Com rota estática, a tag criada depois do build
   devolveria 404 até o próximo build, e quem acabou de criá-la veria a
   página quebrada logo depois de publicar a ideia. Uma tela que custa
   uma consulta por acesso é preço menor que esse buraco.

   ----------------------------------------------------------------
   DESENHO: a tela mostra a consequência do ato
   ----------------------------------------------------------------
   A promessa de /tags é que a tag atravessa laboratórios. Esta tela é
   onde a promessa se cumpre ou não, então o cabeçalho mostra os labs
   que ela de fato atravessa, contados nas ideias que estão logo abaixo
   — não uma frase dizendo que isso acontece.

   É também o único lugar onde as duas contagens de tag existem juntas:
   `tag.usageCount` conta toda RFC ligada, inclusive rascunho e
   arquivada; `rfcs.meta.total` conta só as públicas. Em vez de esconder
   a diferença (que é o que /tags faz, por não ter as duas), aqui ela é
   dita: o número que falta é rascunho ou arquivada.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import CartaoIdeia from '../../components/astro/CartaoIdeia.astro';
import Vazio from '../../components/astro/Vazio.astro';
import { nomeDoLab, chamarApi, type Autor, type LabResumo, type Pagina, type RfcStatus } from '../../lib/api';
import { t, rota, idiomaDe } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

/* A api.ts ainda não expõe /tags/:slug, então a chamada mora aqui, mas
   passa por `chamarApi` pra mandar o x-lang da requisição. Mesmo
   contrato: nunca lança, e separa tag inexistente de servidor mudo. */
const lang = idiomaDe(Astro);

interface TagCheia {
  id: string;
  slug: string;
  name: string;
  createdAt: string;
  usageCount: number;
}

/* A API monta esta listagem com um SELECT próprio: traz createdAt, mas
   não updatedAt nem a contagem de versões. */
interface RfcDaTag {
  id: string;
  number: number | null;
  slug: string;
  title: string;
  summary: string;
  locale: string;
  status: RfcStatus;
  publishedAt: string | null;
  createdAt: string;
  author: Autor;
  lab: LabResumo;
}

const { slug } = Astro.params;

let tag: TagCheia | null = null;
let rfcs: RfcDaTag[] = [];
let total = 0;
let caiu = false;

const r = await chamarApi<{ tag: TagCheia; rfcs: Pagina<RfcDaTag> }>(
  `/tags/${encodeURIComponent(slug!)}?limit=100`,
);
if (r.dado) {
  tag = r.dado.tag;
  rfcs = r.dado.rfcs.data;
  total = r.dado.rfcs.meta.total;
} else if (r.status !== 404) {
  caiu = true;
}

/* Tag que não existe é 404 de verdade, não uma página vazia com 200:
   buscador e leitor de feed precisam do código certo. */
if (!tag && !caiu) Astro.response.status = 404;

const titulo = tag?.name ?? slug;

/* Os labs que a tag atravessa, contados nas ideias desta página. Se
   houver mais ideias do que as 100 que vieram, a conta é do que está
   à vista, e o rótulo diz isso: número que parece do acervo inteiro e
   é de um recorte vira chute com cara de fato. */
const atravessa = [...rfcs.reduce((mapa, r) => {
  const antes = mapa.get(r.lab.slug);
  mapa.set(r.lab.slug, { lab: r.lab, quantas: (antes?.quantas ?? 0) + 1 });
  return mapa;
}, new Map<string, { lab: LabResumo; quantas: number }>()).values()]
  .sort((a, b) => b.quantas - a.quantas);

/* A diferença entre as duas contagens tem nome: rascunho ou arquivada.
   Só existe quando a listagem cabe inteira na página, senão eu estaria
   subtraindo um recorte de uma soma. */
const fora = rfcs.length === total ? Math.max(0, (tag?.usageCount ?? 0) - total) : 0;
cachePublico(Astro, caiu);
---

<Layout
  title={t(lang, 'tags.slug.titulo', { nome: titulo ?? '' })}
  description={t(lang, 'tags.slug.descricao', { nome: titulo ?? '' })}
>
  <div class="palco">
    <Nav />

    {/* .vem nasce com opacity 0 e quem devolve a opacidade é o observer lá
        embaixo. Sem JavaScript ele nunca roda e a grade fica em branco. */}
    <noscript><style is:inline>.vem { opacity: 1; }</style></noscript>

    <header class="abertura-tag">
      <a class="volta" href={rota(lang, '/tags')}>{t(lang, 'tags.slug.volta')}</a>

      <h1 class="titulo-duplo">{titulo}{tag && <>{' '}<span class="apagado">{t(lang, 'tags.slug.h1.apagado')}</span></>}</h1>

      {tag && <p class="apoio">{t(lang, 'tags.slug.sub')}</p>}

      {tag && atravessa.length > 0 && (
        <div class="atravessa">
          <span class="apoio r">
            {t(lang, 'tags.slug.atravessa')}{total > rfcs.length && t(lang, 'tags.slug.atravessa.recorte', { n: rfcs.length })}
          </span>
          {atravessa.map((a) => (
            <span class="chip">
              {nomeDoLab(a.lab, lang)}
              <span class="quantas">{a.quantas}</span>
            </span>
          ))}
          {atravessa.length === 1 && (
            <span class="apoio">{t(lang, 'tags.slug.umlab')}</span>
          )}
        </div>
      )}
    </header>

    {caiu && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'tags.slug.aviso.resto')}
      </p>
    )}

    {tag && rfcs.length > 0 && (
      <p class="apoio contagem">
        {t(lang, total === 1 ? 'tags.slug.contagem.um' : 'tags.slug.contagem.varios', { n: total })}
        {total > rfcs.length && t(lang, 'tags.slug.contagem.mostrando', { n: rfcs.length })}
        {fora > 0 && (fora === 1
          ? t(lang, 'tags.slug.fora.um')
          : t(lang, 'tags.slug.fora.varios', { n: fora }))}
        {' · '}<a href={rota(lang, `/buscar?q=${encodeURIComponent(titulo ?? '')}`)}>{t(lang, 'tags.slug.procurar')}</a>
      </p>
    )}

    {tag && rfcs.length > 0 ? (
      <div class="grade">
        {/* updatedAt não vem nesta rota e CartaoIdeia não usa; createdAt
            preenche o campo pra não inventar outra data. */}
        {rfcs.map((r) => <CartaoIdeia rfc={{ ...r, updatedAt: r.createdAt }} />)}
      </div>
    ) : caiu ? (
      <Vazio
        falha
        titulo={t(lang, 'comum.vazio.falha.titulo')}
        texto={t(lang, 'tags.slug.queda.texto')}
      />
    ) : !tag ? (
      <Vazio
        titulo={t(lang, 'tags.slug.inexistente.titulo', { slug: slug ?? '' })}
        texto={t(lang, 'tags.slug.inexistente.texto')}
        acaoHref={rota(lang, '/tags')}
        acaoTexto={t(lang, 'tags.slug.inexistente.acao')}
      />
    ) : (
      <Vazio
        titulo={t(lang, 'tags.slug.vazia.titulo', { nome: titulo ?? '' })}
        texto={t(lang, 'tags.slug.vazia.texto')}
        acaoHref={rota(lang, '/tags')}
        acaoTexto={t(lang, 'tags.slug.vazia.acao')}
      />
    )}

    <Rodape />
  </div>
</Layout>

<style>
  .abertura-tag { padding: clamp(40px, 8vh, 72px) 4px 40px; display: grid; gap: 20px; justify-items: start; }
  .abertura-tag h1 { max-width: 20ch; overflow-wrap: anywhere; }
  .volta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 13px;
    color: var(--t-65);
    text-decoration: none;
  }
  .volta:hover { color: var(--t-100); }
  .volta:focus-visible,
  .contagem a:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; border-radius: 4px; }

  /* os labs que a tag atravessa: chips cinza, sem cor por lab. A
     contagem por lab é navegação, diz onde vale entrar */
  .atravessa { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .atravessa .r { margin-right: 4px; }
  .atravessa .quantas { color: var(--t-50); }

  .contagem { padding: 0 4px 24px; }
  .contagem a { color: var(--t-65); text-decoration: underline; text-decoration-color: var(--t-35); text-underline-offset: 3px; }
  .contagem a:hover { color: var(--t-100); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  });
</script>
