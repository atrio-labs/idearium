---
/* ================================================================
   /tags — todas as tags, por uso (F5)
   ================================================================
   SSR, não pré-renderizada. Tag não é catálogo fechado como lab: ela
   nasce no momento em que alguém escreve POST /rfcs/:id/tags. Uma
   lista congelada em build ficaria desatualizada no primeiro uso.

   ----------------------------------------------------------------
   DESENHO: a tela mostra a consequência do ato
   ----------------------------------------------------------------
   O ato é navegar por vocabulário. A consequência é que este
   vocabulário não foi decidido por ninguém: ele é o resíduo do que as
   pessoas escreveram. A tela precisa deixar isso legível, e o jeito
   de mostrar em vez de afirmar é o PESO — quanto mais ideias a tag
   marca, maior e mais escura ela fica. O que se lê não é uma lista alfabética
   de rótulos aprovados: é uma superfície irregular, e a irregularidade
   é o uso.

   O peso vem de tamanho e tom, em passos pequenos. Nuvem de tag dos
   anos 2000 aumentava a fonte até a palavra virar ilustração ilegível.

   A tag continua aparecendo SEM NÚMERO. O `usageCount` que /tags
   devolve conta toda RFC ligada à tag, inclusive rascunho e
   arquivada, enquanto /tags/:slug só lista as públicas: o número
   prometeria ideias que o link não entrega. Peso é comparação, não
   promessa — por isso ele pode usar a mesma contagem que o número não
   pode. A conta honrada aparece em /tags/:slug, onde as duas
   contagens existem lado a lado e podem ser reconciliadas.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import Vazio from '../../components/astro/Vazio.astro';
import { chamarApi, type Pagina } from '../../lib/api';
import { t, rota, idiomaDe } from '../../lib/i18n';
import { nivelDeUso } from '../../lib/peso-tag';
import { cachePublico } from '../../lib/cache';

/* A api.ts ainda não expõe /tags, então a chamada mora aqui, mas passa
   por `chamarApi` pra mandar o x-lang da requisição. Mesmo contrato:
   nunca lança, e separa "não há tag" de "servidor mudo". */
const lang = idiomaDe(Astro);

interface TagResumo {
  id: string;
  slug: string;
  name: string;
  createdAt: string;
  usageCount: number;
}

/* Teto do PaginationQueryDto. A lista vem ordenada por uso, então o que
   sobra além disso é a cauda menos usada; quando o acervo passar de 100
   tags, esta tela precisa de paginação de verdade. */
const LIMITE_API = 100;

let tags: TagResumo[] = [];
let total = 0;
let caiu = false;

const r = await chamarApi<Pagina<TagResumo>>(`/tags?limit=${LIMITE_API}`);
if (r.dado) {
  tags = r.dado.data;
  total = r.dado.meta.total;
} else {
  caiu = true;
}

/* A lista chega ordenada por uso decrescente, então a primeira é o
   topo da escala. O peso é relativo a ela: o acervo é novo e "marca
   duas ideias" é o máximo que existe hoje. */
const maiorUso = tags[0]?.usageCount ?? 0;
const temOrfas = tags.some((tg) => tg.usageCount === 0);
cachePublico(Astro, caiu);
---

<Layout
  title={t(lang, 'tags.titulo')}
  description={t(lang, 'tags.descricao')}
>
  <div class="palco">
    <Nav />

    {/* .vem nasce com opacity 0 e quem devolve a opacidade é o observer lá
        embaixo. Sem JavaScript ele nunca roda e o painel inteiro some. */}
    <noscript><style is:inline>.vem { opacity: 1; }</style></noscript>

    <header class="abertura-tags">
      <h1 class="titulo-duplo">{t(lang, 'tags.h1.antes')}<span class="apagado">{t(lang, 'tags.h1.apagado')}</span></h1>
      <p class="apoio">{t(lang, 'tags.sub')}</p>
    </header>

    {caiu && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'tags.aviso.resto')}
      </p>
    )}

    {tags.length > 0 ? (
      <>
        <p class="apoio contagem">
          {t(lang, total === 1 ? 'tags.contagem.um' : 'tags.contagem.varios', { n: total })}
          {total > tags.length && t(lang, 'tags.contagem.mostrando', { n: tags.length })}
        </p>

        <div class="painel-tags vem">
          <p class="apoio origem">{t(lang, 'tags.origem')}</p>

          <div class="nuvem-tags">
            {tags.map((tg) => (
              <a
                class="tag"
                href={rota(lang, `/tags/${tg.slug}`)}
                data-peso={nivelDeUso(tg.usageCount, maiorUso)}
              >{tg.name}</a>
            ))}
          </div>

          {/* A tinta mede o que o servidor conta, e o servidor conta
              rascunho e arquivada. Dizer isso aqui é mais barato que
              deixar a pessoa descobrir clicando numa palavra escura e
              caindo numa página vazia. */}
          <p class="apoio escala">
            {t(lang, 'tags.escala')}
            {temOrfas && t(lang, 'tags.escala.orfas')}
          </p>
        </div>
      </>
    ) : (
      <Vazio
        falha={caiu}
        titulo={t(lang, caiu ? 'comum.vazio.falha.titulo' : 'tags.vazio.titulo')}
        texto={t(lang, caiu ? 'tags.queda.texto' : 'tags.vazio.texto')}
        acaoHref={caiu ? undefined : rota(lang, '/rfcs')}
        acaoTexto={caiu ? undefined : t(lang, 'tags.acao.ideias')}
      />
    )}

    <Rodape />
  </div>
</Layout>

<style>
  .abertura-tags { padding: clamp(48px, 9vh, 88px) 4px 40px; display: grid; gap: 20px; }
  .abertura-tags h1 { max-width: 22ch; }

  .contagem { padding: 0 4px 24px; }

  .painel-tags { padding: 0 4px 24px; }
  .origem { margin: 0 0 32px; }

  /* O peso é só tipográfico: tamanho e tom. A palavra mais usada fica
     maior e mais escura; a que nenhuma ideia usa perde o fundo. Chip
     cinza em todos os níveis, altura mínima de 40px pra alvo de toque. */
  .painel-tags .nuvem-tags { gap: 8px; align-items: center; }
  .painel-tags .tag {
    height: auto;
    min-height: 40px;
    padding: 0 18px;
    font-size: 14px;
    letter-spacing: -0.01em;
    background: var(--color-chip);
    color: var(--t-75);
  }
  .tag[data-peso="3"] { font-size: 19px; padding: 0 22px; color: var(--t-100); }
  .tag[data-peso="2"] { font-size: 16px; color: var(--t-100); }
  .tag[data-peso="1"] { background: var(--t-07); }
  .tag[data-peso="0"] { background: transparent; box-shadow: inset 0 0 0 1px var(--t-12); color: var(--t-50); }
  /* o seletor de atributo pesa mais que o :hover da global.css; sem
     esta regra a nuvem inteira perderia o retorno de hover */
  .tag[data-peso]:hover { background: var(--tinta); color: #fff; box-shadow: none; }
  .tag:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; }

  .escala { margin: 32px 0 0; color: var(--t-50); max-width: 60ch; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  });
</script>
