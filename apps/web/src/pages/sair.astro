---
/* ================================================================
   /sair — encerra a sessão de verdade (F2.3)
   ================================================================
   GET só pergunta; quem executa é o POST. Não é cerimônia: o app
   renderiza texto escrito por gente, e um <img src="/sair"> dentro de
   um comentário é requisição da própria origem — o cookie iria junto e
   a pessoa seria deslogada por um estranho. Com POST isso não acontece,
   e o cookie sameSite=lax ainda barra POST vindo de fora.

   Sair aqui não é só apagar cookie: o refresh token precisa ser revogado
   no servidor, senão ele valeria mais 30 dias depois do "sair".
   ================================================================ */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/astro/Nav.astro';
import Rodape from '../components/astro/Rodape.astro';
import { sair } from '../lib/sessao';
import { idiomaDe, rota, t } from '../lib/i18n';

const lang = idiomaDe(Astro);
const usuario = Astro.locals.usuario;
let falhaRevogacao: string | null = null;

if (Astro.request.method === 'POST') {
  /* sair() limpa o cookie de qualquer jeito e devolve se a revogação no
     servidor deu certo. Só redireciono anunciando sucesso quando deu:
     sem revogação o refresh token vive mais 30 dias, e dizer "pronto"
     seria mentira em máquina compartilhada. */
  const { revogado } = await sair(Astro.cookies);
  if (revogado) return Astro.redirect(rota(lang, '/'));
  falhaRevogacao = t(lang, 'conta.sair.falha');
}

/* Sem sessão não há o que encerrar, e a pergunta ficaria sem sentido.
   O aviso de falha é a exceção: ele existe justamente depois de limpar. */
if (!usuario && !falhaRevogacao) return Astro.redirect(rota(lang, '/'));
---

<Layout title={t(lang, 'conta.sair.titulo')} description={t(lang, 'conta.sair.descricao')}>
  <div class="palco pagina-conta">
    <Nav />

    <div class="sair">
      {falhaRevogacao ? (
        <Fragment>
          {/* o aviso nasce depois de um POST, que recarrega a página inteira:
              leitor de tela não anuncia texto que já veio pronto, então o
              foco vai pra ele */}
          <p class="aviso-erro" role="alert" tabindex="-1" autofocus>
            {falhaRevogacao}
          </p>

          <h1 class="titulo-duplo">{t(lang, 'conta.sair.falha.h1.antes')}<span class="apagado">{t(lang, 'conta.sair.falha.h1.serif')}{t(lang, 'conta.sair.falha.h1.depois')}</span></h1>
          <p class="apoio">
            {t(lang, 'conta.sair.falha.sub.antes')}@{usuario?.username}{t(lang, 'conta.sair.falha.sub.depois')}
          </p>

          <div class="acoes-form">
            <a class="botao" href={rota(lang, '/')}>{t(lang, 'conta.sair.falha.inicio')}</a>
            <a class="botao-secundario" href={rota(lang, '/entrar')}>{t(lang, 'conta.sair.falha.entrar')}</a>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="titulo-duplo">{t(lang, 'conta.sair.h1.antes')}<span class="apagado">@{usuario?.username}{t(lang, 'conta.sair.h1.depois')}</span></h1>
          <p class="apoio">{t(lang, 'conta.sair.sub')}</p>

          <form method="POST" action={rota(lang, '/sair')}>
            <div class="acoes-form">
              <button class="botao" type="submit">{t(lang, 'conta.sair.botao.sair')}</button>
              <a class="botao-secundario" href={rota(lang, '/')}>{t(lang, 'conta.sair.botao.ficar')}</a>
            </div>
          </form>
        </Fragment>
      )}
    </div>

    <Rodape />
  </div>
</Layout>

<style>
  .sair { max-width: 460px; margin: 0 auto; padding: 72px 0 96px; }
  .sair .apoio { margin-top: 16px; }
  .sair .aviso-erro { margin-bottom: 32px; }
  .sair .acoes-form { margin-top: 32px; }
</style>
