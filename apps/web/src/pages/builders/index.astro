---
/* ================================================================
   /builders — quem topa construir (F2)
   ================================================================
   Lista pública de quem marcou que está disponível pra construir.
   Quem desmarcou o "estou disponível" em /perfil sai daqui: a lista
   promete disponibilidade no título, então publicar alguém que disse
   o contrário seria falar por ela (VISAO §5.2).

   É o único lugar do produto onde pessoas aparecem em lista, então
   ele carrega um risco próprio: lista de gente vira ranking sozinha,
   se a gente deixar. Duas defesas, ambas deliberadas (VISAO §9):

     1. Nenhuma contagem por pessoa. Nada de "12 ideias", "3 em
        construção". Só o que a própria pessoa escreveu sobre si.
     2. Nenhuma ordenação por atividade. A API devolve por updatedAt
        e é isso que fica — e o cabeçalho da lista diz qual é a ordem,
        pra ninguém ler posição como mérito.

   SSR, não pré-renderizada: perfil novo precisa aparecer sem esperar
   o próximo build. A página não depende de sessão, só de ser fresca.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import Vazio from '../../components/astro/Vazio.astro';
import CartaoMao from '../../components/astro/CartaoMao.astro';
import { LIMITE_API, chamarApi, obterPerfil, type Autor, type Pagina } from '../../lib/api';
import { t, rota, idiomaDe } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

interface Builder {
  user: Autor;
  headline: string | null;
  topics: string[];
  isOpenToWork: boolean;
  updatedAt: string;
}

const lang = idiomaDe(Astro);

const TETO_PAGINAS = 20;               // trava contra paginação infinita

let semRede = false;
let truncada = false;

/* Percorre a paginação inteira. Sumir da lista por causa do limite da
   página 1 seria pior que uma chamada a mais: a pessoa preencheu o
   perfil e não se encontra nele.

   `isOpenToWork=true` é obrigatório na query: o filtro do BuildersService
   só entra quando o parâmetro chega, e o default do Swagger não vale em
   runtime. Sem ele a lista inclui quem desmarcou a disponibilidade. */
async function listarMaos(): Promise<Builder[]> {
  const todos: Builder[] = [];
  for (let page = 1; ; page++) {
    /* `chamarApi` manda o x-lang e nunca lança: rede fora vem como status 0. */
    const r = await chamarApi<Pagina<Builder>>(
      `/builders?isOpenToWork=true&page=${page}&limit=${LIMITE_API}`,
    );
    if (!r.dado) { semRede = true; break; }
    todos.push(...r.dado.data);
    if (page >= r.dado.meta.totalPages || r.dado.data.length === 0) break;
    if (page >= TETO_PAGINAS) { truncada = true; break; }
  }
  return todos;
}

const maos = await listarMaos();

/* Só dá pra afirmar um número quando a varredura terminou inteira.
   Lista cortada no meio com "N pessoas" em cima vira número errado. */
const contagemConfiavel = !semRede && !truncada;

/* Convite pra preencher o próprio: é a outra metade de /perfil, onde
   o cartão se monta enquanto se digita. Some pra quem já está na
   lista — pra essa pessoa o convite seria ruído. */
const usuario = Astro.locals?.usuario ?? null;
const jaEstaNaLista = usuario != null && maos.some((m) => m.user.username === usuario.username);

/* Faltar na lista tem duas causas diferentes, e o convite só serve pra
   uma. Quem escreveu o cartão e só desmarcou a disponibilidade some
   desta consulta (ela filtra por isOpenToWork), e receberia um "escreva
   uma linha sobre você" pedindo o que já está escrito. A sessão não
   carrega o builderProfile, então a separação custa uma leitura do
   próprio perfil público — e só nesse caso. */
const soPausado =
  usuario != null && !jaEstaNaLista
    ? (await obterPerfil(usuario.username))?.builderProfile != null
    : false;

cachePublico(Astro, semRede);
---

<Layout
  title={t(lang, 'builders.titulo')}
  description={t(lang, 'builders.descricao')}
>
  <div class="palco">
    <Nav atual="builders" />

    <header class="cabecalho-pagina">
      <span class="mono rotulo-lista">{t(lang, 'builders.rotulo')}</span>
      <h1>{t(lang, 'builders.h1.antes')}<span class="serif">{t(lang, 'builders.h1.serif')}</span>{t(lang, 'builders.h1.depois')}</h1>
      <p class="sub">{t(lang, 'builders.sub')}</p>
    </header>

    {semRede && (
      <p class="aviso-api">
        <b>{t(lang, 'comum.api.aviso')}</b> {t(lang, 'builders.aviso.resto')}
      </p>
    )}

    {maos.length > 0 && (
      <div class="linha-lista">
        <p class="contagem">
          {/* uma string só: entre duas interpolações o espaço se perde */}
          {contagemConfiavel && t(lang, maos.length === 1 ? 'builders.contagem.um' : 'builders.contagem.varios', { n: maos.length })}
          {t(lang, 'builders.contagem.ordem')}
        </p>
        {/* A regra dita em voz alta pra ninguém ler posição como mérito */}
        <p class="contagem regra">
          {t(lang, 'builders.regra')}
        </p>
      </div>
    )}

    {/* Marca o documento antes de a grade existir: a entrada animada só
        pode esconder o cartão se houver JS depois pra revelá-lo. */}
    <script is:inline>document.documentElement.classList.add('com-js');</script>

    {maos.length > 0 ? (
      <div class="grade-builders">
        {maos.map((m) => (
          <CartaoMao
            entrada
            username={m.user.username}
            headline={m.headline}
            topics={m.topics}
            isOpenToWork={m.isOpenToWork}
            href={rota(lang, `/users/${m.user.username}`)}
          />
        ))}

        {/* O vão da lista: o cartão que falta é o de quem está olhando.
            Em /perfil ele se monta enquanto a pessoa escreve — ou volta
            inteiro, se o que faltou foi só marcar a disponibilidade. */}
        {!jaEstaNaLista && (
          <a class="builder-card slot" href={rota(lang, '/perfil')}>
            <span class="mono marca-slot">
              {t(lang, soPausado ? 'builders.slot.pausado.marca' : 'builders.slot.novo.marca')}
            </span>
            <p class="frase">
              {t(lang, soPausado ? 'builders.slot.pausado.frase' : 'builders.slot.novo.frase')}
            </p>
            <span class="chip pequeno oco">
              {t(lang, soPausado ? 'builders.slot.pausado.acao' : 'builders.slot.novo.acao')} &rarr;
            </span>
          </a>
        )}
      </div>
    ) : (
      <Vazio
        falha={semRede}
        titulo={t(lang, semRede ? 'comum.vazio.falha.titulo' : 'builders.vazio.titulo')}
        texto={t(lang, semRede ? 'builders.queda.texto' : 'builders.vazio.texto')}
        acaoHref={semRede ? undefined : rota(lang, '/perfil')}
        acaoTexto={semRede ? undefined : t(lang, 'builders.vazio.acao')}
      />
    )}

    <Rodape />
  </div>
</Layout>

<style>
  /* A defesa do `.vem` sem JS mora no próprio CartaoMao.astro: a regra
     precisa alcançar o cartão, que agora é componente. */

  .rotulo-lista {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--t-35);
  }

  /* o rodapé encostava na última fileira de cartões */
  .grade-builders { margin-bottom: 18px; }

  .linha-lista {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .linha-lista .contagem { padding-bottom: 14px; margin: 0; }
  .linha-lista .regra { color: var(--t-50); }

  /* o vão: mesma geometria do cartão, sem a matéria do cartão */
  .slot {
    background: transparent;
    box-shadow: none;
    outline: 1px dashed var(--t-12);
    outline-offset: -1px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    justify-content: center;
    min-height: 148px;
  }
  .slot:hover {
    background: var(--cartao);
    outline-color: transparent;
    box-shadow: var(--sombra);
  }
  .marca-slot {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--t-50);
  }
  .slot .frase { margin: 0; font-size: 13.5px; color: var(--t-65); }
  .slot .oco {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--t-12);
    color: var(--t-65);
  }
  .slot:hover .oco { background: var(--t-07); box-shadow: none; color: var(--t-90); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  });
</script>
