---
/* ================================================================
   /users/:username — perfil público (F1.5)
   ================================================================
   Pseudônimo por padrão (VISAO §5.3): o @username é o identificador
   canônico, e fullName/bio são opcionais. A página não pede nem exibe
   nada além do que a pessoa escolheu preencher.

   Nada de métrica de vaidade aqui (VISAO §9): sem seguidores, sem
   visualizações de perfil, sem contagem que exista pra impressionar.
   O que aparece é trabalho: o que escreveu e onde está construindo.

   SSR: serve qualquer usuário que a API conheça, não só quem já
   escreveu uma RFC. Username desconhecido é 404 com a tela de vazio;
   API fora é 503.
   ================================================================ */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/astro/Nav.astro';
import Rodape from '../../components/astro/Rodape.astro';
import CartaoIdeia from '../../components/astro/CartaoIdeia.astro';
import Vazio from '../../components/astro/Vazio.astro';
import {
  obterPerfil, listarRfcsDoUsuario, listarInscricoesDoUsuario, apiIndisponivel,
} from '../../lib/api';
import { t, rota, idiomaDe } from '../../lib/i18n';
import { cachePublico } from '../../lib/cache';

const { username } = Astro.params;
const lang = idiomaDe(Astro);

/* As três em paralelo: pra username desconhecido as listas voltam 404,
   que api.ts trata como vazio e não como queda. */
const [perfil, escritas, inscricoes] = await Promise.all([
  obterPerfil(username!),
  listarRfcsDoUsuario(username!),
  listarInscricoesDoUsuario(username!),
]);

const semRede = apiIndisponivel();
if (!perfil) Astro.response.status = semRede ? 503 : 404;
cachePublico(Astro, semRede);

/* rascunho não aparece pra visitante; a API já filtra, isto é defesa */
const publicas = escritas.data.filter((r) => r.status !== 'DRAFT');
const construindo = inscricoes.data.filter((i) => i.leftAt == null && i.rfc);
const bp = perfil?.builderProfile;

/* "por aqui desde setembro de 2026": mês e ano pelo Intl no idioma da
   interface. Antes isto cortava o "há" do tempo relativo, o que só
   funcionava em português. UTC pra data não andar um dia conforme o
   fuso do servidor. */
const desde = perfil
  ? new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' })
      .format(new Date(perfil.createdAt))
  : '';
---

{!perfil ? (
  <Layout title={t(lang, 'usuario.titulo')}>
    <div class="palco">
      <Nav atual="builders" />
      <Vazio
        falha={semRede}
        titulo={semRede
          ? t(lang, 'comum.vazio.falha.titulo')
          : t(lang, 'usuario.inexistente.titulo', { username: username ?? '' })}
        texto={semRede
          ? t(lang, 'labs.vazio.falha.texto')
          : t(lang, 'usuario.inexistente.texto')}
        acaoHref={rota(lang, '/rfcs')}
        acaoTexto={t(lang, 'usuario.acao.ideias')}
      />
      <Rodape />
    </div>
  </Layout>
) : (
<Layout
  title={t(lang, 'usuario.titulo.nome', { username: perfil.username })}
  description={bp?.headline ?? perfil.bio ?? t(lang, 'usuario.descricao', { username: perfil.username })}
>
  <div class="palco">
    <Nav atual="builders" />

    <header class="perfil-cabeca vem">
      <a class="volta" href={rota(lang, '/rfcs')}>{t(lang, 'usuario.volta')}</a>

      <h1 class="titulo-duplo grande">@{perfil.username}{perfil.fullName && <>{' '}<span class="apagado">{perfil.fullName}</span></>}</h1>

      {bp?.headline && <p class="apoio">{bp.headline}</p>}
      {perfil.bio && <p class="apoio">{perfil.bio}</p>}

      <div class="chips">
        {bp?.isOpenToWork && (
          <span class="chip vivo"><span class="ponto"></span>{t(lang, 'usuario.disponivel')}</span>
        )}
        {bp?.topics?.map((topico) => <span class="chip">{topico}</span>)}
      </div>

      <p class="apoio">{t(lang, 'usuario.desde', { quando: desde })}</p>
    </header>

    {/* ---------- o que escreveu ---------- */}
    <h2 class="secao">{t(lang, 'usuario.escreveu')}</h2>

    {publicas.length > 0 ? (
      <div class="grade">
        {publicas.map((rfc) => <CartaoIdeia rfc={rfc} />)}
      </div>
    ) : (
      <Vazio
        titulo={t(lang, 'usuario.escreveu.vazio.titulo')}
        texto={t(lang, 'usuario.escreveu.vazio.texto')}
      />
    )}

    {/* ---------- onde está construindo ---------- */}
    {construindo.length > 0 && (
      <>
        <h2 class="secao">{t(lang, 'usuario.construindo')}</h2>
        <div class="grade">
          {construindo.map((i) => <CartaoIdeia rfc={i.rfc!} />)}
        </div>
      </>
    )}

    <Rodape />
  </div>
</Layout>
)}

<style>
  .perfil-cabeca { padding: clamp(40px, 8vh, 72px) 4px 16px; display: grid; gap: 20px; justify-items: start; }
  .perfil-cabeca h1 { max-width: 20ch; overflow-wrap: anywhere; }
  .perfil-cabeca .chips { margin-bottom: 0; }
  .volta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 13px;
    color: var(--t-65);
    text-decoration: none;
  }
  .volta:hover { color: var(--t-100); }
  .volta:focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; border-radius: 4px; }

  .secao {
    font-size: var(--text-titulo-sm);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--t-100);
    margin: 56px 4px 24px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const olho = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('veio'); olho.unobserve(e.target); }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll<HTMLElement>('.vem').forEach((el, i) => {
      el.style.animationDelay = Math.min(i, 8) * 60 + 'ms';
      olho.observe(el);
    });
  });
</script>
